---
import Headline from '~/components/blog/Headline.astro';
import EventList from '~/components/events/List.astro';
import Button from '~/components/ui/Button.astro';
import Layout from '~/layouts/PageLayout.astro';
import { findPostsByCategory } from '~/utils/blog';

export const prerender = true;

const EVENTS_BATCH_SIZE = 5;

const metadata = {
  title: 'Eventos',
  openGraph: {
    type: 'blog',
  },
};

const allEvents = await findPostsByCategory(['eventos']);
const showLoadMore = allEvents.length > EVENTS_BATCH_SIZE;
---

<Layout metadata={metadata}>
  <section class="px-6 sm:px-6 py-12 sm:py-16 lg:py-20 mx-auto max-w-4xl">
    <Headline
      subtitle="Descubre nuestros próximos eventos, talleres y reuniones, y revive momentos destacados de eventos. Únete a nuestra comunidad para inspirarte y conectar con otros entusiastas de la tecnología."
    >
      Eventos
    </Headline>
    <EventList events={allEvents} id="events-list" hiddenFromIndex={EVENTS_BATCH_SIZE} />

    <div class="flex flex-col sm:flex-row flex-wrap justify-center items-center gap-4 mt-8">
      {
        showLoadMore && (
          <Button type="button" variant="secondary" id="load-more-events-btn">
            Ver más eventos
          </Button>
        )
      }
      <Button href="https://luma.com/pertechtalks/events" target="_blank" variant="secondary">
        Ver eventos en Luma
      </Button>
    </div>
  </section>
</Layout>

{
  showLoadMore && (
    <script define:vars={{ batchSize: EVENTS_BATCH_SIZE }}>
      const btn = document.getElementById('load-more-events-btn');
      const items = document.querySelectorAll('#events-list [data-event-item]');
      let visibleCount = batchSize;

      btn?.addEventListener('click', () => {
        visibleCount += batchSize;

        items.forEach((item, index) => {
          if (index < visibleCount) {
            item.classList.remove('hidden');
          }
        });

        if (visibleCount >= items.length) {
          btn.remove();
        }
      });
    </script>
  )
}
