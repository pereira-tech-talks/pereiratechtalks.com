---

<EventsLayout metadata={metadata}>
  <Hero
    id="hero"
    tagline="Septiembre 21, 2024."
    background="background-intro-light dark:background-intro-dark"
    actions={[
      {
        variant: 'secondary',
        text: 'Ver Grabación del evento',
        href: 'https://www.youtube.com/watch?v=5BWnHA-vBvg',
      },
    ]}
  >
    <Fragment slot="logo">
      <div class="text-center mb-8">
        <Image src={PereiraTechDayLogo} alt="Pereira Tech Talks" width={120} class="mx-auto" />
      </div>
    </Fragment>
    <Fragment slot="title"> Pereira•Tech•Day </Fragment>
    <Fragment slot="location">
      <a
        href="https://maps.app.goo.gl/XBexd1kkRm4kbsdt6"
        class="font-bold text-red-400 text-lg uppercase"
        target="_blank"><Icon name="tabler:map-pin" class="w-5 h-5 inline" /> UTP: Auditorio Jorge Roa Martínez</a
      >
    </Fragment>
    <Fragment slot="subtitle">
      Un día de Tecnología, Desarrollo de software, Data Science, Machine Learning, Infraestructura y más!
    </Fragment>
  </Hero>

  <!-- Content Widget **************** -->

  <Testimonials id="speakers" title="Ponentes" testimonials={speakers} />
  <Features2 title="Lightning Talks" tagline="Charlas cortas" columns={3} items={lightningTalks} />
  <ImageCarousel 
    id="memories" 
    title="Memorias del Evento" 
    images={memories}
    autoplayDelay={8000}
  />
  <Brands id="sponsors" title="Patrocinadores" brands={sponsors} />
  <Community id="community" title="Organiza" communities={communities} />
  <Collaborators id="organizers" collaborators={organizers} classes={{ container: 'lg:py-5' }} />
  <Collaborators
    id="collaborators"
    tagline="Colaboradores"
    collaborators={collaborators}
    classes={{ container: 'lg:pt-5' }}
  />
</EventsLayout>
