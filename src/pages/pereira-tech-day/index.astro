      src: '~/assets/images/people/abdenago-lopez.jpg',
      alt: 'Abdenago Lopez Hernandez',
    },
    footerSocialLinks: [
      {
        href: 'https://www.linkedin.com/in/alopezhe-800141221',
        icon: 'tabler:brand-linkedin',
      },
    ],
  },
  {
    title:
      '5 Pasos para Conquistar el Mundo Tech: Mi Viaje de la Ingeniería Química a los Datos',
    footerSubtitle: 'Sary Libreros',
    footerDescription: 'Lider de Comunidad en AWS Women Colombia',
    footerImage: {
      src: '~/assets/images/people/sary-libreros.jpg',
      alt: 'Sary Libreros',
    },
    footerSocialLinks: [
      {
        href: 'https://bento.me/sarylibreros',
        icon: 'tabler:info-circle',
      },
    ],
  },
];

// Reserved for commented sections below (Agenda, Ponentes, Lightning Talks).
void schedule;
void speakers;
void lightningTalks;
---

<EventsLayout metadata={metadata}>
  <div class="ptd-page-root">
    <section
      id="hero"
      class="ptd-intro ptd-hero-shell relative md:-mt-[76px] not-prose"
      style={heroIllustrationBg
        ? `--ptd-hero-bg: url('${heroIllustrationBg.src}')`
        : undefined}
    >
      <div class="ptd-intro__inner pt-0 md:pt-[76px]">
        <div class="ptd-intro__copy">
          <p class="ptd-intro__eyebrow">Agosto 22, 2026 — 08:00 AM</p>

          <div class="ptd-intro__headline">
            {
              introLogoMeta && (
                <img
                  src={
                    typeof introLogoMeta === "string"
                      ? introLogoMeta
                      : introLogoMeta.src
                  }
                  alt="Pereira Tech Talks"
                  class="ptd-intro__brand-logo-image"
                  loading="eager"
                  decoding="async"
                />
              )
            }

            <h1 class="ptd-intro__title">
              <span class="ptd-intro__title-tech">Pereira Tech</span>
              <span class="ptd-intro__title-day-year">
                <span class="ptd-intro__title-day">Day</span>
                <span class="ptd-intro__title-year"> 2026</span>
              </span>
            </h1>
          </div>

          <p class="ptd-intro__tagline">
            Donde el talento, la tecnología y las marcas <strong
              >se encuentran.</strong
            >
          </p>

          <ul class="ptd-intro__meta">
            <li>
              <Icon name="tabler:calendar-event" class="ptd-intro__meta-icon" />
              Sábado, 22 de agosto de 2026
            </li>
            <li>
              <a
                href="https://maps.app.goo.gl/XBexd1kkRm4kbsdt6"
                target="_blank"
                rel="noopener noreferrer"
              >
                <Icon name="tabler:map-pin" class="ptd-intro__meta-icon" />
                UTP: Auditorio Jorge Roa Martínez, Pereira
              </a>
            </li>
          </ul>

          <div class="ptd-intro__stat" aria-label="300+ asistentes esperados">
            <div class="ptd-intro__stat-inner">
              <Icon
                name="tabler:users"
                class="ptd-intro__meta-icon ptd-intro__meta-icon--coral"
              />
              <span class="ptd-intro__stat-value">300+</span>
              <span class="ptd-intro__stat-label">asistentes esperados</span>
            </div>
          </div>

          <div class="ptd-countdown-block">
            <Countdown
              id="countdown"
              targetDate="2026-08-22T08:00:00-05:00"
              endDate="2026-08-22T14:00:00-05:00"
              numberColor="#3A7F7C"
            />
          </div>

          <div class="ptd-notify-block">
            <p class="ptd-notify-copy">
              Entérate cuando se habiliten las inscripciones para el evento. ¡No
              te lo pierdas!
            </p>

            <form
              id="pereira-tech-day-tickets-notification"
              data-google-sheets-url={googleSheetsUrl}
              class="ptd-notify-form"
            >
              <input
                type="email"
                name="email"
                id="notification-email"
                placeholder="Ingresa tu correo electrónico"
                required
                class="ptd-notify-input"
              />
              <button type="submit" class="ptd-notify-button">
                Suscribirse
              </button>
            </form>
          </div>
        </div>
      </div>
    </section>

    <script>
      document.addEventListener("DOMContentLoaded", () => {
        const syncIntroLogoHeight = () => {
          const headline = document.querySelector(
            ".ptd-intro__headline",
          ) as HTMLElement | null;
          const title = headline?.querySelector(
            ".ptd-intro__title",
          ) as HTMLElement | null;

          if (!headline || !title) return;

          const titleHeight = title.getBoundingClientRect().height;
          if (titleHeight > 0) {
            headline.style.setProperty(
              "--ptd-intro-title-height",
              `${titleHeight}px`,
            );
          }
        };

        syncIntroLogoHeight();
        window.addEventListener("resize", syncIntroLogoHeight);
        document.addEventListener("astro:page-load", syncIntroLogoHeight);

        const form = document.getElementById(
          "pereira-tech-day-tickets-notification",
        );
        if (!form) return;

        form.addEventListener("submit", async (e) => {
          e.preventDefault();

          const googleSheetsUrl = form.getAttribute("data-google-sheets-url");
          if (!googleSheetsUrl) {
            alert("Por favor configura la URL de Google Sheets");
            return;
          }

          const emailInput = form.querySelector(
            'input[name="email"]',
          ) as HTMLInputElement;
          const button = form.querySelector(
            'button[type="submit"]',
          ) as HTMLButtonElement;
          const originalText = button?.textContent || "";

          try {
            if (button) {
              button.disabled = true;
              button.classList.remove("is-error", "is-success");
              button.classList.add("is-loading");
              button.textContent = "Enviando...";
            }

            await fetch(googleSheetsUrl, {
              method: "POST",
              mode: "no-cors",
              headers: {
                "Content-Type": "application/json",
              },
              body: JSON.stringify({
                email: emailInput.value,
                timestamp: new Date().toISOString(),
              }),
            });

            if (button) {
              button.textContent = "✓ ¡Registrado!";
              button.classList.remove("is-loading");
              button.classList.add("is-success");
            }
            emailInput.value = "";

            setTimeout(() => {
              if (button) {
                button.disabled = false;
                button.textContent = originalText;
                button.classList.remove("is-success", "is-loading");
              }
            }, 3000);
          } catch (error) {
            console.error("Error:", error);
            if (button) {
              button.textContent = "✗ Error";
              button.classList.remove("is-loading");
              button.classList.add("is-error");
              setTimeout(() => {
                button.disabled = false;
                button.textContent = originalText;
                button.classList.remove("is-error");
              }, 3000);
            }
          }
        });
      });
    </script>

    <div class="ptd-page-surface">
      <section
        id="about"
        class="ptd-about ptd-section-spacer not-prose"
        style={aboutSectionBg
          ? `--ptd-about-bg: url('${aboutSectionBg.src}')`
          : undefined}
      >
        <div class="ptd-about__inner">
          <article class="ptd-about__card">
            <div class="ptd-about__copy">
              <h2 class="ptd-about__title">Sobre Pereira Tech Day</h2>
              <p>
                <b>Pereira Tech Day</b> es un evento organizado en conjunto por las
                comunidades de <a href="https://pereira.js.org/"
                  ><i>PereiraJs</i></a
                >,
                <a href="https://pypereira.co"><i>Python Pereira</i></a>, <a
                  href="https://pereiratechtalks.org"
                  ><i>Pereira Tech Talks</i></a
                > y <a href="https://jointdevweb.firebaseapp.com/"
                  ><i>Joint Developer</i></a
                >. Unimos fuerzas para crear un evento diverso y enriquecedor,
                con charlas que abarcan diferentes aspectos de la tecnología.
              </p>
              <p>
                En <b>Pereira Tech Day</b>, nuestro objetivo es compartir con la
                comunidad temas relacionados al mundo tecnológico, enfocados en
                inspirar y motivar a las personas. Las charlas de este año no
                solo cubrirán temas tecnológicos, sino también trayectorias
                profesionales, desarrollo comunitario y motivación, buscando
                incentivar a los asistentes a seguir explorando, investigando y
                adentrándose en el maravilloso mundo de la tecnología.
              </p>
              <ul class="ptd-about__topics" aria-label="Temas principales">
                <li>
                  <Icon
                    name="tabler:chart-bubble"
                    class="ptd-about__topic-icon"
                  />
                  <span>Inteligencia Artificial</span>
                </li>
                <li>
                  <Icon name="tabler:code" class="ptd-about__topic-icon" />
                  <span>Desarrollo de software</span>
                </li>
                <li>
                  <Icon
                    name="tabler:shield-lock"
                    class="ptd-about__topic-icon"
                  />
                  <span>Ciber Seguridad</span>
                </li>
              </ul>
            </div>
            <div aria-hidden="true" class="ptd-about__media">
              <Image
                src={aboutSectionStyleMedia?.src ||
                  "~/assets/images/pereira-tech-day/event-2024.png"}
                alt="Colorful Image"
                loading="eager"
                width={1280}
                height={960}
                class="ptd-about__image"
              />
            </div>
          </article>
        </div>
      </section>

      <!-- <Steps id="schedule" title="Agenda" items={schedule} classes={{ container: 'max-w-3xl' }} />
    <Testimonials id="speakers" title="Ponentes" testimonials={speakers} />
    <Features2 title="Lightning Talks" tagline="Charlas cortas" columns={3} items={lightningTalks} /> -->
      <PtdPricing
        tiers={sponsorTiers}
        extraPlans={extraPartnerships}
        backgroundSrc={pricingSectionBg?.src}
      />
      <PtdSponsors
        logoMaskSrc={pttLogoMask?.src}
        backgroundSrc={sponsorsSectionBg?.src}
        brands={sponsors}
      />
      <section
        id="community"
        class="ptd-community ptd-section-spacer not-prose"
        style={communitySectionBg
          ? `--ptd-community-bg: url('${communitySectionBg.src}')`
          : undefined}
      >
        <div class="ptd-community__inner">
          <header class="ptd-community__header">
            <div
              class="ptd-community__brand-logo"
              role="img"
              aria-label="Pereira Tech Talks"
              style={pttLogoMask
                ? `--ptd-logo-mask: url('${pttLogoMask.src}')`
                : undefined}
            >
            </div>
            <div class="ptd-community__heading-copy">
              <h2 class="ptd-community__title">Organiza</h2>
              <p class="ptd-community__subtitle">
                Junto a estas comunidades fortalecemos el ecosistema tech de
                Pereira y la región.
              </p>
            </div>
          </header>

          <ul
            class="ptd-community__grid"
            aria-label="Comunidades organizadoras"
          >
            {
              communities.map(
                (community) =>
                  community && (
                    <li class="ptd-community__item">
                      <a
                        class="ptd-community__card"
                        target="_blank"
                        rel="noopener noreferrer"
                        href={community.socialLink}
                        aria-label={`Visitar ${community.name}`}
                      >
                        <Image
                          src={community.image}
                          alt={community.name || ""}
                          class="ptd-community__logo"
                        />
                      </a>
                    </li>
                  ),
              )
            }
          </ul>

          <div class="ptd-community__footer-pill" aria-hidden="true">
            <span
              class="ptd-community__footer-dot ptd-community__footer-dot--coral"
            ></span>
            <span
              class="ptd-community__footer-dot ptd-community__footer-dot--teal"
            ></span>
            <span
              class="ptd-community__footer-dot ptd-community__footer-dot--navy"
            ></span>
            <p class="ptd-community__footer-text">
              Una red de comunidades que conecta talento, aprendizaje y
              colaboración.
            </p>
          </div>
        </div>
      </section>
      <section
        id="organizers"
        class="ptd-team ptd-section-spacer not-prose"
        style={teamSectionBg
          ? `--ptd-team-bg: url('${teamSectionBg.src}')`
          : undefined}
      >
        <div class="ptd-team__inner">
          <div class="ptd-team__block">
            <header class="ptd-team__header">
              <h2 class="ptd-team__title">Organizadores</h2>
              <p class="ptd-team__subtitle">
                Quienes lideran y hacen posible Pereira Tech Day.
              </p>
            </header>

            <ul class="ptd-team__grid" aria-label="Equipo organizador">
              {
                organizersSorted.map(
                  (person) =>
                    person && (
                      <li class="ptd-team__item">
                        <a
                          class="ptd-team__card"
                          target="_blank"
                          rel="noopener noreferrer"
                          href={person.socialLink || undefined}
                          aria-label={`Visitar perfil de ${person.name}`}
                        >
                          <Image
                            src={person.image}
                            alt={person.name || ""}
                            class="ptd-team__photo"
                          />
                          <span class="ptd-team__name">{person.name}</span>
                        </a>
                      </li>
                    ),
                )
              }
            </ul>
          </div>

          <div class="ptd-team__block" id="collaborators">
            <header class="ptd-team__header">
              <h3 class="ptd-team__title">Colaboradores</h3>
              <p class="ptd-team__subtitle">
                Personas y aliados que fortalecen la ejecución del evento.
              </p>
            </header>

            <ul class="ptd-team__grid" aria-label="Equipo colaborador">
              {
                collaboratorsSorted.map(
                  (person) =>
                    person && (
                      <li class="ptd-team__item">
                        <a
                          class="ptd-team__card"
                          target="_blank"
                          rel="noopener noreferrer"
                          href={person.socialLink || undefined}
                          aria-label={`Visitar perfil de ${person.name}`}
                        >
                          <Image
                            src={person.image}
                            alt={person.name || ""}
                            class="ptd-team__photo"
                          />
                          <span class="ptd-team__name">{person.name}</span>
                        </a>
                      </li>
                    ),
                )
              }
            </ul>
          </div>
        </div>
      </section>
      <section
        id="faqs"
        class="ptd-faq ptd-section-spacer not-prose"
        style={faqsSectionBg
          ? `--ptd-faq-bg: url('${faqsSectionBg.src}')`
          : undefined}
      >
        <div class="ptd-faq__inner">
          <header class="ptd-faq__header">
            <h2 class="ptd-faq__title">Preguntas Frecuentes (FAQ)</h2>
            <p class="ptd-faq__subtitle">
              Algunas pequeñas preguntas que te pueden sacar algunas dudas. De
              cualquier forma, si hay algo que no quede claro aquí, por favor
              escribinos un email y nos pondremos en contacto contigo.
            </p>
          </header>

          <ul class="ptd-faq__grid" aria-label="Preguntas frecuentes">
            {
              faqsList.map((item) => (
                <li class="ptd-faq__item">
                  <div class="ptd-faq__item-body">
                    <Icon
                      name="tabler:chevron-right"
                      class="ptd-faq__item-icon"
                    />
                    <div class="ptd-faq__copy">
                      {item.title && (
                        <h3 class="ptd-faq__item-title">{item.title}</h3>
                      )}
                      {item.description && (
                        <p
                          class="ptd-faq__item-description"
                          set:html={item.description}
                        />
                      )}
                    </div>
                  </div>
                </li>
              ))
            }
          </ul>
        </div>
      </section>
      <PtdJoinSection
        logoMaskSrc={pttLogoMask?.src}
        backgroundSrc={joinSectionBg?.src}
      />
    </div>
  </div>
</EventsLayout>
