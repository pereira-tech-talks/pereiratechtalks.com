const whatsappNumber = (import.meta.env.PUBLIC_WHATSAPP_NUMBER || '').replace(
  /\D/g,
  '',
);

const createWhatsAppLink = (range: string) => {
  const message = `Hola, deseo saber el proceso para el rango "${range}" para Pereira Tech Day.`;

  return whatsappNumber
    ? `https://wa.me/${whatsappNumber}?text=${encodeURIComponent(message)}`
    : `https://wa.me/?text=${encodeURIComponent(message)}`;
};

