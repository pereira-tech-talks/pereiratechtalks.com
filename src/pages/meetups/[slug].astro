---
import MeetupDetailPage from '@/components/pages/MeetupDetailPage.astro';
import { getMeetupSlug, getMeetups } from '@/lib/meetup';

export async function getStaticPaths() {
  const meetups = await getMeetups();
  return meetups.map((meetup) => ({
    params: { slug: getMeetupSlug(meetup) },
    props: { meetup },
  }));
}

const { meetup } = Astro.props;
---

<MeetupDetailPage meetup={meetup} lang="es" />
