---
import InternalLayout from '@/layouts/InternalLayout.astro';
---

<InternalLayout
  title="Internal Hub"
  description="Documentation & tooling portal for pereiratechtalks.org v3.0.0"
  section="hub"
>
  <!-- Welcome Section -->
  <section class="mb-12">
    <div class="rounded-3xl border border-gray-200 dark:border-gray-700 p-6 sm:p-8 bg-gradient-to-br from-gray-50 to-white dark:from-gray-800/50 dark:to-gray-900">
      <h2 class="text-2xl md:text-3xl font-bold mb-3">
        Welcome to the Pereira Tech Talks Internal Hub
      </h2>
      <p class="text-base leading-relaxed text-gray-600 dark:text-gray-300 mb-4">
        Central documentation portal for the <code>pereiratechtalks.org</code> v3.0.0
        codebase. Everything in <code>/internal/*</code> is excluded from
        production builds and only visible during development.
      </p>
      <p class="text-sm text-gray-600 dark:text-gray-300">
        Use this hub to study the brand book, explore the design system,
        review the staff guide, browse the auto-generated sitemap, and
        inspect content collections via the admin views.
      </p>
    </div>
  </section>

  <!-- Quick Start -->
  <section class="mb-12">
    <h2 class="text-2xl md:text-3xl font-bold mb-6">Quick Start</h2>
    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
      <a href="/internal/brand" class="rounded-2xl border border-gray-200 dark:border-gray-700 p-5 hover:border-gray-400 dark:hover:border-gray-500 transition-colors group">
        <div class="text-lg font-semibold mb-1 group-hover:underline">Open the Brand Book</div>
        <p class="text-sm text-gray-600 dark:text-gray-300">PTT v3.0.0 colors, typography, spacing, motion, voice, logo, per-edition kits</p>
      </a>
      <a href="/internal/guide" class="rounded-2xl border border-gray-200 dark:border-gray-700 p-5 hover:border-gray-400 dark:hover:border-gray-500 transition-colors group">
        <div class="text-lg font-semibold mb-1 group-hover:underline">Read the Staff Guide</div>
        <p class="text-sm text-gray-600 dark:text-gray-300">Repository overview, key principles, and common commands</p>
      </a>
      <a href="/internal/ui" class="rounded-2xl border border-gray-200 dark:border-gray-700 p-5 hover:border-gray-400 dark:hover:border-gray-500 transition-colors group">
        <div class="text-lg font-semibold mb-1 group-hover:underline">Explore the Design System</div>
        <p class="text-sm text-gray-600 dark:text-gray-300">PTT tokens, buttons, cards, forms, layout primitives</p>
      </a>
      <a href="/internal/sitemap" class="rounded-2xl border border-gray-200 dark:border-gray-700 p-5 hover:border-gray-400 dark:hover:border-gray-500 transition-colors group">
        <div class="text-lg font-semibold mb-1 group-hover:underline">See the Full Sitemap</div>
        <p class="text-sm text-gray-600 dark:text-gray-300">Auto-generated tree of every URL on the site</p>
      </a>
    </div>
  </section>

  <!-- All Sections -->
  <section class="mb-12">
    <h2 class="text-2xl md:text-3xl font-bold mb-6">All Sections</h2>
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-5">
      <a href="/internal/brand" class="rounded-2xl border border-gray-200 dark:border-gray-700 p-5 hover:shadow-md transition-shadow group">
        <div class="text-xl font-semibold mb-2 group-hover:underline">Brand Book</div>
        <p class="text-sm text-gray-600 dark:text-gray-300 leading-relaxed">
          PTT v3.0.0 visual identity: global palette, per-edition kits for Pereira Tech Days, typography, voice & tone, logo usage.
        </p>
        <span class="inline-block mt-3 text-xs font-medium text-gray-600 dark:text-gray-300">8 pages</span>
      </a>
      <a href="/internal/ui" class="rounded-2xl border border-gray-200 dark:border-gray-700 p-5 hover:shadow-md transition-shadow group">
        <div class="text-xl font-semibold mb-2 group-hover:underline">UI Design System</div>
        <p class="text-sm text-gray-600 dark:text-gray-300 leading-relaxed">
          Visual reference for all components, PTT tokens, typography, spacing, and layouts.
        </p>
        <span class="inline-block mt-3 text-xs font-medium text-gray-600 dark:text-gray-300">10 pages</span>
      </a>
      <a href="/internal/guide" class="rounded-2xl border border-gray-200 dark:border-gray-700 p-5 hover:shadow-md transition-shadow group">
        <div class="text-xl font-semibold mb-2 group-hover:underline">Staff Guide</div>
        <p class="text-sm text-gray-600 dark:text-gray-300 leading-relaxed">
          How to work in this repo: tech stack, slides, blog, i18n, SEO, AI tools, agent skills.
        </p>
        <span class="inline-block mt-3 text-xs font-medium text-gray-600 dark:text-gray-300">9 pages</span>
      </a>
      <a href="/internal/authors" class="rounded-2xl border border-gray-200 dark:border-gray-700 p-5 hover:shadow-md transition-shadow group">
        <div class="text-xl font-semibold mb-2 group-hover:underline">Authors</div>
        <p class="text-sm text-gray-600 dark:text-gray-300 leading-relaxed">
          Authors directory backing the blog (legacy attribution model). Broader community lives in <code>contributors/</code>.
        </p>
      </a>
      <a href="/internal/certificates" class="rounded-2xl border border-gray-200 dark:border-gray-700 p-5 hover:shadow-md transition-shadow group">
        <div class="text-xl font-semibold mb-2 group-hover:underline">Certificates</div>
        <p class="text-sm text-gray-600 dark:text-gray-300 leading-relaxed">
          Diploma showcase — roles, statuses, and links to public demo certificate pages.
        </p>
      </a>
      <a href="/internal/sitemap" class="rounded-2xl border border-gray-200 dark:border-gray-700 p-5 hover:shadow-md transition-shadow group">
        <div class="text-xl font-semibold mb-2 group-hover:underline">Auto-Sitemap</div>
        <p class="text-sm text-gray-600 dark:text-gray-300 leading-relaxed">
          Auto-generated map of every URL on the site. Updates automatically when pages are added.
        </p>
        <span class="inline-block mt-3 text-xs font-medium text-gray-600 dark:text-gray-300">Zero maintenance</span>
      </a>
    </div>
  </section>
</InternalLayout>
