---
import InternalLayout from '@/layouts/InternalLayout.astro';

interface Row {
  role: string;
  family: string;
  weight: string;
  size: string;
  tracking: string;
  notes: string;
}

const scale: Row[] = [
  {
    role: 'Display (hero)',
    family: 'Inter Variable',
    weight: '700',
    size: 'clamp(2.5rem, 6vw, 4rem)',
    tracking: '-0.02em',
    notes: 'Reserved for hero / landing pages.',
  },
  {
    role: 'H1',
    family: 'Inter Variable',
    weight: '700',
    size: 'clamp(2rem, 5vw, 3.25rem)',
    tracking: '-0.01em',
    notes: 'One per page.',
  },
  {
    role: 'H2',
    family: 'Inter Variable',
    weight: '700',
    size: 'clamp(1.5rem, 3.5vw, 2.25rem)',
    tracking: '-0.005em',
    notes: 'Section heads.',
  },
  {
    role: 'H3',
    family: 'Inter Variable',
    weight: '600',
    size: '1.5rem',
    tracking: '0',
    notes: 'Sub-section.',
  },
  {
    role: 'H4',
    family: 'Inter Variable',
    weight: '600',
    size: '1.25rem',
    tracking: '0',
    notes: 'Card / list group titles.',
  },
  {
    role: 'Body',
    family: 'Inter Variable',
    weight: '400',
    size: '1rem',
    tracking: '0',
    notes: 'Default running text. Line-height 1.65.',
  },
  {
    role: 'Body large',
    family: 'Inter Variable',
    weight: '400',
    size: '1.125rem',
    tracking: '0',
    notes: 'Lead paragraphs.',
  },
  {
    role: 'Small',
    family: 'Inter Variable',
    weight: '400',
    size: '0.875rem',
    tracking: '0',
    notes: 'Meta text · captions.',
  },
  {
    role: 'Caption',
    family: 'Inter Variable',
    weight: '500',
    size: '0.75rem',
    tracking: '0.04em',
    notes: 'Labels, eyebrows, uppercase optional.',
  },
  {
    role: 'Mono',
    family: 'system mono',
    weight: '400',
    size: '0.875rem',
    tracking: '0',
    notes: 'Code, frontmatter snippets.',
  },
];
---

<InternalLayout
  title="Brand Book — Typography"
  description="PTT v3.0.0 type scale, weights, tracking, and loading rules."
  section="brand"
  subsection="typography"
>
  <main class="max-w-5xl mx-auto px-4 sm:px-6 py-8 space-y-10">
    <header class="space-y-3">
      <p class="text-xs uppercase tracking-widest text-gray-500 dark:text-gray-400">
        <a href="/internal/brand" class="hover:underline">Brand</a> / Typography
      </p>
      <h1 class="text-3xl sm:text-4xl font-bold text-gray-900 dark:text-gray-100">Typography</h1>
      <p class="text-base text-gray-600 dark:text-gray-300 max-w-3xl">
        Pereira Tech Talks v3.0.0 standardizes on <strong>Inter Variable</strong>
        for headings and body. The variable family lets us collapse 4–5 static
        weight files into one network-friendly resource without sacrificing
        editorial flexibility.
      </p>
    </header>

    <section class="space-y-4">
      <h2 class="text-2xl font-bold text-gray-900 dark:text-gray-100">Type scale</h2>
      <div class="overflow-x-auto rounded-lg border border-gray-200 dark:border-gray-700">
        <table class="min-w-full text-sm">
          <thead class="bg-gray-50 dark:bg-gray-800">
            <tr class="text-left">
              <th class="px-4 py-2 font-semibold text-gray-700 dark:text-gray-200">Role</th>
              <th class="px-4 py-2 font-semibold text-gray-700 dark:text-gray-200">Family</th>
              <th class="px-4 py-2 font-semibold text-gray-700 dark:text-gray-200">Weight</th>
              <th class="px-4 py-2 font-semibold text-gray-700 dark:text-gray-200">Size</th>
              <th class="px-4 py-2 font-semibold text-gray-700 dark:text-gray-200">Tracking</th>
              <th class="px-4 py-2 font-semibold text-gray-700 dark:text-gray-200">Notes</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-gray-200 dark:divide-gray-700">
            {scale.map((row) => (
              <tr>
                <td class="px-4 py-3 font-medium text-gray-900 dark:text-gray-100">{row.role}</td>
                <td class="px-4 py-3 font-mono text-xs text-gray-600 dark:text-gray-300">{row.family}</td>
                <td class="px-4 py-3 font-mono text-xs text-gray-600 dark:text-gray-300">{row.weight}</td>
                <td class="px-4 py-3 font-mono text-xs text-gray-600 dark:text-gray-300">{row.size}</td>
                <td class="px-4 py-3 font-mono text-xs text-gray-600 dark:text-gray-300">{row.tracking}</td>
                <td class="px-4 py-3 text-gray-600 dark:text-gray-300">{row.notes}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </section>

    <section class="space-y-4">
      <h2 class="text-2xl font-bold text-gray-900 dark:text-gray-100">Live preview</h2>
      <div class="rounded-xl border border-gray-200 dark:border-gray-700 p-6 space-y-4 bg-white dark:bg-gray-900">
        <p style="font-size: clamp(2.5rem, 6vw, 4rem); letter-spacing: -0.02em; line-height: 1.1; font-weight: 700;" class="text-gray-900 dark:text-gray-100">
          Display — Pereira Tech Talks
        </p>
        <p style="font-size: clamp(2rem, 5vw, 3.25rem); letter-spacing: -0.01em; line-height: 1.15; font-weight: 700;" class="text-gray-900 dark:text-gray-100">
          H1 — Una comunidad técnica
        </p>
        <p style="font-size: clamp(1.5rem, 3.5vw, 2.25rem); letter-spacing: -0.005em; line-height: 1.2; font-weight: 700;" class="text-gray-900 dark:text-gray-100">
          H2 — Section heading example
        </p>
        <p style="font-size: 1.5rem; line-height: 1.3; font-weight: 600;" class="text-gray-900 dark:text-gray-100">H3 — Sub-section heading</p>
        <p style="font-size: 1.125rem; line-height: 1.65;" class="text-gray-700 dark:text-gray-200">
          Body large — A pull paragraph that reads slightly larger than running text.
        </p>
        <p style="font-size: 1rem; line-height: 1.65;" class="text-gray-700 dark:text-gray-200">
          Body — Default running text. The cycle of meetups, talks, and contributors
          you see across the site uses this size on a 1.65 line-height for sustained reading.
        </p>
        <p style="font-size: 0.875rem;" class="text-gray-600 dark:text-gray-300">Small — meta · timestamps · captions.</p>
        <p style="font-size: 0.75rem; letter-spacing: 0.04em; font-weight: 500; text-transform: uppercase;" class="text-gray-500 dark:text-gray-400">
          Caption · eyebrow · category
        </p>
        <pre class="rounded-md bg-gray-50 dark:bg-gray-800 p-3 text-xs text-gray-800 dark:text-gray-100 overflow-x-auto"><code>// Mono — code, frontmatter snippets.
const community = "Pereira Tech Talks";</code></pre>
      </div>
    </section>

    <section class="space-y-3">
      <h2 class="text-2xl font-bold text-gray-900 dark:text-gray-100">Loading strategy</h2>
      <ul class="list-disc list-inside text-sm text-gray-600 dark:text-gray-300 space-y-1">
        <li>Variable font via <code>@fontsource-variable/inter</code> (preferred) or self-hosted woff2.</li>
        <li><code>font-display: swap</code> always — never <code>block</code>.</li>
        <li>Preload the latin subset only; load the latin-ext subset on demand.</li>
        <li>System fallback stack: <code>-apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif</code>.</li>
        <li>Mono fallback: <code>ui-monospace, SFMono-Regular, "SF Mono", Menlo, monospace</code>.</li>
      </ul>
    </section>

    <section class="space-y-3">
      <h2 class="text-2xl font-bold text-gray-900 dark:text-gray-100">Per-edition typography overrides</h2>
      <p class="text-sm text-gray-600 dark:text-gray-300">
        A Pereira Tech Day edition can opt into a custom heading family — for
        example PTD 2024 uses <strong>Bebas Neue uppercase</strong>. The override
        is scoped via <code>[data-edition-theme]</code> and never leaks to
        non-edition pages. See
        <a href="/internal/brand/per-edition-kits" class="underline">Per-edition kits</a>.
      </p>
    </section>

    <section class="space-y-3">
      <h2 class="text-2xl font-bold text-gray-900 dark:text-gray-100">Hard rules</h2>
      <ul class="list-disc list-inside text-sm text-gray-600 dark:text-gray-300 space-y-1">
        <li>Never skip heading levels — h1 → h2 → h3, no jumps.</li>
        <li>One <code>h1</code> per page.</li>
        <li>Tabular numbers (<code>font-variant-numeric: tabular-nums</code>) for stats and event metrics.</li>
        <li>Body text never below <code>0.875rem</code> on desktop or <code>1rem</code> on mobile.</li>
      </ul>
    </section>
  </main>
</InternalLayout>
