---
import ShowcaseLayout from '@/layouts/ShowcaseLayout.astro';

interface Token {
  name: string;
  cssVar: string;
  bgClass: string;
  textOnClass: string;
  lightHex: string;
  darkHex: string;
  usage: string;
}

const ptTokens: Token[] = [
  {
    name: 'Primary',
    cssVar: '--color-ptt-primary',
    bgClass: 'bg-ptt-primary',
    textOnClass: 'text-white',
    lightHex: '#1F6F73',
    darkHex: '#3FA8AD',
    usage: 'CTAs, links, focus rings, brand color',
  },
  {
    name: 'Primary strong',
    cssVar: '--color-ptt-primary-strong',
    bgClass: 'bg-ptt-primary-strong',
    textOnClass: 'text-white',
    lightHex: '#155054',
    darkHex: '#5BBFC4',
    usage: 'Hover, active, pressed states',
  },
  {
    name: 'Primary soft',
    cssVar: '--color-ptt-primary-soft',
    bgClass: 'bg-ptt-primary-soft',
    textOnClass: 'text-ptt-text',
    lightHex: '#E1F2F1',
    darkHex: '#0F2A2C',
    usage: 'Tints, badges, subtle backgrounds',
  },
  {
    name: 'Accent',
    cssVar: '--color-ptt-accent',
    bgClass: 'bg-ptt-accent',
    textOnClass: 'text-ptt-text',
    lightHex: '#E8A33D',
    darkHex: '#F4B95C',
    usage: 'Warm complement, large text only — NOT body text',
  },
  {
    name: 'Accent strong',
    cssVar: '--color-ptt-accent-strong',
    bgClass: 'bg-ptt-accent-strong',
    textOnClass: 'text-white',
    lightHex: '#B87C1F',
    darkHex: '#FFD27A',
    usage: 'Pressed accent, high-contrast accent text',
  },
];

const surfaceTokens: Token[] = [
  {
    name: 'Background',
    cssVar: '--color-ptt-bg',
    bgClass: 'bg-ptt-bg',
    textOnClass: 'text-ptt-text',
    lightHex: '#FAFBFB',
    darkHex: '#08191A',
    usage: 'Page background — deep green-teal in dark mode',
  },
  {
    name: 'Bg elevated',
    cssVar: '--color-ptt-bg-elevated',
    bgClass: 'bg-ptt-bg-elevated',
    textOnClass: 'text-ptt-text',
    lightHex: '#FFFFFF',
    darkHex: '#0F2A2C',
    usage: 'Cards, modals, elevated surfaces',
  },
  {
    name: 'Border',
    cssVar: '--color-ptt-border',
    bgClass: 'bg-ptt-border',
    textOnClass: 'text-ptt-text',
    lightHex: '#E2E8E8',
    darkHex: '#1E3D40',
    usage: 'Dividers, card outlines',
  },
  {
    name: 'Border strong',
    cssVar: '--color-ptt-border-strong',
    bgClass: 'bg-ptt-border-strong',
    textOnClass: 'text-ptt-text',
    lightHex: '#C9D4D5',
    darkHex: '#2A5256',
    usage: 'Emphasized dividers, focused outlines',
  },
];

const textTokens: Token[] = [
  {
    name: 'Text',
    cssVar: '--color-ptt-text',
    bgClass: 'bg-ptt-text',
    textOnClass: 'text-ptt-bg',
    lightHex: '#0F2A2C',
    darkHex: '#E8F0EF',
    usage: 'Primary body, headings',
  },
  {
    name: 'Text secondary',
    cssVar: '--color-ptt-text-secondary',
    bgClass: 'bg-ptt-text-secondary',
    textOnClass: 'text-white',
    lightHex: '#4A6164',
    darkHex: '#B5C7C9',
    usage: 'Secondary body, descriptions',
  },
  {
    name: 'Text muted',
    cssVar: '--color-ptt-text-muted',
    bgClass: 'bg-ptt-text-muted',
    textOnClass: 'text-white',
    lightHex: '#6E8589',
    darkHex: '#8FA3A6',
    usage: 'Metadata, captions — large text only on bg',
  },
];

const stateTokens: Token[] = [
  {
    name: 'Success',
    cssVar: '--color-ptt-success',
    bgClass: 'bg-ptt-success',
    textOnClass: 'text-white',
    lightHex: '#2E8757',
    darkHex: '#4FB07F',
    usage: 'Confirmation, positive feedback',
  },
  {
    name: 'Warning',
    cssVar: '--color-ptt-warning',
    bgClass: 'bg-ptt-warning',
    textOnClass: 'text-white',
    lightHex: '#C68417',
    darkHex: '#E2A848',
    usage: 'Caution, pending state',
  },
  {
    name: 'Danger',
    cssVar: '--color-ptt-danger',
    bgClass: 'bg-ptt-danger',
    textOnClass: 'text-white',
    lightHex: '#B83A3A',
    darkHex: '#E0635F',
    usage: 'Errors, destructive actions',
  },
  {
    name: 'Info',
    cssVar: '--color-ptt-info',
    bgClass: 'bg-ptt-info',
    textOnClass: 'text-white',
    lightHex: '#1F6F73',
    darkHex: '#3FA8AD',
    usage: 'Informational (alias of primary)',
  },
];

const approvedPairings = [
  {
    context: 'Primary text on bg',
    classes: 'text-ptt-text bg-ptt-bg',
    ratio: 'Light ~16.5:1 · Dark ~14:1',
    status: 'AAA',
  },
  {
    context: 'Secondary text on bg',
    classes: 'text-ptt-text-secondary bg-ptt-bg',
    ratio: 'Light ~6.8:1 · Dark ~9:1',
    status: 'AA',
  },
  {
    context: 'Muted text on bg',
    classes: 'text-ptt-text-muted bg-ptt-bg',
    ratio: 'Light ~4.0:1 · Dark ~5.5:1',
    status: 'AA Large only',
  },
  {
    context: 'Primary on bg',
    classes: 'text-ptt-primary bg-ptt-bg',
    ratio: 'Light ~5.5:1 · Dark ~7.5:1',
    status: 'AA',
  },
  {
    context: 'White on primary',
    classes: 'text-white bg-ptt-primary',
    ratio: 'Light ~5.0:1',
    status: 'AA',
  },
];

const forbiddenPairings = [
  {
    classes: 'text-ptt-accent bg-ptt-bg',
    reason:
      'Light ~2.4:1 — fails WCAG AA. Reserve accent for large text, icons, or pills with alternate background.',
  },
  {
    classes: 'text-gray-400 / text-gray-500',
    reason:
      'Fails WCAG AA on white. Use text-ptt-text-secondary or text-gray-600 instead.',
  },
  {
    classes: 'dark:text-gray-400 / dark:text-gray-500',
    reason:
      'Fails WCAG AA on dark canvas. Use dark:text-ptt-text-secondary or dark:text-gray-300 instead.',
  },
];

const allGroups = [
  { title: 'Brand', tokens: ptTokens },
  { title: 'Surfaces', tokens: surfaceTokens },
  { title: 'Text', tokens: textTokens },
  { title: 'State', tokens: stateTokens },
];
---

<ShowcaseLayout
  title="Colors"
  description="Pereira Tech Talks v3.0.0 design tokens — live swatches reflect the active light/dark mode."
  section="colors"
>
  <!-- Intro -->
  <section class="mb-10" data-component="ptt-colors-intro">
    <div class="rounded-2xl border border-ptt-border bg-ptt-bg-elevated p-6">
      <p class="text-sm text-ptt-text-secondary">
        Every public page uses the global PTT palette by default. Tokens are
        registered in <code class="text-xs">src/styles/global.css</code> via
        Tailwind 4 <code class="text-xs">@theme</code>; Tailwind generates the
        matching utility classes (<code class="text-xs">bg-ptt-primary</code>,
        <code class="text-xs">text-ptt-text</code>, <code class="text-xs">border-ptt-border</code>, …).
      </p>
      <p class="mt-2 text-sm text-ptt-text-secondary">
        Per-edition Pereira Tech Day kits override these tokens only inside
        <code class="text-xs">[data-edition-theme="{`{year}`}"]</code> wrappers — see
        <a href="/internal/brand/per-edition-kits" class="text-ptt-primary underline">Per-edition kits</a>.
      </p>
      <p class="mt-2 text-xs text-ptt-text-muted">
        Source of truth: <a href="/internal/brand/colors" class="underline">Brand Book → Colors</a> ·
        <code class="text-xs">docs/BRAND_GUIDE.md</code> ·
        <code class="text-xs">analysis_results/BRAND_PALETTE.md</code>.
      </p>
    </div>
  </section>

  <!-- Token Groups -->
  {allGroups.map((group) => (
    <section class="mb-12" data-component={`tokens-${group.title.toLowerCase()}`}>
      <h2 class="text-xl md:text-2xl font-bold mb-4 text-ptt-text">{group.title}</h2>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
        {group.tokens.map((t) => (
          <div class="rounded-2xl border border-ptt-border overflow-hidden bg-ptt-bg-elevated">
            <div class:list={['h-24 flex items-end p-3', t.bgClass, t.textOnClass]}>
              <code class="text-xs font-mono opacity-90">{t.bgClass}</code>
            </div>
            <div class="p-4">
              <div class="font-semibold text-ptt-text">{t.name}</div>
              <code class="block text-xs text-ptt-text-secondary mt-1">{t.cssVar}</code>
              <div class="grid grid-cols-2 gap-2 mt-2 text-xs">
                <div>
                  <span class="block text-ptt-text-muted">Light</span>
                  <code class="text-ptt-text">{t.lightHex}</code>
                </div>
                <div>
                  <span class="block text-ptt-text-muted">Dark</span>
                  <code class="text-ptt-text">{t.darkHex}</code>
                </div>
              </div>
              <p class="text-xs text-ptt-text-secondary mt-3">{t.usage}</p>
            </div>
          </div>
        ))}
      </div>
    </section>
  ))}

  <!-- Live Light/Dark Comparison -->
  <section class="mb-12" data-component="light-dark-comparison">
    <h2 class="text-xl md:text-2xl font-bold mb-4 text-ptt-text">Light vs Dark</h2>
    <p class="text-sm text-ptt-text-secondary mb-4">
      Both modes side by side. The <strong>Live</strong> column reflects the
      mode you have active in the toggle above; the snapshot columns are
      always visible regardless.
    </p>
    <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
      <div class="rounded-2xl overflow-hidden border border-ptt-border" data-mode="light-snapshot" style="background-color:#FAFBFB;color:#0F2A2C;">
        <div class="px-4 py-2 border-b text-xs font-semibold uppercase tracking-wider" style="border-color:#E2E8E8;color:#4A6164;">Light snapshot</div>
        <div class="p-5">
          <div class="text-xl font-bold mb-2">Pereira Tech Talks</div>
          <p class="text-sm" style="color:#4A6164;">Comunidad técnica de Pereira, Risaralda. AI-first.</p>
          <button type="button" class="mt-4 inline-flex items-center px-4 py-2 rounded-md text-sm font-semibold text-white" style="background-color:#1F6F73;">Inscríbete al meetup</button>
        </div>
      </div>
      <div class="rounded-2xl overflow-hidden border border-ptt-border bg-ptt-bg" data-mode="live">
        <div class="px-4 py-2 border-b border-ptt-border text-xs font-semibold uppercase tracking-wider text-ptt-text-secondary">Live (matches your toggle)</div>
        <div class="p-5 text-ptt-text">
          <div class="text-xl font-bold mb-2">Pereira Tech Talks</div>
          <p class="text-sm text-ptt-text-secondary">Comunidad técnica de Pereira, Risaralda. AI-first.</p>
          <button type="button" class="mt-4 inline-flex items-center px-4 py-2 rounded-md text-sm font-semibold text-white bg-ptt-primary hover:bg-ptt-primary-strong transition-colors">Inscríbete al meetup</button>
        </div>
      </div>
      <div class="rounded-2xl overflow-hidden border" data-mode="dark-snapshot" style="background-color:#08191A;color:#E8F0EF;border-color:#1E3D40;">
        <div class="px-4 py-2 border-b text-xs font-semibold uppercase tracking-wider" style="border-color:#1E3D40;color:#B5C7C9;">Dark snapshot</div>
        <div class="p-5">
          <div class="text-xl font-bold mb-2">Pereira Tech Talks</div>
          <p class="text-sm" style="color:#B5C7C9;">Comunidad técnica de Pereira, Risaralda. AI-first.</p>
          <button type="button" class="mt-4 inline-flex items-center px-4 py-2 rounded-md text-sm font-semibold" style="background-color:#3FA8AD;color:#08191A;">Inscríbete al meetup</button>
        </div>
      </div>
    </div>
  </section>

  <!-- Approved Pairings -->
  <section class="mb-12" data-component="approved-pairings">
    <h2 class="text-xl md:text-2xl font-bold mb-4 text-ptt-text">Approved text pairings (WCAG AA+)</h2>
    <div class="space-y-3">
      {approvedPairings.map((p) => (
        <div class="flex flex-col sm:flex-row sm:items-center gap-3 sm:gap-6 rounded-lg border border-ptt-border p-4 bg-ptt-bg-elevated">
          <span class="inline-flex items-center px-2 py-0.5 rounded text-xs font-bold uppercase bg-ptt-success text-white shrink-0">{p.status}</span>
          <div class="flex-1">
            <div class="font-medium text-sm text-ptt-text">{p.context}</div>
            <code class="block text-xs text-ptt-text-secondary mt-1">{p.classes}</code>
          </div>
          <code class="text-xs text-ptt-text-muted">{p.ratio}</code>
        </div>
      ))}
    </div>
  </section>

  <!-- Forbidden Pairings -->
  <section class="mb-12" data-component="forbidden-pairings">
    <h2 class="text-xl md:text-2xl font-bold mb-4 text-ptt-text">Forbidden combinations</h2>
    <div class="space-y-3">
      {forbiddenPairings.map((p) => (
        <div class="flex flex-col sm:flex-row sm:items-start gap-3 sm:gap-6 rounded-lg border border-ptt-border p-4 bg-ptt-bg-elevated">
          <span class="inline-flex items-center px-2 py-0.5 rounded text-xs font-bold uppercase bg-ptt-danger text-white shrink-0">FAIL</span>
          <div class="flex-1">
            <code class="text-xs font-medium text-ptt-text">{p.classes}</code>
            <p class="text-xs text-ptt-text-secondary mt-1">{p.reason}</p>
          </div>
        </div>
      ))}
    </div>
  </section>

  <!-- Usage example -->
  <section class="mb-12" data-component="usage-examples">
    <h2 class="text-xl md:text-2xl font-bold mb-4 text-ptt-text">Usage</h2>
    <details class="rounded-lg border border-ptt-border bg-ptt-bg-elevated">
      <summary class="px-4 py-3 cursor-pointer text-sm font-medium text-ptt-text hover:bg-ptt-primary-soft">
        Show code
      </summary>
      <pre class="p-4 text-xs overflow-x-auto bg-ptt-bg text-ptt-text"><code>{`<!-- Page background + body text -->
<body class="bg-ptt-bg text-ptt-text">

<!-- Card on elevated surface -->
<div class="bg-ptt-bg-elevated border border-ptt-border rounded-lg p-4">
  <h3 class="text-ptt-text">Title</h3>
  <p class="text-ptt-text-secondary">Body copy</p>
</div>

<!-- Primary CTA -->
<button class="bg-ptt-primary hover:bg-ptt-primary-strong text-white px-4 py-2 rounded-md">
  Inscríbete
</button>

<!-- Accent badge (large text only) -->
<span class="bg-ptt-primary-soft text-ptt-primary px-2 py-0.5 rounded text-xs font-semibold">
  Speaker School
</span>

<!-- State -->
<div class="bg-ptt-success text-white">Confirmed</div>
<div class="bg-ptt-danger text-white">Cancelled</div>`}</code></pre>
    </details>
  </section>

  <!-- Agent Reference -->
  <section class="mt-16 border-t border-ptt-border pt-8" data-agent-reference="true">
    <h2 class="text-lg font-bold mb-4 text-ptt-text">Agent reference</h2>
    <p class="text-sm text-ptt-text-secondary mb-4">
      Full machine-readable contract: <code class="text-xs">analysis_results/BRAND_PALETTE.md</code>.
      The Brand Book version of this page is the source of truth for design
      decisions: <a href="/internal/brand/colors" class="text-ptt-primary underline">Brand Book → Colors</a>.
    </p>
    <div class="overflow-x-auto rounded-lg border border-ptt-border">
      <table class="min-w-full text-sm">
        <thead class="bg-ptt-primary-soft">
          <tr class="text-left text-ptt-text">
            <th class="py-2 px-4 font-semibold">Token</th>
            <th class="py-2 px-4 font-semibold">CSS variable</th>
            <th class="py-2 px-4 font-semibold">Tailwind class</th>
            <th class="py-2 px-4 font-semibold">Light · Dark</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-ptt-border">
          {allGroups.flatMap((g) => g.tokens).map((t) => (
            <tr>
              <td class="py-2 px-4 font-medium text-ptt-text">{t.name}</td>
              <td class="py-2 px-4"><code class="text-xs text-ptt-text-secondary">{t.cssVar}</code></td>
              <td class="py-2 px-4"><code class="text-xs text-ptt-text-secondary">{t.bgClass}</code></td>
              <td class="py-2 px-4 text-xs text-ptt-text-muted">{t.lightHex} · {t.darkHex}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </section>
</ShowcaseLayout>
