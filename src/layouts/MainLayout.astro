---
import '@/styles/global.css';
import WebMCPBridge from '@/components/agent/WebMCPBridge.svelte';
import BaseHead from '@/components/BaseHead.astro';
import Footer from '@/components/Footer.astro';
import LanguageRedirect from '@/components/LanguageRedirect.astro';
import Header from '@/components/layout/Header.svelte';
import TopNotificationBar from '@/components/layout/TopNotificationBar.svelte';
import ThemeToggle from '@/components/ThemeToggle.astro';
import type { Language } from '@/lib/i18n';
import { getUrlPrefix } from '@/lib/i18n';
import {
  getActiveNotifications,
  localizeNotification,
} from '@/lib/notifications';

interface Props {
  lang: string;
  title: string;
  description: string;
  image?: string;
  keywords?: string[];
  prevPage?: string;
  nextPage?: string;
  ogType?: string;
  ogImageWidth?: number;
  ogImageHeight?: number;
}

const {
  lang,
  title,
  description,
  image,
  keywords,
  prevPage,
  nextPage,
  ogType,
  ogImageWidth,
  ogImageHeight,
} = Astro.props;

const language = lang as Language;
const prefix = getUrlPrefix(language);
const activeNotifications = (await getActiveNotifications()).map((entry) => {
  const localized = localizeNotification(entry, language);
  const href = localized.ctaHref;
  if (
    href?.startsWith('/') &&
    !href.startsWith('//') &&
    prefix &&
    !href.startsWith(`${prefix}/`)
  ) {
    return { ...localized, ctaHref: `${prefix}${href}` };
  }
  return localized;
});
---

<html lang={lang}>
  <head>
    <BaseHead
      title={title}
      description={description}
      image={image}
      lang={lang}
      keywords={keywords}
      prevPage={prevPage}
      nextPage={nextPage}
      ogType={ogType}
      ogImageWidth={ogImageWidth}
      ogImageHeight={ogImageHeight}
    />
    <slot name="head" />
    <LanguageRedirect lang={lang} />
    <script is:inline>
  (function(){var t=localStorage.getItem('theme');if(!t)t=window.matchMedia('(prefers-color-scheme:dark)').matches?'dark':'light';if(t==='dark')document.documentElement.classList.add('dark');else document.documentElement.classList.remove('dark');})();
</script>
  </head>
  <body
    class="flex flex-col min-h-screen bg-white dark:bg-gray-900 text-gray-900 dark:text-gray-100 transition-colors duration-300"
  >
    <a href="#main-content" class="sr-only focus:not-sr-only focus:absolute focus:top-4 focus:left-4 focus:z-[100] focus:bg-white focus:dark:bg-gray-900 focus:px-4 focus:py-2 focus:rounded focus:shadow-lg focus:text-secondary">
      Skip to content
    </a>
    {
      activeNotifications.length > 0 && (
        <TopNotificationBar
          client:idle
          lang={lang}
          notifications={activeNotifications}
        />
      )
    }
    <Header client:load lang={lang} />
    <div
      class="fixed z-50"
      style="right: max(1rem, env(safe-area-inset-right)); bottom: max(1rem, env(safe-area-inset-bottom));"
    >
      <ThemeToggle />
    </div>
    <main id="main-content" class="flex-1 bg-gray-50 dark:bg-gray-900">
      <slot />
    </main>
    <Footer lang={lang} />
    <WebMCPBridge client:load lang={lang as 'en' | 'es'} />
    <script>
      import { setupOutboundTracking } from '@/lib/analytics';
      setupOutboundTracking();
    </script>
  </body>
</html>
