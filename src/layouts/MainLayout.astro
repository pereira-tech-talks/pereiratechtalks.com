---
import '@/styles/global.css';
import WebMCPBridge from '@/components/agent/WebMCPBridge.svelte';
import BaseHead from '@/components/BaseHead.astro';
import Footer from '@/components/Footer.astro';
import LanguageRedirect from '@/components/LanguageRedirect.astro';
import Header from '@/components/layout/Header.svelte';
import TopNotificationBar from '@/components/layout/TopNotificationBar.svelte';
import ThemeToggle from '@/components/ThemeToggle.astro';
import type { Language } from '@/lib/i18n';
import { getUrlPrefix } from '@/lib/i18n';
import {
  getActiveNotifications,
  localizeNotification,
} from '@/lib/notifications';

interface Props {
  lang: string;
  title: string;
  description: string;
  image?: string;
  keywords?: string[];
  prevPage?: string;
  nextPage?: string;
  ogType?: string;
  ogImageWidth?: number;
  ogImageHeight?: number;
  /** Forwarded to BaseHead — disable on pages with a dedicated LCP preload. */
  preloadHeaderLogo?: boolean;
  preloadFonts?: boolean;
  lcpImageHref?: string;
  lcpImageMedia?: string;
}

const {
  lang,
  title,
  description,
  image,
  keywords,
  prevPage,
  nextPage,
  ogType,
  ogImageWidth,
  ogImageHeight,
  preloadHeaderLogo = true,
  preloadFonts = true,
  lcpImageHref,
  lcpImageMedia,
} = Astro.props;

const language = lang as Language;
const prefix = getUrlPrefix(language);
const activeNotifications = (await getActiveNotifications()).map((entry) => {
  const localized = localizeNotification(entry, language);
  const href = localized.ctaHref;
  if (
    href?.startsWith('/') &&
    !href.startsWith('//') &&
    prefix &&
    !href.startsWith(`${prefix}/`)
  ) {
    return { ...localized, ctaHref: `${prefix}${href}` };
  }
  return localized;
});
---

<html lang={lang}>
  <head>
    <BaseHead
      title={title}
      description={description}
      image={image}
      lang={lang}
      keywords={keywords}
      prevPage={prevPage}
      nextPage={nextPage}
      ogType={ogType}
      ogImageWidth={ogImageWidth}
      ogImageHeight={ogImageHeight}
      preloadHeaderLogo={preloadHeaderLogo}
      preloadFonts={preloadFonts}
      lcpImageHref={lcpImageHref}
      lcpImageMedia={lcpImageMedia}
    />
    <slot name="head" />
    <LanguageRedirect lang={lang} />
    <script is:inline>
  (function(){var t=localStorage.getItem('theme');if(!t)t=window.matchMedia('(prefers-color-scheme:dark)').matches?'dark':'light';if(t==='dark')document.documentElement.classList.add('dark');else document.documentElement.classList.remove('dark');})();
</script>
  </head>
  <body
    class:list={[
      'flex flex-col min-h-screen bg-ptt-bg text-ptt',
      activeNotifications.length > 0 && 'has-top-notification',
    ]}
  >
    <a href="#main-content" class="sr-only focus:not-sr-only focus:absolute focus:top-4 focus:left-4 focus:z-[100] focus:bg-ptt-bg-elevated focus:px-4 focus:py-2 focus:rounded focus:shadow-lg focus:text-ptt-primary">
      Skip to content
    </a>
    {/*
      Sticky chrome: notification bar + header travel together so the green
      (important) alert stays visible on small viewports after scroll.
    */}
    <div class="sticky top-0 z-50">
      {
        activeNotifications.length > 0 && (
          <TopNotificationBar
            client:idle
            lang={lang}
            notifications={activeNotifications}
          />
        )
      }
      <Header client:idle lang={lang} />
    </div>
    <div
      class="fixed z-50"
      style="right: max(1rem, env(safe-area-inset-right)); bottom: max(1rem, env(safe-area-inset-bottom));"
    >
      <ThemeToggle />
    </div>
    <main id="main-content" class="flex-1 bg-ptt-bg">
      <slot />
    </main>
    <Footer lang={lang} />
    {/* client:load — WebMCP scanners detect tools on first paint; client:visible misses them. */}
    <WebMCPBridge client:load lang={lang as 'en' | 'es'} />
    {/*
      Do NOT use define:vars here — Astro wraps define:vars scripts in an IIFE,
      which breaks ES module `import` and causes:
      "SyntaxError: Cannot use import statement outside a module" (Best Practices).
      Defer setup until idle so analytics does not contend with LCP/TBT.
    */}
    <script>
      const bootAnalytics = () => {
        void import('@/lib/analytics').then(
          ({
            setupOutboundTracking,
            shouldTrackScrollDepth,
            trackScrollDepth,
          }) => {
            setupOutboundTracking();
            if (shouldTrackScrollDepth(window.location.pathname)) {
              trackScrollDepth();
            }
          }
        );
      };
      if (typeof window.requestIdleCallback === 'function') {
        window.requestIdleCallback(bootAnalytics, { timeout: 4000 });
      } else {
        window.addEventListener('load', () => setTimeout(bootAnalytics, 1), {
          once: true,
        });
      }
    </script>
  </body>
</html>
