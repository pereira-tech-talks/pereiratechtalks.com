---
import { mainContentTransition } from '~/utils/viewTransitions';

import Footer from '~/components/widgets/Footer.astro';
import Header from '~/components/widgets/Header.astro';
import Layout from '~/layouts/Layout.astro';

import { eventsHeaderData, footerData } from '~/navigation';
import { isPereiraTechDayPath } from '~/utils/colorMode';

import type { MetaData } from '~/types';
export interface Props {
  metadata?: MetaData;
}

const { metadata } = Astro.props;
const showThemeToggle = !isPereiraTechDayPath(Astro.url.pathname);
// Tema: solo /pereira-tech-day fuerza light (paleta propia) sin alterar localStorage.theme.
// El resto del sitio respeta la preferencia del usuario (ver utils/colorMode.ts).
//TODO: Agregar actions de inscribirse
---

<Layout metadata={metadata}>
  <slot name="header">
    <Header
      {...eventsHeaderData}
      persistId="pereira-tech-day-header"
      showToggleTheme={showThemeToggle}
      position="right"
      isSticky
      transparent
    />
  </slot>
  <main transition:animate={mainContentTransition} transition:name="main-content" class="page-content">
    <slot />
  </main>
  <slot name="footer">
    <Footer {...footerData} />
  </slot>
</Layout>
