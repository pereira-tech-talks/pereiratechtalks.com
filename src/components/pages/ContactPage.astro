---
import ContactForm from '@/components/contact/ContactForm.svelte';
import JsonLd from '@/components/JsonLd.astro';
import Breadcrumbs from '@/components/ui/Breadcrumbs.astro';
import Eyebrow from '@/components/ui/Eyebrow.astro';
import Section from '@/components/ui/Section.astro';
import MainLayout from '@/layouts/MainLayout.astro';
import { CONTACT_FORM } from '@/lib/constances';
import { getUrlPrefix, type Language } from '@/lib/i18n';
import { getTranslations } from '@/lib/translations';

interface Props {
  lang: Language;
}

const { lang } = Astro.props;
const t = getTranslations(lang);
const prefix = getUrlPrefix(lang);
const siteUrl = Astro.site?.href?.replace(/\/$/, '') ?? '';

const contactPageSchema = {
  '@context': 'https://schema.org',
  '@type': 'ContactPage',
  name: t.contactPage.title,
  description: t.contactPage.description,
  url: `${siteUrl}${prefix}/contact`,
  mainEntity: {
    '@type': 'Organization',
    name: 'Pereira Tech Talks',
    contactPoint: {
      '@type': 'ContactPoint',
      contactType: 'general',
      email: 'pereiratechtalks@gmail.com',
      availableLanguage: ['English', 'Spanish'],
    },
  },
};

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    {
      '@type': 'ListItem',
      position: 1,
      name: 'Home',
      item: `${siteUrl}${prefix}/`,
    },
    {
      '@type': 'ListItem',
      position: 2,
      name: t.contactPage.title,
      item: `${siteUrl}${prefix}/contact`,
    },
  ],
};

const breadcrumbs = [
  { label: lang === 'es' ? 'Inicio' : 'Home', href: `${prefix}/` },
  { label: t.contactPage.title },
];

const quickLinks = t.contactPage.quickLinks.map((link) => ({
  ...link,
  href: link.href.startsWith('/') ? `${prefix}${link.href}` : link.href,
}));
---

<MainLayout
  lang={lang}
  title={t.contactPage.title}
  description={t.contactPage.description}
  keywords={lang === 'en'
    ? ['contact Pereira Tech Talks', 'PTT contact', 'speak at meetup', 'Pereira Tech Day call for speakers', 'sponsor Pereira tech community', 'collaborate Pereira Tech Talks']
    : ['contactar Pereira Tech Talks', 'contacto PTT', 'ser ponente meetup', 'Pereira Tech Day convocatoria conferencistas', 'patrocinar comunidad tecnología Pereira', 'colaborar Pereira Tech Talks']}
>
  <Fragment slot="head">
    <JsonLd data={contactPageSchema} />
    <JsonLd data={breadcrumbSchema} />
  </Fragment>

  <div class="bg-gradient-to-br from-ptt-bg-dark to-ptt-bg-dark/90 text-white">
    <div class="main-container pt-12 sm:pt-16 pb-4">
      <Breadcrumbs items={breadcrumbs} onDark />
    </div>
    <div class="main-container pt-6 pb-16">
      <Eyebrow variant="accent">{t.contactPage.subtitle}</Eyebrow>
      <h1 class="mt-3 text-4xl sm:text-5xl font-bold tracking-tight">
        {t.contactPage.title}
      </h1>
      <p class="mt-4 max-w-3xl text-lg text-white/85">
        {t.contactPage.heroDescription}
      </p>
    </div>
  </div>

  <Section>
    <div class="grid gap-12 lg:grid-cols-[minmax(0,1fr)_320px] lg:gap-16">
      <div class="min-w-0">
        <h2 class="text-2xl sm:text-3xl font-bold text-ptt mb-2">
          {t.contactPage.formTitle}
        </h2>
        <p class="mb-8 text-ptt-secondary">{t.contactPage.formNote}</p>
        <ContactForm
          client:visible
          lang={lang}
          apiEndpoint={CONTACT_FORM.apiEndpoint}
        />
      </div>

      <aside class="space-y-8">
        <div>
          <h3 class="text-lg font-bold text-ptt">{t.contactPage.quickLinksTitle}</h3>
          <ul class="mt-4 space-y-3 list-none">
            {
              quickLinks.map((link) => (
                <li>
                  <a
                    href={link.href}
                    class="block rounded-xl border border-ptt-border bg-ptt-bg-elevated p-4 transition hover:border-ptt-primary/40"
                  >
                    <p class="font-semibold text-ptt">{link.label}</p>
                    <p class="mt-1 text-sm text-ptt-secondary">{link.description}</p>
                  </a>
                </li>
              ))
            }
          </ul>
        </div>
        <div class="rounded-2xl bg-ptt-bg-dark p-6 text-white">
          <h3 class="text-lg font-bold">{t.contactPage.meetInPersonTitle}</h3>
          <p class="mt-2 text-sm text-white/85">{t.contactPage.meetInPersonText}</p>
        </div>
      </aside>
    </div>
  </Section>

  <Section title={t.contactPage.socialTitle} surface="alt">
    <div class="grid grid-cols-1 sm:grid-cols-2 xl:grid-cols-3 gap-6">
      <a href="https://github.com/pereira-tech-talks" target="_blank" rel="noopener noreferrer" class="group flex items-center gap-4 rounded-2xl border border-ptt-border bg-ptt-bg-elevated p-5 transition hover:border-ptt-primary/40 hover:shadow-md">
        <div class="flex h-12 w-12 shrink-0 items-center justify-center rounded-full bg-ptt-bg-dark">
          <svg class="h-6 w-6 text-white" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 .297c-6.63 0-12 5.373-12 12 0 5.303 3.438 9.8 8.205 11.385.6.113.82-.258.82-.577 0-.285-.01-1.04-.015-2.04-3.338.724-4.042-1.61-4.042-1.61C4.422 18.07 3.633 17.7 3.633 17.7c-1.087-.744.084-.729.084-.729 1.205.084 1.838 1.236 1.838 1.236 1.07 1.835 2.809 1.305 3.495.998.108-.776.417-1.305.76-1.605-2.665-.3-5.466-1.332-5.466-5.93 0-1.31.465-2.38 1.235-3.22-.135-.303-.54-1.523.105-3.176 0 0 1.005-.322 3.3 1.23.96-.267 1.98-.399 3-.405 1.02.006 2.04.138 3 .405 2.28-1.552 3.285-1.23 3.285-1.23.645 1.653.24 2.873.12 3.176.765.84 1.23 1.91 1.23 3.22 0 4.61-2.805 5.625-5.475 5.92.42.36.81 1.096.81 2.22 0 1.606-.015 2.896-.015 3.286 0 .315.21.69.825.57C20.565 22.092 24 17.592 24 12.297c0-6.627-5.373-12-12-12"/></svg>
        </div>
        <div>
          <p class="font-semibold text-ptt group-hover:text-ptt-primary dark:group-hover:text-ptt-primary-dark">GitHub</p>
          <p class="text-sm text-ptt-secondary">@pereira-tech-talks</p>
        </div>
      </a>
      <a href="https://www.linkedin.com/company/pereira-tech-talks/" target="_blank" rel="noopener noreferrer" class="group flex items-center gap-4 rounded-2xl border border-ptt-border bg-ptt-bg-elevated p-5 transition hover:border-ptt-primary/40 hover:shadow-md">
        <div class="flex h-12 w-12 shrink-0 items-center justify-center rounded-full bg-ptt-bg-dark">
          <svg class="h-6 w-6 text-white" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"></path></svg>
        </div>
        <div>
          <p class="font-semibold text-ptt group-hover:text-ptt-primary dark:group-hover:text-ptt-primary-dark">LinkedIn</p>
          <p class="text-sm text-ptt-secondary">Pereira Tech Talks</p>
        </div>
      </a>
      <a href="https://x.com/pertechtalks" target="_blank" rel="noopener noreferrer" class="group flex items-center gap-4 rounded-2xl border border-ptt-border bg-ptt-bg-elevated p-5 transition hover:border-ptt-primary/40 hover:shadow-md">
        <div class="flex h-12 w-12 shrink-0 items-center justify-center rounded-full bg-ptt-bg-dark">
          <svg class="h-5 w-5 text-white" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"></path></svg>
        </div>
        <div>
          <p class="font-semibold text-ptt group-hover:text-ptt-primary dark:group-hover:text-ptt-primary-dark">X (Twitter)</p>
          <p class="text-sm text-ptt-secondary">@pertechtalks</p>
        </div>
      </a>
      <a href="https://www.instagram.com/pertechtalks" target="_blank" rel="noopener noreferrer" class="group flex items-center gap-4 rounded-2xl border border-ptt-border bg-ptt-bg-elevated p-5 transition hover:border-ptt-primary/40 hover:shadow-md">
        <div class="flex h-12 w-12 shrink-0 items-center justify-center rounded-full bg-ptt-bg-dark">
          <svg class="h-6 w-6 text-white" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"></path></svg>
        </div>
        <div>
          <p class="font-semibold text-ptt group-hover:text-ptt-primary dark:group-hover:text-ptt-primary-dark">Instagram</p>
          <p class="text-sm text-ptt-secondary">@pertechtalks</p>
        </div>
      </a>
      <a href="https://chat.whatsapp.com/GI5ZismAsqA4a4EPHnJ6RG" target="_blank" rel="noopener noreferrer" class="group flex items-center gap-4 rounded-2xl border border-ptt-border bg-ptt-bg-elevated p-5 transition hover:border-ptt-primary/40 hover:shadow-md">
        <div class="flex h-12 w-12 shrink-0 items-center justify-center rounded-full bg-ptt-bg-dark">
          <svg class="h-6 w-6 text-white" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.889 9.888-9.889 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.435 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/></svg>
        </div>
        <div>
          <p class="font-semibold text-ptt group-hover:text-ptt-primary dark:group-hover:text-ptt-primary-dark">WhatsApp</p>
          <p class="text-sm text-ptt-secondary">{lang === 'es' ? 'Grupo de la comunidad' : 'Community group'}</p>
        </div>
      </a>
    </div>
  </Section>

  <Section title={t.contactPage.locationTitle}>
    <p class="text-lg text-ptt-secondary max-w-3xl">{t.contactPage.locationText}</p>
  </Section>
</MainLayout>
