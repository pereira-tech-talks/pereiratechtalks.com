---
/**
 * PTT v3.0.0 single vertical (program) detail page. Renders mission, full
 * description, leaders, related meetups, channels, and the markdown body.
 */

import type { CollectionEntry } from 'astro:content';
import { render } from 'astro:content';
import MeetupCard from '@/components/cards/MeetupCard.astro';
import SpeakerSchoolForm from '@/components/contact/SpeakerSchoolForm.svelte';
import Breadcrumbs from '@/components/ui/Breadcrumbs.astro';
import Eyebrow from '@/components/ui/Eyebrow.astro';
import MainLayout from '@/layouts/MainLayout.astro';
import { CONTACT_FORM, SITE_URL } from '@/lib/constances';
import { getUrlPrefix, type Language, tr } from '@/lib/i18n';
import { getMeetupsByVertical } from '@/lib/meetup';
import { buildMetaDescription, metaPhrases } from '@/lib/meta-description';
import { getTranslations } from '@/lib/translations';
import { getVerticalBodyEntry } from '@/lib/vertical';

interface Props {
  vertical: CollectionEntry<'verticals'>;
  lang: Language;
}

const { vertical, lang } = Astro.props;
const t = getTranslations(lang);

const prefix = getUrlPrefix(lang);
const title = tr(vertical.data.title, lang);
const mission = tr(vertical.data.mission, lang);
const description = tr(vertical.data.description, lang);
const heroSrc = vertical.data.hero?.src;
const schedule = tr(vertical.data.schedule, lang);
const isSpeakerSchool = vertical.id === 'speaker-school';

const meetups = (await getMeetupsByVertical(vertical.id)).slice(0, 6);

const { entry: bodyEntry, untranslated } = await getVerticalBodyEntry(
  vertical,
  lang
);
const { Content } = await render(bodyEntry);

// `mission` is a single line, well under the 130-char band. Extended with the
// program's own description and the community context.
const metaDescription = buildMetaDescription({
  lead: mission,
  clauses: [description, metaPhrases(lang).community],
  lang,
});

const breadcrumbs = [
  {
    label: t.nav.home,
    href: prefix === '' ? '/' : `${prefix}/`,
  },
  {
    label: t.verticalsPage.title,
    href: `${prefix}/verticals/`,
  },
  { label: title },
];
---

<MainLayout lang={lang} title={title} description={metaDescription} image={heroSrc}>
  <article class="bg-ptt-bg">
    <header class="relative overflow-hidden bg-gradient-to-br from-ptt-bg-dark to-ptt-bg-dark/90 text-white">
      {
        heroSrc && (
          <div class="absolute inset-0 opacity-25">
            <img
              src={heroSrc}
              alt=""
              width="1920"
              height="540"
              class="h-full w-full object-cover"
            />
          </div>
        )
      }
      <div class="relative main-container py-16 sm:py-24">
        <Breadcrumbs items={breadcrumbs} baseUrl={SITE_URL} onDark />
        <Eyebrow variant="accent" class="mt-6">
          {t.verticalsPage.programLabel}
        </Eyebrow>
        <h1 class="mt-3 text-4xl sm:text-6xl font-bold tracking-tight">
          {title}
        </h1>
        <p class="mt-4 max-w-3xl text-xl leading-relaxed text-white/85">{mission}</p>
        {
          schedule && (
            <p class="mt-6 text-sm font-medium text-ptt-accent">
              {schedule}
            </p>
          )
        }
        <div class="mt-8 flex flex-wrap gap-3">
          {
            isSpeakerSchool ? (
              <a
                href="#speaker-school-form"
                class="inline-flex min-h-[44px] items-center rounded-full bg-ptt-accent px-6 py-2.5 text-sm font-semibold text-ptt-bg-dark transition hover:bg-ptt-accent-dark focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-ptt-accent"
              >
                {t.verticalsPage.applyCta}
              </a>
            ) : (
              <a
                href={`${prefix}/contact/`}
                class="inline-flex min-h-[44px] items-center rounded-full bg-ptt-accent px-6 py-2.5 text-sm font-semibold text-ptt-bg-dark transition hover:bg-ptt-accent-dark focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-ptt-accent"
              >
                {t.verticalsPage.contactCta}
              </a>
            )
          }
          <a
            href={`${prefix}/channels/`}
            class="inline-flex min-h-[44px] items-center rounded-full border border-white/70 px-6 py-2.5 text-sm font-semibold text-white transition hover:bg-white/10 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-white"
          >
            {t.verticalsPage.joinCta}
          </a>
        </div>
      </div>
    </header>

    <section class="py-12 sm:py-16">
      <div class="main-container">
        <p class="text-lg text-ptt-secondary leading-relaxed">
          {description}
        </p>
      </div>
    </section>

    <section class="py-12 sm:py-16 bg-ptt-bg-elevated">
      <div class="main-container">
        <div class="prose prose-lg dark:prose-invert max-w-3xl prose-a:text-ptt-primary dark:prose-a:text-ptt-primary-dark">
          {
            untranslated && (
              <p
                class="not-prose mb-8 flex items-start gap-2.5 rounded-xl border border-ptt-border bg-ptt-bg px-4 py-3 text-sm text-ptt-secondary"
                lang="en"
              >
                <svg
                  class="mt-0.5 h-4 w-4 shrink-0 text-ptt-primary dark:text-ptt-primary-dark"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  aria-hidden="true"
                >
                  <circle cx="12" cy="12" r="10" />
                  <path d="M2 12h20M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z" />
                </svg>
                <span>{t.meetupDetail.untranslatedBody}</span>
              </p>
            )
          }
          <div lang={untranslated ? 'es' : lang}>
            <Content />
          </div>
        </div>
      </div>
    </section>

    {
      meetups.length > 0 && (
        <section class="py-16 sm:py-20">
          <div class="main-container">
            <h2 class="text-3xl font-bold tracking-tight text-ptt">
              {t.verticalsPage.relatedMeetups}
            </h2>
            <ul class="mt-8 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
              {meetups.map((meetup) => (
                <li>
                  <MeetupCard meetup={meetup} lang={lang} />
                </li>
              ))}
            </ul>
          </div>
        </section>
      )
    }

    {
      isSpeakerSchool && (
        <section
          id="speaker-school-form"
          class="py-16 sm:py-20 bg-ptt-bg-elevated"
          aria-labelledby="speaker-school-form-title"
        >
          <div class="main-container">
            <Eyebrow class="mb-3">{t.speakerSchoolForm.formEyebrow}</Eyebrow>
            <h2
              id="speaker-school-form-title"
              class="text-3xl font-bold tracking-tight text-ptt"
            >
              {t.speakerSchoolForm.formSectionTitle}
            </h2>
            <div class="mt-8 max-w-2xl mx-auto">
              <SpeakerSchoolForm
                client:visible
                lang={lang}
                apiEndpoint={CONTACT_FORM.apiEndpoint}
              />
            </div>
          </div>
        </section>
      )
    }
  </article>
</MainLayout>
