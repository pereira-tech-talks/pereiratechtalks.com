---
/**
 * PTT v3.0.0 single vertical (program) detail page. Renders mission, full
 * description, leaders, related meetups, channels, and the markdown body.
 */

import type { CollectionEntry } from 'astro:content';
import { render } from 'astro:content';
import MeetupCard from '@/components/cards/MeetupCard.astro';
import Breadcrumbs from '@/components/ui/Breadcrumbs.astro';
import Eyebrow from '@/components/ui/Eyebrow.astro';
import MainLayout from '@/layouts/MainLayout.astro';
import { getUrlPrefix, type Language, tr } from '@/lib/i18n';
import { getMeetupsByVertical } from '@/lib/meetup';
import { getTranslations } from '@/lib/translations';

interface Props {
  vertical: CollectionEntry<'verticals'>;
  lang: Language;
}

const { vertical, lang } = Astro.props;
const t = getTranslations(lang);

const prefix = getUrlPrefix(lang);
const title = tr(vertical.data.title, lang);
const mission = tr(vertical.data.mission, lang);
const description = tr(vertical.data.description, lang);
const heroSrc = vertical.data.hero?.src;
const schedule = tr(vertical.data.schedule, lang);

const meetups = (await getMeetupsByVertical(vertical.id)).slice(0, 6);

const { Content } = await render(vertical);

const breadcrumbs = [
  {
    label: t.nav.home,
    href: prefix === '' ? '/' : `${prefix}/`,
  },
  {
    label: t.verticalsPage.title,
    href: `${prefix}/verticals/`,
  },
  { label: title },
];
---

<MainLayout lang={lang} title={title} description={mission} image={heroSrc}>
  <article class="bg-ptt-bg">
    <header class="relative overflow-hidden bg-gradient-to-br from-ptt-bg-dark to-ptt-bg-dark/90 text-white">
      {
        heroSrc && (
          <div class="absolute inset-0 opacity-25">
            <img
              src={heroSrc}
              alt=""
              width="1920"
              height="540"
              class="h-full w-full object-cover"
            />
          </div>
        )
      }
      <div class="relative main-container py-16 sm:py-24">
        <Breadcrumbs items={breadcrumbs} baseUrl="https://pereiratechtalks.org" onDark />
        <Eyebrow variant="accent" class="mt-6">
          {t.verticalsPage.programLabel}
        </Eyebrow>
        <h1 class="mt-3 text-4xl sm:text-6xl font-bold tracking-tight">
          {title}
        </h1>
        <p class="mt-4 max-w-3xl text-xl text-ptt-secondary">{mission}</p>
        {
          schedule && (
            <p class="mt-6 text-sm font-medium text-ptt-accent dark:text-ptt-accent-dark">
              {schedule}
            </p>
          )
        }
      </div>
    </header>

    <section class="py-12 sm:py-16">
      <div class="main-container">
        <p class="text-lg text-ptt-secondary leading-relaxed">
          {description}
        </p>
      </div>
    </section>

    <section class="py-12 sm:py-16 bg-ptt-bg-elevated">
      <div class="main-container">
        <div class="prose prose-lg dark:prose-invert max-w-3xl prose-a:text-ptt-primary dark:prose-a:text-ptt-primary-dark">
          <Content />
        </div>
      </div>
    </section>

    {
      meetups.length > 0 && (
        <section class="py-16 sm:py-20">
          <div class="main-container">
            <h2 class="text-3xl font-bold tracking-tight text-ptt">
              {t.verticalsPage.relatedMeetups}
            </h2>
            <ul class="mt-8 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
              {meetups.map((meetup) => (
                <li>
                  <MeetupCard meetup={meetup} lang={lang} />
                </li>
              ))}
            </ul>
          </div>
        </section>
      )
    }
  </article>
</MainLayout>
