---
import { getCollection } from 'astro:content';

import SeriesListingInfiniteScroll from '@/components/blog/SeriesListingInfiniteScroll.svelte';
import Eyebrow from '@/components/ui/Eyebrow.astro';
import MainLayout from '@/layouts/MainLayout.astro';
import { getSeriesTimelineIndex } from '@/lib/blog';
import { BLOG_PAGE_SIZE } from '@/lib/constances';
import { getUrlPrefix, type Language } from '@/lib/i18n';
import { getTranslations } from '@/lib/translations';

import type { SeriesListingEntry } from '@/pages/api/series/[lang]/index.json';

interface Props {
  lang: Language;
}

const { lang } = Astro.props;
const t = getTranslations(lang);
const prefix = getUrlPrefix(lang);

const allSeries = await getCollection('series');

const seriesWithMeta: SeriesListingEntry[] = (
  await Promise.all(
    allSeries.map(async (series) => {
      const posts = await getSeriesTimelineIndex(series.id, lang);
      if (posts.length === 0) return null;

      const lastPostDate = posts.reduce((latest, post) => {
        const d = post.pubDate;
        return d > latest ? d : latest;
      }, posts[0].pubDate);

      return {
        slug: series.id,
        title: series.data.title,
        description: series.data.description || '',
        order: series.data.order,
        postCount: posts.length,
        heroImage:
          (lang === 'es' && series.data.heroImageEs) ||
          series.data.heroImage ||
          null,
        firstPostHero: posts[0]?.heroImage || null,
        lastPostDate,
      };
    })
  )
).filter((s): s is SeriesListingEntry => s !== null);

// Sort by most recent post date (newest first), fallback to order
seriesWithMeta.sort((a, b) => {
  const dateCompare =
    new Date(b.lastPostDate).valueOf() - new Date(a.lastPostDate).valueOf();
  if (dateCompare !== 0) return dateCompare;
  return a.order - b.order;
});

const initialSeries = seriesWithMeta.slice(0, BLOG_PAGE_SIZE);
const seriesApiEndpoint = `/api/series/${lang}/index.json`;
---

<MainLayout
  lang={lang}
  title={t.seriesListingPage.title}
  description={t.seriesListingPage.description}
  ogType="website"
>
  <section class="bg-ptt-bg py-10 sm:py-12 lg:py-16">
    <!-- Breadcrumb -->
    <nav class="main-container mb-6 flex flex-wrap items-center gap-x-2 text-sm" aria-label="Breadcrumb">
      <a href={`${prefix}/blog/`} class="font-semibold text-ptt-secondary transition-colors hover:text-ptt-primary">{t.nav.blog}</a>
      <span class="font-semibold text-ptt-secondary select-none" aria-hidden="true">/</span>
      <span class="truncate font-normal text-ptt-secondary" aria-current="page">{t.seriesListingPage.heading}</span>
    </nav>

    <!-- Page header — brand-first, left-aligned -->
    <div class="main-container mb-10 max-w-3xl">
      <Eyebrow>{t.nav.blog}</Eyebrow>
      <h1 class="mt-3 text-3xl font-bold tracking-tight text-ptt md:text-4xl lg:text-5xl">
        {t.seriesListingPage.heading}
      </h1>
      <p class="mt-4 text-lg leading-relaxed text-ptt-secondary">
        {t.seriesListingPage.description}
      </p>
    </div>

    <SeriesListingInfiniteScroll
      client:visible
      {initialSeries}
      totalCount={seriesWithMeta.length}
      apiEndpoint={seriesApiEndpoint}
      {lang}
      pageSize={BLOG_PAGE_SIZE}
    />

    <!-- Back to blog -->
    <div class="main-container mt-10">
      <a
        href={`${prefix}/blog/`}
        class="inline-flex min-h-[44px] items-center gap-2 text-sm font-semibold text-ptt-secondary hover:text-ptt-primary transition-colors"
      >
        <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7" />
        </svg>
        {t.seriesPage.backToBlog}
      </a>
    </div>
  </section>
</MainLayout>
