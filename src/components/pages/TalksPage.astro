---
/**
 * PTT v3.0.0 talks directory page (shared between EN and ES).
 */

import TalkCard from '@/components/cards/TalkCard.astro';
import Breadcrumbs from '@/components/ui/Breadcrumbs.astro';
import EmptyState from '@/components/ui/EmptyState.astro';
import Eyebrow from '@/components/ui/Eyebrow.astro';
import Section from '@/components/ui/Section.astro';
import MainLayout from '@/layouts/MainLayout.astro';
import { type Language } from '@/lib/i18n';
import { getSpeakers } from '@/lib/speaker';
import { getTalks } from '@/lib/talk';

interface Props {
  lang: Language;
}

const { lang } = Astro.props;

const talks = await getTalks();
const speakers = await getSpeakers();
const speakerNameById = new Map(speakers.map((s) => [s.id, s.data.name]));

const t = {
  title: lang === 'es' ? 'Charlas' : 'Talks',
  description:
    lang === 'es'
      ? 'Catálogo de charlas dictadas en meetups, Pereira Tech Days y eventos asociados de la comunidad. Cada charla incluye su resumen y enlace al evento donde se presentó.'
      : 'Catalog of talks delivered at meetups, Pereira Tech Days, and associated community events. Each talk includes its abstract and a link to the event where it was presented.',
  intro:
    lang === 'es'
      ? `${talks.length} charlas registradas. La colección crece con cada meetup nuevo.`
      : `${talks.length} talks indexed. The collection grows with every new meetup.`,
  emptyTitle:
    lang === 'es' ? 'Aún no hay charlas registradas' : 'No talks indexed yet',
  emptyDesc:
    lang === 'es'
      ? 'Estamos llenando el catálogo con las charlas históricas y las próximas. Vuelve pronto.'
      : "We're populating the catalog with historical and upcoming talks. Check back soon.",
};

const breadcrumbs = [
  {
    label: lang === 'es' ? 'Inicio' : 'Home',
    href: lang === 'es' ? '/es/' : '/',
  },
  { label: t.title },
];
---

<MainLayout lang={lang} title={t.title} description={t.description}>
  <div class="bg-white dark:bg-gray-950">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 pt-12 sm:pt-16 pb-4">
      <Breadcrumbs items={breadcrumbs} />
    </div>
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 pt-6 pb-12">
      <Eyebrow>{lang === 'es' ? 'Catálogo' : 'Catalog'}</Eyebrow>
      <h1 class="mt-3 text-4xl sm:text-5xl font-bold tracking-tight text-gray-900 dark:text-gray-50">
        {t.title}
      </h1>
      <p class="mt-4 max-w-3xl text-lg text-gray-600 dark:text-gray-300">
        {t.intro}
      </p>
    </div>
  </div>

  <Section
    eyebrow={lang === 'es' ? 'Catálogo' : 'Catalog'}
    title={lang === 'es' ? 'Todas las charlas' : 'All talks'}
    surface="alt"
    spacing="lg"
  >
    {
      talks.length > 0 ? (
        <ul class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
          {talks.map((talk) => (
            <li>
              <TalkCard
                talk={talk}
                lang={lang}
                speakerNames={talk.data.speakers
                  .map((s) => speakerNameById.get(s) ?? s)
                  .filter(Boolean)}
              />
            </li>
          ))}
        </ul>
      ) : (
        <EmptyState title={t.emptyTitle} description={t.emptyDesc} />
      )
    }
  </Section>
</MainLayout>
