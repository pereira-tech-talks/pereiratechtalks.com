---
/**
 * PTT v3.0.0 single speaker detail page — bio + their talks + related events.
 */

import type { CollectionEntry } from 'astro:content';
import TalkCard from '@/components/cards/TalkCard.astro';
import JsonLd from '@/components/JsonLd.astro';
import SpeakerSocialLinks from '@/components/speakers/SpeakerSocialLinks.astro';
import Breadcrumbs from '@/components/ui/Breadcrumbs.astro';
import MainLayout from '@/layouts/MainLayout.astro';
import { SITE_URL } from '@/lib/constances';
import { getCalendarYear } from '@/lib/dates';
import { getEventBySlug } from '@/lib/event';
import { getUrlPrefix, type Language, tr } from '@/lib/i18n';
import { getMeetupBySlug } from '@/lib/meetup';
import { buildMetaDescription, metaPhrases } from '@/lib/meta-description';
import { getEditionByYear } from '@/lib/pereiraTechDay';
import { getTalksBySpeaker } from '@/lib/talk';
import { getTranslations } from '@/lib/translations';

interface Props {
  speaker: CollectionEntry<'speakers'>;
  lang: Language;
}

const { speaker, lang } = Astro.props;
const sd = getTranslations(lang).speakerDetail;

const prefix = getUrlPrefix(lang);
const name = speaker.data.name;
const role = tr(speaker.data.role, lang);
const bio = tr(speaker.data.bio, lang);
const photoSrc = speaker.data.photo.src;
const photoAlt = tr(speaker.data.photo.alt, lang) || `Portrait of ${name}`;

const talks = await getTalksBySpeaker(speaker.id);
const social = speaker.data.social ?? {};

/**
 * Label for a related event: the entry's own title in the reader's language.
 * Humanizing the slug (the old behaviour) leaked Spanish slugs onto `/en`
 * pages and read as a slug dump on both.
 */
const resolveEventLabel = async (
  collection: 'meetups' | 'events' | 'pereiraTechDays',
  slug: string
): Promise<string> => {
  if (collection === 'pereiraTechDays') {
    const edition = await getEditionByYear(Number(slug));
    return edition ? tr(edition.data.title, lang) : `Pereira Tech Day ${slug}`;
  }
  const entry =
    collection === 'meetups'
      ? await getMeetupBySlug(slug)
      : await getEventBySlug(slug);
  return entry ? tr(entry.data.title, lang) : slug.replace(/-/g, ' ');
};

const relatedEvents = Array.from(
  talks
    // `flatMap` narrows `event` for TypeScript; `filter` alone leaves it
    // optional and forces a non-null assertion.
    .flatMap((t) => (t.data.event ? [t.data.event] : []))
    .reduce(
      (map, event) => {
        const key = `${event.collection}:${event.slug}`;
        if (!map.has(key)) {
          map.set(key, {
            collection: event.collection,
            slug: event.slug,
            href:
              event.collection === 'meetups'
                ? `${prefix}/meetups/${event.slug}/`
                : event.collection === 'pereiraTechDays'
                  ? `${prefix}/pereira-tech-days/${event.slug}/`
                  : `${prefix}/events/${event.slug}/`,
          });
        }
        return map;
      },
      new Map<
        string,
        {
          collection: 'meetups' | 'events' | 'pereiraTechDays';
          slug: string;
          href: string;
        }
      >()
    )
    .values()
);

const relatedEventLinks = await Promise.all(
  relatedEvents.map(async (event) => ({
    ...event,
    label: await resolveEventLabel(event.collection, event.slug),
  }))
);

const breadcrumbs = [
  {
    label: sd.breadcrumbHome,
    href: prefix === '' ? '/' : `${prefix}/`,
  },
  {
    label: sd.breadcrumbSpeakers,
    href: `${prefix}/speakers/`,
  },
  { label: name },
];

/**
 * The bio is a one-line credit, so on its own it lands far under the 130-char
 * band. Extended with facts the page already states — the role, how many talks
 * are in the archive, and where the community is.
 */
const phrases = metaPhrases(lang);
const metaDescription = buildMetaDescription({
  lead: bio,
  clauses: [
    role && !bio.includes(role) ? phrases.speakerRole(role) : null,
    talks.length > 0 ? phrases.speakerTalks(talks.length) : null,
    phrases.community,
  ].filter(Boolean),
  lang,
});

const sameAs = [
  social.twitter,
  social.linkedin,
  social.github,
  social.website,
  social.instagram,
  social.mastodon,
  social.bluesky,
].filter((s): s is string => Boolean(s));
const personJsonLd: Record<string, unknown> = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name,
  jobTitle: role,
  description: bio,
  image: photoSrc?.startsWith('http') ? photoSrc : `${SITE_URL}${photoSrc}`,
  url: `${SITE_URL}${prefix}/speakers/${speaker.id}/`,
  sameAs: sameAs.length > 0 ? sameAs : undefined,
};
---

<MainLayout
  lang={lang}
  title={`${name} — ${role}`}
  description={metaDescription}
  image={photoSrc}
>
  <JsonLd data={personJsonLd} />
  <article class="bg-ptt-bg">
    <div class="main-container py-12">
      <Breadcrumbs items={breadcrumbs} />
      <div class="mt-8 flex flex-col items-start gap-8 sm:flex-row">
        <div class="relative h-40 w-40 shrink-0 overflow-hidden rounded-full ring-4 ring-ptt-accent/30 dark:ring-ptt-accent-dark/30 bg-ptt-primary-soft dark:bg-ptt-bg-elevated">
          <img
            src={photoSrc}
            alt={photoAlt}
            width="160"
            height="160"
            class="h-full w-full object-cover"
            loading="eager"
          />
        </div>
        <div class="flex-1">
          <h1 class="text-3xl sm:text-4xl font-bold tracking-tight text-ptt">
            {name}
          </h1>
          <p class="mt-2 text-lg text-ptt-primary dark:text-ptt-primary-dark font-medium">
            {role}
          </p>
          <p class="mt-4 text-ptt-secondary max-w-3xl leading-relaxed">
            {bio}
          </p>
          <SpeakerSocialLinks
            speaker={speaker}
            variant="pills"
            class="mt-6"
          />
        </div>
      </div>
    </div>

    {
      relatedEventLinks.length > 0 && (
        <section class="main-container pb-8">
          <h2 class="text-2xl font-bold tracking-tight text-ptt">
            {sd.relatedEvents}
          </h2>
          <p class="mt-2 text-ptt-secondary">{sd.relatedEventsSubtitle}</p>
          <ul class="mt-4 flex flex-wrap gap-3">
            {relatedEventLinks.map((event) => (
              <li>
                <a
                  href={event.href}
                  class="inline-flex min-h-[44px] items-center rounded-full bg-ptt-primary-soft px-4 py-2 text-sm font-medium text-ptt hover:bg-ptt-primary hover:text-white dark:bg-ptt-bg-elevated dark:hover:bg-ptt-primary-dark dark:hover:text-gray-950"
                >
                  {event.label}
                </a>
              </li>
            ))}
          </ul>
        </section>
      )
    }

    {
      talks.length > 0 && (
        <section class="bg-ptt-primary-soft/40 dark:bg-ptt-bg-elevated py-16 sm:py-20">
          <div class="main-container">
            <h2 class="text-3xl font-bold tracking-tight text-ptt">
              {`${sd.talkHistory} — ${name}`}
            </h2>
            <p class="mt-2 text-ptt-secondary">{sd.talkHistorySubtitle}</p>
            <ol class="mt-8 relative space-y-8 border-l border-ptt-border pl-6">
              {talks.map((talk) => {
                const year = talk.data.date
                  ? getCalendarYear(talk.data.date)
                  : null;
                return (
                  <li class="relative">
                    <span
                      class="absolute -left-[1.9rem] top-3 h-3 w-3 rounded-full bg-ptt-primary dark:bg-ptt-primary-dark ring-4 ring-ptt-bg"
                      aria-hidden="true"
                    />
                    {year && (
                      <p class="mb-2 text-xs font-semibold uppercase tracking-wider text-ptt-primary dark:text-ptt-primary-dark">
                        {year}
                      </p>
                    )}
                    <TalkCard talk={talk} lang={lang} speakerNames={[name]} />
                  </li>
                );
              })}
            </ol>
          </div>
        </section>
      )
    }
  </article>
</MainLayout>
