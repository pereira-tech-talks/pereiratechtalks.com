---
/**
 * Allied communities stub — full page craft lands in Tasks 71–72.
 */
import Breadcrumbs from '@/components/ui/Breadcrumbs.astro';
import Eyebrow from '@/components/ui/Eyebrow.astro';
import Section from '@/components/ui/Section.astro';
import MainLayout from '@/layouts/MainLayout.astro';
import { getUrlPrefix, type Language } from '@/lib/i18n';
import { getTranslations } from '@/lib/translations';

interface Props {
  lang: Language;
}

const { lang } = Astro.props;
const t = getTranslations(lang);
const prefix = getUrlPrefix(lang);

const title = t.nav.communities;
const description =
  lang === 'es'
    ? 'Comunidades aliadas del ecosistema tech de Pereira: PereiraJS, Python Pereira, JointDev, QA Conf, Backbone y más.'
    : 'Allied communities in Pereira’s tech ecosystem: PereiraJS, Python Pereira, JointDev, QA Conf, Backbone, and more.';

const breadcrumbs = [
  { label: lang === 'es' ? 'Inicio' : 'Home', href: `${prefix}/` },
  { label: title },
];

const allies = [
  { name: 'PereiraJS', href: 'https://pereirajs.org/' },
  { name: 'Python Pereira', href: 'https://pypereira.dev/' },
  { name: 'JointDev', href: 'https://www.instagram.com/jointdev/' },
  { name: 'QA Conf', href: 'https://www.qaconf.co/' },
  { name: 'Backbone UTP', href: '#' },
];
---

<MainLayout lang={lang} title={title} description={description}>
  <div class="bg-ptt-bg">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 pt-12 sm:pt-16 pb-4">
      <Breadcrumbs items={breadcrumbs} />
    </div>
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 pt-6 pb-12">
      <Eyebrow>{lang === 'es' ? 'Ecosistema' : 'Ecosystem'}</Eyebrow>
      <h1 class="mt-3 text-4xl sm:text-5xl font-bold tracking-tight text-ptt">
        {title}
      </h1>
      <p class="mt-4 max-w-3xl text-lg text-ptt-secondary">
        {
          lang === 'es'
            ? 'Pereira Tech Talks crece junto a otras comunidades de la ciudad. Esta página celebrará alianzas, calendarios compartidos y colaboraciones.'
            : 'Pereira Tech Talks grows alongside other city communities. This page will celebrate alliances, shared calendars, and collaborations.'
        }
      </p>
    </div>
  </div>
  <Section eyebrow={lang === 'es' ? 'Aliadas' : 'Allies'}>
    <ul class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
      {
        allies.map((a) => (
          <li>
            <a
              href={a.href}
              class="block rounded-xl border border-ptt-border bg-ptt-bg-elevated px-5 py-4 text-ptt font-semibold hover:border-ptt-primary transition-colors"
              target={a.href.startsWith('http') ? '_blank' : undefined}
              rel={a.href.startsWith('http') ? 'noopener noreferrer' : undefined}
            >
              {a.name}
            </a>
          </li>
        ))
      }
    </ul>
  </Section>
</MainLayout>
