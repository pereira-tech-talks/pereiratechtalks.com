---
/**
 * Allied communities directory — celebrates Pereira's tech ecosystem partners.
 */

import CommunityCard from '@/components/community/CommunityCard.astro';
import Breadcrumbs from '@/components/ui/Breadcrumbs.astro';
import Eyebrow from '@/components/ui/Eyebrow.astro';
import Section from '@/components/ui/Section.astro';
import MainLayout from '@/layouts/MainLayout.astro';
import { getActiveCommunities } from '@/lib/communities';
import { getUrlPrefix, type Language } from '@/lib/i18n';
import { getTranslations } from '@/lib/translations';

interface Props {
  lang: Language;
}

const { lang } = Astro.props;
const t = getTranslations(lang);
const cp = t.communitiesPage;
const prefix = getUrlPrefix(lang);

const communities = await getActiveCommunities();

const breadcrumbs = [
  { label: lang === 'es' ? 'Inicio' : 'Home', href: `${prefix}/` },
  { label: cp.title },
];

const contactHref = `${prefix}/contact/?topic=collaboration&subject=${encodeURIComponent(
  lang === 'es'
    ? 'Propuesta de alianza comunitaria'
    : 'Community alliance proposal'
)}`;
const channelsHref = `${prefix}/channels/`;
---

<MainLayout lang={lang} title={cp.title} description={cp.description}>
  <div class="bg-gradient-to-br from-ptt-bg-dark to-ptt-bg-dark/90 text-white">
    <div class="main-container pt-12 sm:pt-16 pb-4">
      <Breadcrumbs items={breadcrumbs} onDark />
    </div>
    <div class="main-container pt-6 pb-16">
      <Eyebrow variant="accent">{cp.eyebrow}</Eyebrow>
      <h1 class="mt-3 text-4xl sm:text-5xl font-bold tracking-tight">
        {cp.title}
      </h1>
      <p class="mt-4 max-w-3xl text-lg text-white/85">{cp.heroLead}</p>
    </div>
  </div>

  <Section title={cp.narrativeTitle}>
    <p class="max-w-3xl text-lg text-ptt-secondary">{cp.narrativeText}</p>
  </Section>

  <Section title={cp.alliesTitle} surface="alt">
    <ul class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3 list-none">
      {
        communities.map((community) => (
          <li>
            <CommunityCard
              community={community}
              lang={lang}
              visitLabel={cp.visitLabel}
            />
          </li>
        ))
      }
    </ul>
  </Section>

  <Section title={cp.allianceTitle}>
    <ul class="grid gap-4 sm:grid-cols-2 list-none max-w-4xl">
      {
        cp.allianceSteps.map((step) => (
          <li class="flex items-start gap-3 rounded-xl border border-ptt-border bg-ptt-bg-elevated p-5">
            <svg
              aria-hidden="true"
              class="h-5 w-5 shrink-0 text-ptt-primary dark:text-ptt-primary-dark mt-0.5"
              fill="currentColor"
              viewBox="0 0 20 20"
            >
              <path
                fill-rule="evenodd"
                d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z"
                clip-rule="evenodd"
              />
            </svg>
            <p class="text-ptt-secondary">{step}</p>
          </li>
        ))
      }
    </ul>
  </Section>

  <div class="bg-ptt-bg-dark text-white py-16">
    <div class="main-container text-center">
      <h2 class="text-3xl sm:text-4xl font-bold tracking-tight">
        {cp.ctaTitle}
      </h2>
      <p class="mt-3 text-white/85">{cp.ctaDescription}</p>
      <div class="mt-6 flex flex-col sm:flex-row items-center justify-center gap-3">
        <a
          href={contactHref}
          class="inline-flex items-center gap-2 rounded-full bg-ptt-accent px-6 py-3 text-base font-semibold text-ptt-bg-dark shadow-sm transition-colors hover:bg-ptt-accent/90 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-ptt-accent"
        >
          {cp.ctaPrimary}
        </a>
        <a
          href={channelsHref}
          class="inline-flex items-center gap-2 rounded-full bg-white/10 px-6 py-3 text-base font-semibold text-white ring-1 ring-white/30 hover:bg-white/15"
        >
          {cp.ctaSecondary}
        </a>
      </div>
    </div>
  </div>
</MainLayout>
