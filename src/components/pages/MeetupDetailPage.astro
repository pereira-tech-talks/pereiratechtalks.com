---
/**
 * PTT v3.0.0 single meetup detail page.
 *
 * Renders the meetup body (markdown), talks list (with speakers), venue,
 * sponsors, and source links.
 */

import type { CollectionEntry } from 'astro:content';
import { render } from 'astro:content';
import BlogHeroImage from '@/components/blog/BlogHeroImage.astro';
import SpeakerCard from '@/components/cards/SpeakerCard.astro';
import SponsorCard from '@/components/cards/SponsorCard.astro';
import TalkCard from '@/components/cards/TalkCard.astro';
import JsonLd from '@/components/JsonLd.astro';
import CallForSpeakersPanel from '@/components/meetups/CallForSpeakersPanel.astro';
import MeetupDateTile from '@/components/meetups/MeetupDateTile.astro';
import PtdGalleryCarousel from '@/components/pereira-tech-days/PtdGalleryCarousel.svelte';
import Badge from '@/components/ui/Badge.astro';
import Breadcrumbs from '@/components/ui/Breadcrumbs.astro';
import MainLayout from '@/layouts/MainLayout.astro';
import { SITE_URL } from '@/lib/constances';
import { formatCalendarDate } from '@/lib/dates';
import { getUrlPrefix, type Language, tr } from '@/lib/i18n';
import {
  getCallForSpeakersState,
  getMeetupBodyEntry,
  getMeetupSlug,
  resolveMeetupDateAttribute,
  resolveMeetupDateConfidence,
  resolveMeetupDateLabel,
  resolveMeetupLineup,
  resolveMeetupStatus,
} from '@/lib/meetup';
import { buildMetaDescription, metaPhrases } from '@/lib/meta-description';
import { getSpeakersBySlugs } from '@/lib/speaker';
import { getEditionSponsors } from '@/lib/sponsor';
import { getTalksByEvent } from '@/lib/talk';
import { getTranslations } from '@/lib/translations';
import { extractYouTubeId } from '@/lib/youtube';

interface Props {
  meetup: CollectionEntry<'meetups'>;
  lang: Language;
}

const { meetup, lang } = Astro.props;
const md = getTranslations(lang).meetupDetail;

const prefix = getUrlPrefix(lang);
const slug = getMeetupSlug(meetup);
const title = tr(meetup.data.title, lang);
const description = tr(meetup.data.description, lang);
const heroSrc =
  (lang === 'en' && meetup.data.hero?.srcEn) ||
  meetup.data.hero?.src ||
  meetup.data.heroImage;
const heroLayout = meetup.data.hero?.layout ?? (heroSrc ? 'banner' : 'none');
const heroAlt = tr(meetup.data.hero?.alt, lang) || title;
const bannerHeroSrc = heroSrc && heroLayout === 'banner' ? heroSrc : undefined;

const date = new Date(meetup.data.date);
const dateConfidence = resolveMeetupDateConfidence(meetup);
// A month-only meetup prints its month; a tentative one prints its day and
// carries the caveat in a chip beside it, so the same label works in a
// `<time>` element, a card and an aria-label.
const dateLabel =
  dateConfidence === 'month-only'
    ? resolveMeetupDateLabel(meetup, lang)
    : formatCalendarDate(date, lang, {
        weekday: 'long',
        year: 'numeric',
        month: 'long',
        day: 'numeric',
      });
const dateAttribute = resolveMeetupDateAttribute(meetup);

const venue = meetup.data.venue;
const status = resolveMeetupStatus(meetup);
const lineup = resolveMeetupLineup(meetup);
const callState = getCallForSpeakersState(meetup);
const planning = md.planning;

const talks = await getTalksByEvent('meetups', slug);
const speakerSlugs = [
  ...new Set([
    ...(meetup.data.speakers ?? []),
    ...talks.flatMap((t) => t.data.speakers),
  ]),
];
const speakers = await getSpeakersBySlugs(speakerSlugs);
const speakerNameBySlug = new Map(speakers.map((s) => [s.id, s.data.name]));
const editionSponsors = await getEditionSponsors(meetup.data.sponsors ?? []);
const gallery = meetup.data.gallery ?? [];
const linkRecording = meetup.data.linkRecording;
const linkPhotos = meetup.data.linkPhotos;
const youtubeId = linkRecording ? extractYouTubeId(linkRecording) : null;
const talkRecording = talks.find((t) => t.data.recording?.url)?.data.recording;
const recordingUrl = linkRecording || talkRecording?.url;
const recordingYoutubeId =
  youtubeId || (recordingUrl ? extractYouTubeId(recordingUrl) : null);

// A meetup's Spanish body lives on the entry; its English body lives in a
// `{slug}.en.md` sibling. Falling back to Spanish is allowed, but it must be
// labeled — a silent fallback is the defect this replaces.
const { entry: bodyEntry, untranslated } = await getMeetupBodyEntry(
  meetup,
  lang
);
const { Content } = await render(bodyEntry);

const breadcrumbs = [
  {
    label: md.breadcrumbHome,
    href: prefix === '' ? '/' : `${prefix}/`,
  },
  { label: md.breadcrumbMeetups, href: `${prefix}/meetups/` },
  { label: title },
];

const statusLabels: Record<string, string> = {
  announced: md.statusAnnounced,
  'rsvp-open': md.statusRsvpOpen,
  completed: md.statusCompleted,
  cancelled: md.statusCancelled,
};
const statusVariant = (
  status === 'announced' || status === 'rsvp-open'
    ? 'announced'
    : status === 'cancelled'
      ? 'cancelled'
      : 'completed'
) as 'announced' | 'cancelled' | 'completed';

const meetupComLink = (meetup.data as { linkMeetupCom?: string }).linkMeetupCom;
const eventPlatformLabel = meetupComLink?.includes('luma.com')
  ? 'Luma'
  : 'Meetup.com';

const eventJsonLd: Record<string, unknown> = {
  '@context': 'https://schema.org',
  '@type': 'Event',
  name: title,
  description: description || tr(meetup.data.title, lang),
  startDate: date.toISOString(),
  eventStatus:
    status === 'cancelled'
      ? 'https://schema.org/EventCancelled'
      : 'https://schema.org/EventScheduled',
  eventAttendanceMode: 'https://schema.org/OfflineEventAttendanceMode',
  url: `${SITE_URL}${prefix}/meetups/${slug}/`,
  organizer: {
    '@type': 'Organization',
    name: 'Pereira Tech Talks',
    url: SITE_URL,
  },
};
if (heroSrc) eventJsonLd.image = `${SITE_URL}${heroSrc}`;
// Never invent a place. A programmed meetup with no room booked emits no
// `location` at all rather than an empty Place. The Event itself is always
// emitted — scripts/audit-seo.mjs requires it on every meetups/* URL, and a
// month-only meetup publishes the month's cadence date, corrected on the next
// build once the day is confirmed. See DESIGN_DECISIONS.md D9.
if (venue) {
  eventJsonLd.location = {
    '@type': 'Place',
    name: venue.name,
    address: {
      '@type': 'PostalAddress',
      addressLocality: venue.city,
      addressCountry: venue.country,
    },
  };
}
if (speakers.length > 0) {
  eventJsonLd.performer = speakers.map((s) => ({
    '@type': 'Person',
    name: s.data.name,
    url: `${SITE_URL}${prefix}/speakers/${s.id}/`,
  }));
}
/**
 * Archive stubs carry a two-line note and recent meetups a full abstract, so
 * the authored description sits on both sides of the 130-160 band. Composed
 * from the night's own facts, then trimmed at a word boundary.
 */
const metaPhrase = metaPhrases(lang);
const metaDescription = buildMetaDescription({
  lead: description,
  // Ordered shortest-first: a long lead can still reach the band on a compact
  // clause, where a long one would be skipped for overshooting.
  clauses: [
    talks.length > 0 ? metaPhrase.talkCount(talks.length) : null,
    metaPhrase.meetupContext(
      dateLabel,
      [venue?.name, venue?.city].filter(Boolean).join(', ')
    ),
    metaPhrase.community,
  ],
  lang,
});
---

<MainLayout
  lang={lang}
  title={title}
  description={metaDescription}
  image={heroSrc}
>
  <JsonLd data={eventJsonLd} />
  <article class="bg-ptt-bg">
    {/* Hero */}
    <header class="relative overflow-hidden bg-gradient-to-br from-ptt-bg-dark to-ptt-bg-dark/90">
      {
        heroSrc && !bannerHeroSrc && (
          <div class="absolute inset-0 opacity-30">
            <img
              src={heroSrc}
              alt=""
              width="1920"
              height="540"
              class="h-full w-full object-cover"
            />
          </div>
        )
      }
      <div class="relative main-container py-16 sm:py-20 text-white">
        <Breadcrumbs items={breadcrumbs} baseUrl={SITE_URL} onDark />
        <div class="mt-6 flex flex-wrap items-center gap-3">
          <Badge variant={statusVariant}>{statusLabels[status]}</Badge>
          <time
            datetime={dateAttribute}
            class="text-sm font-semibold uppercase tracking-widest text-ptt-accent dark:text-ptt-accent-dark"
          >
            {dateLabel}
          </time>
          {
            dateConfidence === 'tentative' && (
              <span
                class="inline-flex items-center rounded-full bg-white/15 px-2.5 py-1 text-xs font-semibold text-white ring-1 ring-white/25"
                title={planning.chipTentativeAria}
              >
                {planning.chipTentative}
              </span>
            )
          }
          {
            dateConfidence === 'month-only' && (
              <span
                class="inline-flex items-center rounded-full bg-white/15 px-2.5 py-1 text-xs font-semibold text-white ring-1 ring-white/25"
                title={planning.chipMonthOnlyAria}
              >
                {planning.chipMonthOnly}
              </span>
            )
          }
        </div>
        <h1 class="mt-3 text-3xl sm:text-5xl font-bold tracking-tight">
          {title}
        </h1>
        {description && (
          <p class="mt-4 max-w-3xl text-lg text-white/85">{description}</p>
        )}
        {
          !venue && (
            <p class="mt-6 inline-flex items-center gap-2 text-sm text-white/85">
              <svg
                aria-hidden="true"
                class="h-4 w-4"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                viewBox="0 0 24 24"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"
                />
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"
                />
              </svg>
              <span>{planning.venueTbc}</span>
            </p>
          )
        }
        {
          callState === 'open' && (
            <p class="mt-8">
              <a
                href="#call-for-speakers"
                data-umami-event="cfs_open_call_click"
                data-umami-event-meetup-slug={slug}
                data-umami-event-source="detail_hero"
                class="inline-flex min-h-[44px] items-center gap-2 rounded-full bg-ptt-accent px-6 py-3 text-base font-semibold text-ptt-bg-dark shadow-sm transition-colors hover:bg-ptt-accent/90 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-ptt-accent"
              >
                {planning.heroCta}
              </a>
            </p>
          )
        }
        {
          venue && (
            <p class="mt-6 inline-flex items-center gap-2 text-sm text-white/85">
              <svg
                aria-hidden="true"
                class="h-4 w-4"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                viewBox="0 0 24 24"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"
                />
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"
                />
              </svg>
              <span>
                {[venue.name, venue.city, venue.country]
                  .filter(Boolean)
                  .join(', ')}
              </span>
            </p>
          )
        }
      </div>
    </header>

    {
      !heroSrc && (
        <div class="main-container py-8 sm:py-10">
          <div class="overflow-hidden rounded-2xl ring-1 ring-ptt-border">
            <MeetupDateTile
              date={date}
              dateConfidence={dateConfidence}
              lang={lang}
              label={planning.dateTileAria.replace('{date}', dateLabel)}
              ratio="21/9"
            />
          </div>
        </div>
      )
    }

    {
      bannerHeroSrc && (
        <div class="main-container py-8 sm:py-10">
          <div class="overflow-hidden rounded-2xl ring-1 ring-ptt-border">
            <BlogHeroImage
              src={bannerHeroSrc}
              alt={heroAlt}
              width={1200}
              height={675}
              class="block h-auto w-full object-cover"
              loading="eager"
            />
          </div>
        </div>
      )
    }

    <div class="main-container py-12 sm:py-16 grid gap-12 lg:grid-cols-[1fr_280px]">
      {/* Body */}
      <div class="prose prose-lg dark:prose-invert max-w-none prose-headings:tracking-tight prose-a:text-ptt-primary dark:prose-a:text-ptt-primary-dark prose-img:rounded-xl">
        {
          untranslated && (
            <p
              class="not-prose mb-8 flex items-start gap-2.5 rounded-xl border border-ptt-border bg-ptt-bg-elevated px-4 py-3 text-sm text-ptt-secondary"
              lang="en"
            >
              <svg
                class="mt-0.5 h-4 w-4 shrink-0 text-ptt-primary dark:text-ptt-primary-dark"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
              >
                <circle cx="12" cy="12" r="10" />
                <path d="M2 12h20M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z" />
              </svg>
              <span>{md.untranslatedBody}</span>
            </p>
          )
        }
        <div lang={untranslated ? 'es' : lang}>
          <Content />
        </div>
      </div>

      {/* Sidebar */}
      <aside class="space-y-8 lg:sticky lg:top-24 lg:self-start">
        {
          meetupComLink && (
            <div>
              <h3 class="text-sm font-semibold uppercase tracking-widest text-ptt-primary dark:text-ptt-primary-dark mb-2">
                {md.originalEvent}
              </h3>
              <a
                href={meetupComLink}
                target="_blank"
                rel="noopener noreferrer"
                class="inline-flex items-center gap-2 text-sm font-medium text-ptt hover:text-ptt-primary dark:hover:text-ptt-primary-dark"
              >
                {eventPlatformLabel}
                <svg aria-hidden="true" class="h-3.5 w-3.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M14 5l7 7m0 0l-7 7m7-7H3" />
                </svg>
              </a>
            </div>
          )
        }
        <div>
          <h3 class="text-sm font-semibold uppercase tracking-widest text-ptt-primary dark:text-ptt-primary-dark mb-2">
            {md.venue}
          </h3>
          {
            venue ? (
              <>
                <p class="text-sm text-ptt-secondary font-medium">{venue.name}</p>
                <p class="text-sm text-ptt-secondary">
                  {venue.city}, {venue.country}
                </p>
              </>
            ) : (
              <p class="text-sm text-ptt-secondary">{planning.venueTbc}</p>
            )
          }
        </div>
        {
          recordingUrl && !recordingYoutubeId && (
            <div>
              <h3 class="text-sm font-semibold uppercase tracking-widest text-ptt-primary dark:text-ptt-primary-dark mb-2">
                {md.recording}
              </h3>
              <a
                href={recordingUrl}
                target="_blank"
                rel="noopener noreferrer"
                class="inline-flex items-center gap-2 text-sm font-medium text-ptt hover:text-ptt-primary dark:hover:text-ptt-primary-dark"
              >
                {md.watchRecording}
              </a>
            </div>
          )
        }
        {
          linkPhotos && (
            <div>
              <h3 class="text-sm font-semibold uppercase tracking-widest text-ptt-primary dark:text-ptt-primary-dark mb-2">
                {md.photosExternal}
              </h3>
              <a
                href={linkPhotos}
                target="_blank"
                rel="noopener noreferrer"
                class="inline-flex items-center gap-2 text-sm font-medium text-ptt hover:text-ptt-primary dark:hover:text-ptt-primary-dark"
              >
                {md.photosExternal}
              </a>
            </div>
          )
        }
      </aside>
    </div>

    {
      recordingYoutubeId && (
        <section class="main-container pb-12 sm:pb-16">
          <div class="mb-4 flex flex-wrap items-end justify-between gap-2">
            <h2 class="text-2xl font-bold tracking-tight text-ptt">
              {md.recording}
            </h2>
            <p class="text-sm font-medium text-ptt-secondary">
              {md.watchRecording}
            </p>
          </div>
          <div
            class="youtube-facade group relative aspect-video w-full overflow-hidden rounded-2xl bg-ptt-bg-dark ring-1 ring-ptt-border shadow-sm"
            data-youtube-id={recordingYoutubeId}
            data-title={title}
          >
            <img
              src={
                heroSrc ||
                `https://i.ytimg.com/vi/${recordingYoutubeId}/hqdefault.jpg`
              }
              alt=""
              width="1280"
              height="720"
              class="absolute inset-0 h-full w-full object-cover"
              loading="lazy"
            />
            <button
              type="button"
              class="absolute inset-0 flex flex-col items-center justify-center gap-3 bg-black/40 text-white transition hover:bg-black/50 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[#FF0000]"
              aria-label={md.watchRecording}
            >
              {/* YouTube-style red play control — reads clearly as a video player. */}
              <span
                class="inline-flex h-[4.25rem] w-[6rem] items-center justify-center rounded-[1.15rem] bg-[#FF0000] text-white shadow-[0_8px_28px_rgba(0,0,0,0.45)] transition group-hover:scale-105 group-hover:bg-[#E00000] sm:h-[4.75rem] sm:w-[7.25rem]"
              >
                <svg
                  aria-hidden="true"
                  class="h-9 w-9 translate-x-0.5 sm:h-10 sm:w-10"
                  fill="currentColor"
                  viewBox="0 0 24 24"
                >
                  <path d="M8 5v14l11-7z"></path>
                </svg>
              </span>
              <span
                class="rounded-full bg-black/55 px-3 py-1 text-xs font-semibold uppercase tracking-wide text-white backdrop-blur-sm sm:text-sm"
              >
                YouTube · {md.watchRecording}
              </span>
            </button>
          </div>
        </section>
      )
    }

    {
      /*
        A meetup whose programme is not announced yet says so, rather than
        rendering an empty "Charlas" heading. `partial` means speakers are
        confirmed but their talk entries are not authored — the Speakers
        section below still renders.
      */
      talks.length === 0 && status !== 'completed' && (
        <section class="main-container pb-12 sm:pb-16">
          <div class="rounded-2xl bg-ptt-bg-elevated p-6 ring-1 ring-ptt-border sm:p-8">
            <h2 class="text-xl font-bold tracking-tight text-ptt">
              {planning.lineupOpenTitle}
            </h2>
            <p class="mt-2 max-w-2xl text-ptt-secondary">
              {lineup === 'partial'
                ? planning.lineupPartialBody
                : planning.lineupOpenBody}
            </p>
            {callState === 'open' && (
              <a
                href="#call-for-speakers"
                data-umami-event="cfs_open_call_click"
                data-umami-event-meetup-slug={slug}
                data-umami-event-source="detail_lineup"
                class="mt-5 inline-flex min-h-[44px] items-center gap-2 rounded-full bg-ptt-primary px-6 py-3 text-base font-semibold text-white transition-colors hover:bg-ptt-primary/90 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-ptt-primary"
              >
                {planning.heroCta}
              </a>
            )}
          </div>
        </section>
      )
    }

    {
      talks.length > 0 && (
        <section class="bg-ptt-primary-soft/40 dark:bg-ptt-bg-elevated py-16 sm:py-20">
          <div class="main-container">
            <h2 class="text-3xl font-bold tracking-tight text-ptt">
              {md.talks}
            </h2>
            <ul class="mt-8 grid gap-6 sm:grid-cols-2">
              {talks.map((talk) => (
                <li>
                  <TalkCard
                    talk={talk}
                    lang={lang}
                    speakerNames={talk.data.speakers
                      .map((s) => speakerNameBySlug.get(s) ?? s)
                      .filter(Boolean)}
                  />
                </li>
              ))}
            </ul>
          </div>
        </section>
      )
    }

    {
      speakers.length > 0 && (
        <section class="py-16 sm:py-20">
          <div class="main-container">
            <h2 class="text-3xl font-bold tracking-tight text-ptt">
              {md.speakers}
            </h2>
            <ul class="mt-8 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
              {speakers.map((speaker) => (
                <li>
                  <SpeakerCard speaker={speaker} lang={lang} />
                </li>
              ))}
            </ul>
          </div>
        </section>
      )
    }

    {
      editionSponsors.length > 0 && (
        <section class="bg-ptt-primary-soft/40 dark:bg-ptt-bg-elevated py-16 sm:py-20">
          <div class="main-container">
            <h2 class="text-3xl font-bold tracking-tight text-ptt">
              {md.sponsors}
            </h2>
            <p class="mt-2 text-ptt-secondary">{md.sponsorsSubtitle}</p>
            <ul class="mt-8 grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
              {editionSponsors.map(({ sponsor, tier }) => (
                <li>
                  <SponsorCard
                    sponsor={sponsor}
                    lang={lang}
                    tier={tier}
                    showTier={false}
                    muted
                  />
                </li>
              ))}
            </ul>
          </div>
        </section>
      )
    }

    {
      gallery.length > 0 && (
        <section class="py-16 sm:py-20">
          <div class="main-container">
            <PtdGalleryCarousel
              client:visible
              lang={lang}
              title={md.galleryMemories}
              images={gallery}
            />
          </div>
        </section>
      )
    }
    <CallForSpeakersPanel meetup={meetup} lang={lang} title={title} />
  </article>
</MainLayout>

<script>
  function activateFacade(facade: Element): void {
    const videoId = facade.getAttribute('data-youtube-id');
    const title = facade.getAttribute('data-title') || 'YouTube video';
    if (!videoId) return;
    const iframe = document.createElement('iframe');
    iframe.src = `https://www.youtube-nocookie.com/embed/${videoId}?autoplay=1&rel=0`;
    iframe.title = title;
    iframe.allow =
      'accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share';
    iframe.allowFullscreen = true;
    iframe.className = 'absolute inset-0 h-full w-full';
    facade.replaceChildren(iframe);
  }

  document.querySelectorAll('.youtube-facade').forEach((facade) => {
    const button = facade.querySelector('button');
    if (!button) return;
    button.addEventListener('click', () => activateFacade(facade), {
      once: true,
    });
  });
</script>
