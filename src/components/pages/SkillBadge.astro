---
interface Props {
  label: string;
  variant?: 'primary' | 'secondary' | 'neutral';
}

const { label, variant = 'neutral' } = Astro.props;

const variantClasses: Record<string, string> = {
  primary: 'bg-ptt-primary text-white hover:bg-ptt-primary-strong',
  secondary:
    'bg-ptt-primary-soft text-ptt-primary hover:bg-ptt-primary-soft/70',
  neutral: 'bg-ptt-bg-elevated text-ptt-secondary hover:bg-ptt-primary-soft',
};
---

<span class={`inline-block px-3 py-1.5 rounded-full text-sm font-medium transition-colors duration-200 ${variantClasses[variant]}`}>
  {label}
</span>
