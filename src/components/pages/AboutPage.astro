---
import JsonLd from '@/components/JsonLd.astro';
import HighlightCard from '@/components/pages/HighlightCard.astro';
import PageHero from '@/components/pages/PageHero.astro';
import PageSection from '@/components/pages/PageSection.astro';
import MainLayout from '@/layouts/MainLayout.astro';
import type { Language } from '@/lib/i18n';
import { getUrlPrefix } from '@/lib/i18n';
import { getTranslations } from '@/lib/translations';

interface Props {
  lang: Language;
}

const { lang } = Astro.props;
const t = getTranslations(lang);
const prefix = getUrlPrefix(lang);
const contactCtaHref = `${prefix}/contact?${new URLSearchParams({
  topic: 'collaboration',
  subject: t.contactPage.prefillSubjects.collaboration,
}).toString()}`;

const siteUrl = Astro.site?.href?.replace(/\/$/, '') ?? '';

const organizationData = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: 'Pereira Tech Talks',
  alternateName: 'PTT',
  url: Astro.site?.href,
  logo: new URL('/images/brand/logo-horizontal-color.svg', Astro.site).href,
  description:
    'Bilingual technology community of builders, speakers, and learners shaping the future of technology from Pereira, Risaralda, Colombia to the world.',
  foundingDate: '2014-02-27',
  foundingLocation: {
    '@type': 'Place',
    address: {
      '@type': 'PostalAddress',
      addressLocality: 'Pereira',
      addressRegion: 'Risaralda',
      addressCountry: 'CO',
    },
  },
  knowsLanguage: ['es', 'en'],
  knowsAbout: [
    'Software Engineering',
    'Artificial Intelligence',
    'Web Development',
    'DevOps',
    'Public Speaking',
    'Tech Community Building',
  ],
  sameAs: [
    'https://github.com/pereiratechtalks',
    'https://www.linkedin.com/company/pereira-tech-talks/',
    'https://x.com/pereiratechtalks',
    'https://www.instagram.com/pereiratechtalks',
  ],
};

const aboutPageData = {
  '@context': 'https://schema.org',
  '@type': 'AboutPage',
  mainEntity: { '@id': Astro.site?.href },
  dateCreated: '2014-02-27',
  dateModified: new Date().toISOString().split('T')[0],
};

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    {
      '@type': 'ListItem',
      position: 1,
      name: 'Home',
      item: `${siteUrl}${prefix}/`,
    },
    {
      '@type': 'ListItem',
      position: 2,
      name: t.aboutPage.title,
      item: `${siteUrl}${prefix}/about`,
    },
  ],
};
---

<MainLayout
  lang={lang}
  title={t.aboutPage.title}
  description={t.aboutPage.description}
  keywords={lang === 'en'
    ? ['about Pereira Tech Talks', 'PTT community', 'tech community Pereira', 'Risaralda tech ecosystem', 'bilingual tech community Colombia', 'Pereira Tech Day organizers']
    : ['sobre Pereira Tech Talks', 'comunidad PTT', 'comunidad tecnología Pereira', 'ecosistema tecnología Risaralda', 'comunidad tecnología bilingüe Colombia', 'organizadores Pereira Tech Day']}
>
  <Fragment slot="head">
    <JsonLd data={organizationData} />
    <JsonLd data={aboutPageData} />
    <JsonLd data={breadcrumbSchema} />
  </Fragment>

  <PageHero
    title={t.aboutPage.title}
    subtitle={t.aboutPage.subtitle}
    description={t.aboutPage.heroDescription}
    image="/images/profile.png"
  />

  <PageSection background="white" title={t.aboutPage.bioTitle} description={t.aboutPage.bioText} />

  <PageSection background="gray" title={t.aboutPage.passionsTitle}>
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      {t.aboutPage.passions.map((passion) => (
        <HighlightCard
          title={passion.title}
          description={passion.description}
          icon={passion.icon}
          link={passion.link}
        />
      ))}
    </div>
  </PageSection>

  <PageSection background="white" title={t.aboutPage.quickFactsTitle}>
    <ul class="space-y-3 max-w-2xl">
      {t.aboutPage.quickFacts.map((fact) => (
        <li class="flex items-start gap-3 text-gray-700 dark:text-gray-300">
          <span class="text-secondary mt-0.5 flex-shrink-0">&#10003;</span>
          <span>{fact}</span>
        </li>
      ))}
    </ul>
  </PageSection>

  <PageSection
    background="gray"
    title={t.aboutPage.ctaTitle}
    description={t.aboutPage.ctaDescription}
  >
    <div class="flex flex-wrap gap-4 mt-4">
      <a
        href={`${prefix}/blog`}
        class="inline-flex items-center px-6 py-3 rounded-lg bg-secondary text-white font-semibold hover:bg-secondary/90 transition-colors duration-200"
      >
        {t.aboutPage.ctaCv}
      </a>
      <a
        href={contactCtaHref}
        class="inline-flex items-center px-6 py-3 rounded-lg border-2 border-secondary text-secondary dark:text-secondary font-semibold hover:bg-secondary/10 transition-colors duration-200"
      >
        {t.aboutPage.ctaContact}
      </a>
    </div>
  </PageSection>
</MainLayout>
