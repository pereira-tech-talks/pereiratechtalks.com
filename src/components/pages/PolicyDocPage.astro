---
/**
 * Long-form policy / community document page with optional table of contents.
 * Used for conduct, governance, contributing, and community markdown pages.
 */

import { getEntry, render } from 'astro:content';

import ConductReportForm from '@/components/contact/ConductReportForm.svelte';
import Breadcrumbs from '@/components/ui/Breadcrumbs.astro';
import DocTableOfContents from '@/components/ui/DocTableOfContents.svelte';
import Eyebrow from '@/components/ui/Eyebrow.astro';
import MainLayout from '@/layouts/MainLayout.astro';
import { CONTACT_FORM } from '@/lib/constances';
import { formatCalendarDate, getCalendarDateString } from '@/lib/dates';
import { getUrlPrefix, type Language } from '@/lib/i18n';
import { getTranslations } from '@/lib/translations';

interface Props {
  lang: Language;
  slug: string;
  eyebrow?: string;
  showToc?: boolean;
}

const { lang, slug, eyebrow, showToc = true } = Astro.props;
const t = getTranslations(lang);
const isConduct = slug === 'conduct';

const entry = await getEntry('pages', `${lang}/${slug}`);
if (!entry) {
  throw new Error(`Missing pages collection entry: ${lang}/${slug}`);
}

const { Content, headings } = await render(entry);
const { title, description, lastUpdated } = entry.data;

const tocHeadings = headings
  .filter((h) => h.depth === 2)
  .map((h) => ({ id: h.slug, text: h.text }));

const lastUpdatedLabel = lastUpdated
  ? formatCalendarDate(lastUpdated, lang)
  : null;
const lastUpdatedDatetime = lastUpdated
  ? getCalendarDateString(lastUpdated)
  : null;

const breadcrumbs = [
  {
    label: lang === 'es' ? 'Inicio' : 'Home',
    href: `${getUrlPrefix(lang)}/`,
  },
  { label: title },
];

const lastUpdatedPrefix = lang === 'es' ? 'Actualizado el' : 'Last updated';
const tocLabel = lang === 'es' ? 'En esta página' : 'On this page';
---

<MainLayout lang={lang} title={title} description={description}>
  <div class="bg-ptt-bg">
    <div class="main-container pt-12 sm:pt-16 pb-4">
      <Breadcrumbs items={breadcrumbs} />
    </div>
    <div class="main-container pt-6 pb-10">
      {eyebrow && <Eyebrow>{eyebrow}</Eyebrow>}
      <h1 class="mt-3 text-4xl sm:text-5xl font-bold tracking-tight text-ptt">
        {title}
      </h1>
      <p class="mt-4 max-w-3xl text-lg text-ptt-secondary">{description}</p>
      {
        lastUpdatedLabel && (
          <p class="mt-3 text-sm text-ptt-secondary">
            {lastUpdatedPrefix}{' '}
            <time datetime={lastUpdatedDatetime}>{lastUpdatedLabel}</time>
          </p>
        )
      }
    </div>
  </div>

  <div class="bg-ptt-bg pb-16 sm:pb-24">
    <div class="main-container">
      <div class="lg:grid lg:grid-cols-[minmax(0,1fr)_220px] lg:gap-12 xl:grid-cols-[minmax(0,1fr)_260px]">
        <article
          class="policy-doc prose prose-lg dark:prose-invert max-w-3xl prose-headings:scroll-mt-24 prose-a:text-ptt-primary dark:prose-a:text-ptt-primary-dark prose-headings:text-ptt prose-p:text-ptt-secondary prose-strong:text-ptt prose-li:text-ptt-secondary prose-hr:border-ptt-border min-w-0"
        >
          <Content />
        </article>
        {
          showToc && tocHeadings.length > 0 && (
            <aside class="hidden lg:block">
              <DocTableOfContents
                client:visible
                headings={tocHeadings}
                label={tocLabel}
              />
            </aside>
          )
        }
      </div>

      {
        isConduct && (
          <section
            id="conduct-report-form"
            class="mt-16 sm:mt-20 max-w-2xl"
            aria-labelledby="conduct-report-form-title"
          >
            <Eyebrow class="mb-3">{t.conductForm.formEyebrow}</Eyebrow>
            <h2
              id="conduct-report-form-title"
              class="text-3xl font-bold tracking-tight text-ptt"
            >
              {t.conductForm.formSectionTitle}
            </h2>
            <div class="mt-8">
              <ConductReportForm
                client:visible
                lang={lang}
                apiEndpoint={CONTACT_FORM.apiEndpoint}
              />
            </div>
          </section>
        )
      }
    </div>
  </div>
</MainLayout>

<style>
  .policy-doc :global(hr) {
    margin-block: 2.5rem;
    border-color: var(--color-ptt-border);
  }
</style>
