---
/**
 * PTT v3.0.0 single Pereira Tech Day edition detail page.
 *
 * Applies per-edition theming via `[data-edition-theme="{year}"]` scope and
 * inline CSS generated by `buildEditionThemeCss`. Renders schedule, sponsors,
 * keynotes, gallery, and the markdown body.
 */

import type { CollectionEntry } from 'astro:content';
import { render } from 'astro:content';
import SpeakerCard from '@/components/cards/SpeakerCard.astro';
import TalkCard from '@/components/cards/TalkCard.astro';
import JsonLd from '@/components/JsonLd.astro';
import Badge from '@/components/ui/Badge.astro';
import Breadcrumbs from '@/components/ui/Breadcrumbs.astro';
import MainLayout from '@/layouts/MainLayout.astro';
import { getUrlPrefix, type Language, tr } from '@/lib/i18n';
import { buildEditionThemeCss } from '@/lib/pereiraTechDay';
import { getSpeakersBySlugs } from '@/lib/speaker';
import { getTalksByEvent } from '@/lib/talk';

interface Props {
  edition: CollectionEntry<'pereiraTechDays'>;
  lang: Language;
}

const { edition, lang } = Astro.props;

const prefix = getUrlPrefix(lang);
const year = edition.data.year;
const title = tr(edition.data.title, lang);
const tagline = tr(edition.data.tagline, lang);
const description = tr(edition.data.description, lang);
const heroSrc = edition.data.hero.src;

const dateRaw = edition.data.date;
const startDate =
  typeof dateRaw === 'object' && 'start' in dateRaw ? dateRaw.start : dateRaw;
const endDate =
  typeof dateRaw === 'object' && 'end' in dateRaw ? dateRaw.end : null;
const dateFormatter = new Intl.DateTimeFormat(
  lang === 'es' ? 'es-CO' : 'en-US',
  {
    year: 'numeric',
    month: 'long',
    day: 'numeric',
  }
);
const dateLabel = endDate
  ? `${dateFormatter.format(new Date(startDate))} – ${dateFormatter.format(new Date(endDate))}`
  : dateFormatter.format(new Date(startDate));

const venue = edition.data.venue;
const status = edition.data.status;
const themeCss = buildEditionThemeCss(edition);

const talks = await getTalksByEvent('pereiraTechDays', edition.id);
const speakers = await getSpeakersBySlugs([
  ...(edition.data.keynotes ?? []),
  ...talks.flatMap((t) => t.data.speakers),
]);
const speakerNameById = new Map(speakers.map((s) => [s.id, s.data.name]));

const { Content } = await render(edition);

const breadcrumbs = [
  {
    label: lang === 'es' ? 'Inicio' : 'Home',
    href: prefix === '' ? '/' : `${prefix}/`,
  },
  {
    label: 'Pereira Tech Days',
    href: `${prefix}/pereira-tech-days/`,
  },
  { label: `${year}` },
];

const statusLabels: Record<string, { en: string; es: string }> = {
  announced: { en: 'Upcoming', es: 'Próximamente' },
  'rsvp-open': { en: 'RSVP open', es: 'RSVP abierto' },
  completed: { en: 'Past edition', es: 'Edición pasada' },
  cancelled: { en: 'Cancelled', es: 'Cancelada' },
};
const statusVariant = (
  status === 'announced' || status === 'rsvp-open'
    ? 'announced'
    : status === 'cancelled'
      ? 'cancelled'
      : 'completed'
) as 'announced' | 'cancelled' | 'completed';

const scheduleTypeLabels: Record<string, { en: string; es: string }> = {
  talk: { en: 'Talk', es: 'Charla' },
  keynote: { en: 'Keynote', es: 'Keynote' },
  lightning: { en: 'Lightning', es: 'Relámpago' },
  panel: { en: 'Panel', es: 'Panel' },
  break: { en: 'Break', es: 'Pausa' },
  'open-doors': { en: 'Doors open', es: 'Apertura de puertas' },
  closing: { en: 'Closing', es: 'Cierre' },
};

const SITE_URL = 'https://pereiratechtalks.org';
const eventJsonLd: Record<string, unknown> = {
  '@context': 'https://schema.org',
  '@type': 'Event',
  name: title,
  description: description || tagline,
  startDate: new Date(startDate).toISOString(),
  endDate: endDate ? new Date(endDate).toISOString() : undefined,
  eventStatus:
    status === 'cancelled'
      ? 'https://schema.org/EventCancelled'
      : 'https://schema.org/EventScheduled',
  eventAttendanceMode:
    edition.data.mode === 'virtual'
      ? 'https://schema.org/OnlineEventAttendanceMode'
      : edition.data.mode === 'hybrid'
        ? 'https://schema.org/MixedEventAttendanceMode'
        : 'https://schema.org/OfflineEventAttendanceMode',
  url: `${SITE_URL}${prefix}/pereira-tech-days/${year}/`,
  image: heroSrc?.startsWith('http') ? heroSrc : `${SITE_URL}${heroSrc}`,
  organizer: {
    '@type': 'Organization',
    name: 'Pereira Tech Talks',
    url: SITE_URL,
  },
  location: {
    '@type': 'Place',
    name: venue.name,
    address: {
      '@type': 'PostalAddress',
      addressLocality: venue.city,
      addressCountry: venue.country,
    },
  },
};
if (speakers.length > 0) {
  eventJsonLd.performer = speakers.map((s) => ({
    '@type': 'Person',
    name: s.data.name,
    url: `${SITE_URL}${prefix}/speakers/${s.id}/`,
  }));
}
---

<MainLayout lang={lang} title={`${title} (${year})`} description={tagline} image={heroSrc}>
  <JsonLd data={eventJsonLd} />
  <style is:inline set:html={themeCss}></style>
  <div data-edition-theme={year} class="bg-white dark:bg-gray-950">
    {/* Hero */}
    <header class="relative overflow-hidden bg-[var(--ptt-bg)] text-[var(--ptt-text)]">
      <div class="absolute inset-0 opacity-25">
        <img
          src={heroSrc}
          alt=""
          width="1920"
          height="640"
          class="h-full w-full object-cover"
        />
      </div>
      <div class="relative max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 py-16 sm:py-24">
        <Breadcrumbs items={breadcrumbs} baseUrl="https://pereiratechtalks.org" onDark />
        <div class="mt-6 flex items-center gap-3 text-sm">
          <Badge variant={statusVariant}>{statusLabels[status][lang]}</Badge>
          <time
            datetime={new Date(startDate).toISOString()}
            class="font-semibold uppercase tracking-widest"
            style="color: var(--ptt-accent)"
          >
            {dateLabel}
          </time>
        </div>
        <p
          class="mt-2 text-sm font-semibold uppercase tracking-[0.3em]"
          style="color: var(--ptt-accent)"
        >
          Pereira Tech Day · {year}
        </p>
        <h1 class="mt-3 text-4xl sm:text-6xl font-bold tracking-tight">
          {title}
        </h1>
        <p class="mt-4 max-w-3xl text-lg opacity-90">{tagline}</p>
        {
          venue && (
            <p class="mt-6 text-sm opacity-80">
              {[venue.name, venue.city, venue.country].filter(Boolean).join(', ')}
            </p>
          )
        }
      </div>
    </header>

    {/* Description */}
    {
      description && (
        <section class="bg-[var(--ptt-bg-elevated)] py-12 sm:py-16">
          <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8">
            <p class="text-lg leading-relaxed text-[var(--ptt-text)]">
              {description}
            </p>
          </div>
        </section>
      )
    }

    {/* Body markdown */}
    <section class="py-12 sm:py-16">
      <div class="prose prose-lg dark:prose-invert max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 prose-headings:tracking-tight prose-a:text-[var(--ptt-primary)]">
        <Content />
      </div>
    </section>

    {/* Schedule */}
    {
      edition.data.schedule.length > 0 && (
        <section class="bg-gray-50 dark:bg-gray-900/50 py-16 sm:py-20">
          <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
            <h2 class="text-3xl font-bold tracking-tight text-gray-900 dark:text-gray-50 mb-8">
              {lang === 'es' ? 'Programa' : 'Schedule'}
            </h2>
            <ol class="space-y-3">
              {edition.data.schedule.map((slot) => (
                <li class="flex items-start gap-4 rounded-xl bg-white dark:bg-gray-900 p-4 ring-1 ring-gray-200 dark:ring-gray-800">
                  <time class="shrink-0 font-mono text-sm font-semibold text-[var(--ptt-primary)] dark:text-[var(--ptt-primary)] w-16">
                    {slot.time}
                  </time>
                  <div class="flex-1">
                    <p class="text-xs font-semibold uppercase tracking-widest text-gray-600 dark:text-gray-300">
                      {scheduleTypeLabels[slot.type]?.[lang] ?? slot.type}
                    </p>
                    <p class="mt-0.5 text-base font-medium text-gray-900 dark:text-gray-50">
                      {slot.title ? tr(slot.title, lang) : slot.talkSlug}
                    </p>
                  </div>
                </li>
              ))}
            </ol>
          </div>
        </section>
      )
    }

    {/* Talks */}
    {
      talks.length > 0 && (
        <section class="py-16 sm:py-20">
          <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
            <h2 class="text-3xl font-bold tracking-tight text-gray-900 dark:text-gray-50">
              {lang === 'es' ? 'Charlas' : 'Talks'}
            </h2>
            <ul class="mt-8 grid gap-6 sm:grid-cols-2">
              {talks.map((talk) => (
                <li>
                  <TalkCard
                    talk={talk}
                    lang={lang}
                    speakerNames={talk.data.speakers
                      .map((s) => speakerNameById.get(s) ?? s)
                      .filter(Boolean)}
                  />
                </li>
              ))}
            </ul>
          </div>
        </section>
      )
    }

    {/* Speakers */}
    {
      speakers.length > 0 && (
        <section class="bg-gray-50 dark:bg-gray-900/50 py-16 sm:py-20">
          <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
            <h2 class="text-3xl font-bold tracking-tight text-gray-900 dark:text-gray-50">
              {lang === 'es' ? 'Ponentes' : 'Speakers'}
            </h2>
            <ul class="mt-8 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
              {speakers.map((speaker) => (
                <li>
                  <SpeakerCard speaker={speaker} lang={lang} />
                </li>
              ))}
            </ul>
          </div>
        </section>
      )
    }

    {/* Gallery */}
    {
      edition.data.gallery.length > 0 && (
        <section class="py-16 sm:py-20">
          <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
            <h2 class="text-3xl font-bold tracking-tight text-gray-900 dark:text-gray-50 mb-8">
              {lang === 'es' ? 'Galería' : 'Gallery'}
            </h2>
            <ul class="grid gap-3 grid-cols-2 sm:grid-cols-3 lg:grid-cols-4">
              {edition.data.gallery.map((img) => (
                <li class="overflow-hidden rounded-xl ring-1 ring-gray-200 dark:ring-gray-800 aspect-square bg-gray-100 dark:bg-gray-800">
                  <img
                    src={img.src}
                    alt={tr(img.alt, lang) || `${title} memory`}
                    width="320"
                    height="320"
                    loading="lazy"
                    class="h-full w-full object-cover transition-transform hover:scale-105"
                  />
                </li>
              ))}
            </ul>
          </div>
        </section>
      )
    }
  </div>
</MainLayout>
