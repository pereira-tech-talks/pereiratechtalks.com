---
/**
 * PTT v3.0.0 meetups timeline page (shared between EN and ES).
 *
 * Full archive + sticky year jump rail (see MEETUPS_NAV_DECISION.md).
 */

import MeetupShowcaseCard from '@/components/cards/MeetupShowcaseCard.astro';
import PtdAnnouncementStrip from '@/components/home/PtdAnnouncementStrip.astro';
import MeetupYearRail from '@/components/meetups/MeetupYearRail.svelte';
import UpcomingProgrammingRail from '@/components/meetups/UpcomingProgrammingRail.astro';
import Breadcrumbs from '@/components/ui/Breadcrumbs.astro';
import Eyebrow from '@/components/ui/Eyebrow.astro';
import Section from '@/components/ui/Section.astro';
import MainLayout from '@/layouts/MainLayout.astro';
import { getCommunityStats } from '@/lib/community-stats';
import { getUrlPrefix, type Language, tr as loc } from '@/lib/i18n';
import {
  getAllMeetupShowcase,
  getUpcomingMeetupShowcase,
  groupMeetupShowcaseByYear,
} from '@/lib/meetup';
import {
  getEditionCountdownTargets,
  getEditions,
  isPostponedEdition,
} from '@/lib/pereiraTechDay';
import { getTranslations } from '@/lib/translations';

interface Props {
  lang: Language;
}

const { lang } = Astro.props;

/**
 * One timeline for everything. Upcoming entries (including the flagship
 * Pereira Tech Day) sit at the top of their year and carry the
 * "Próximamente" badge that `MeetupCard` / `EditionCard` already render.
 */
const allShowcase = await getAllMeetupShowcase();
// The programming section is an additional entry point into that one list, not
// a second source of truth — upcoming entries still appear in their year group
// below. See docs/features/MEETUPS.md.
const upcomingShowcase = await getUpcomingMeetupShowcase();
const groups = groupMeetupShowcaseByYear(allShowcase);
const years = groups.map((g) => g.year);
const communityStats = await getCommunityStats();

const editions = await getEditions();
const upcomingEdition = editions.find(
  (e) => e.data.status === 'announced' || e.data.status === 'rsvp-open'
);
const postponedEdition = editions.find(isPostponedEdition);
const ptdCountdown = upcomingEdition
  ? getEditionCountdownTargets(upcomingEdition)
  : null;
const ptdPostponement = postponedEdition?.data.postponement;
const ptdPostponedImage = ptdPostponement?.image
  ? {
      src: loc(ptdPostponement.image.src, lang),
      alt: loc(ptdPostponement.image.alt, lang),
    }
  : undefined;

const tr = getTranslations(lang);
const mp = tr.meetupsPage;
const prog = mp.programming;
const hs = tr.homeSections;

const fillStats = (template: string): string =>
  template
    .replaceAll('{meetups}', communityStats.display.meetups)
    .replaceAll('{talks}', communityStats.display.talks)
    .replaceAll('{speakers}', communityStats.display.speakers)
    .replaceAll('{sinceYear}', communityStats.display.sinceYear);

const t = {
  title: mp.title,
  description: fillStats(mp.description),
  intro: mp.intro,
  eyebrow: mp.eyebrow,
  all: mp.allMeetups,
  nextUpLabel: mp.nextUpLabel,
  nextUpCta: mp.nextUpCta,
  yearLabel: (n: number) => mp.yearLabel.replace('{year}', String(n)),
  yearNav: mp.yearNav,
};

const heroStats = [
  {
    value: communityStats.display.meetups,
    label: mp.statMeetups,
  },
  {
    value: communityStats.display.talks,
    label: mp.statTalks,
  },
  {
    value: communityStats.display.speakers,
    label: mp.statSpeakers,
  },
  {
    value: communityStats.display.sinceYear,
    label: mp.statSince,
  },
];

const breadcrumbs = [
  {
    label: mp.breadcrumbHome,
    href: `${getUrlPrefix(lang)}/`,
  },
  { label: tr.nav.meetups },
];
---

<MainLayout
  lang={lang}
  title={t.title}
  description={t.description}
  keywords={
    lang === 'en'
      ? [
          'Pereira Tech Talks meetups',
          'Pereira tech community',
          'Risaralda tech meetups',
          'Colombian tech meetups',
        ]
      : [
          'meetups Pereira Tech Talks',
          'meetups tecnología Pereira',
          'comunidad tech Risaralda',
          'meetups tecnología Colombia',
        ]
  }
>
  <div class="bg-gradient-to-b from-ptt-primary-soft/50 to-ptt-bg dark:from-ptt-bg-elevated dark:to-ptt-bg">
    <div class="main-container pt-12 sm:pt-16 pb-4">
      <Breadcrumbs items={breadcrumbs} />
    </div>
    <div class="main-container pt-6 pb-6 sm:pb-8">
      <Eyebrow>{t.eyebrow}</Eyebrow>
      <h1 class="mt-3 text-4xl sm:text-5xl font-bold tracking-tight text-ptt">
        {t.title}
      </h1>
      <p class="mt-4 max-w-3xl text-lg text-ptt-secondary">
        {t.intro}
      </p>
      <ul class="mt-8 grid max-w-2xl list-none grid-cols-2 gap-3 sm:grid-cols-4">
        {
          heroStats.map((stat) => (
            <li class="rounded-xl bg-ptt-bg-elevated px-3 py-4 text-center ring-1 ring-ptt-border sm:px-4">
              <p class="text-2xl font-bold tabular-nums tracking-tight text-ptt-primary sm:text-3xl dark:text-ptt-primary-dark">
                {stat.value}
              </p>
              <p class="mt-1 text-xs font-medium text-ptt-secondary sm:text-sm">
                {stat.label}
              </p>
            </li>
          ))
        }
      </ul>
    </div>

    {/*
      Bridge into the meetup archive — not the postponement strip.
      Pereira Tech Day is postponed and is no longer the next gathering.
    */}
    <div class="main-container pb-6 sm:pb-8">
      <a
        href={upcomingShowcase.length > 0 ? '#upcoming-meetups' : '#all-meetups'}
        class="group mx-auto flex w-fit max-w-full flex-col items-center gap-2 rounded-full px-3 py-2 text-center transition-colors focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-ptt-primary"
      >
        <span class="flex items-center gap-3 text-ptt-secondary">
          <span
            class="hidden h-px w-8 bg-ptt-border sm:block"
            aria-hidden="true"
          ></span>
          <span class="text-xs font-semibold uppercase tracking-[0.18em] text-ptt-primary dark:text-ptt-primary-dark">
            {t.nextUpLabel}
          </span>
          <span
            class="hidden h-px w-8 bg-ptt-border sm:block"
            aria-hidden="true"
          ></span>
        </span>
        <span class="inline-flex items-center gap-1.5 text-sm font-medium text-ptt-secondary transition-colors group-hover:text-ptt">
          {t.nextUpCta}
          <svg
            aria-hidden="true"
            class="h-4 w-4 shrink-0 motion-safe:animate-bounce"
            fill="none"
            stroke="currentColor"
            stroke-width="2.25"
            viewBox="0 0 24 24"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              d="M19 9l-7 7-7-7"
            ></path>
          </svg>
        </span>
      </a>
    </div>
  </div>

  {/* Same PTD strip as the homepage (after-hero). Calendar/upcoming cards hidden temporarily. */}
  <PtdAnnouncementStrip
    lang={lang}
    eyebrow={ptdPostponement ? hs.ptdStrip.postponedEyebrow : hs.ptdStrip.eyebrow}
    title={hs.ptdStrip.title}
    subtitle={
      ptdPostponement ? loc(ptdPostponement.headline, lang) : hs.ptdStrip.subtitle
    }
    ctaLabel={ptdPostponement ? hs.ptdStrip.postponedCta : hs.ptdStrip.cta}
    dateLabel={hs.ptdStrip.date}
    venueLabel={hs.ptdStrip.venue}
    attendanceLabel={hs.ptdStrip.attendance}
    targetDate={ptdCountdown?.targetDate}
    endDate={ptdCountdown?.endDate}
    postponed={Boolean(ptdPostponement)}
    postponedBody={ptdPostponement ? loc(ptdPostponement.body, lang) : undefined}
    postponedClosing={
      ptdPostponement ? loc(ptdPostponement.closing, lang) : undefined
    }
    postponedImage={ptdPostponedImage}
  />

  <Section
    eyebrow={prog.eyebrow}
    title={prog.title}
    id="upcoming-meetups"
    class="scroll-mt-28"
  >
    <p class="-mt-2 max-w-3xl text-ptt-secondary">{prog.intro}</p>
    {
      upcomingShowcase.length > 0 ? (
        <div class="mt-8">
          <UpcomingProgrammingRail
            items={upcomingShowcase}
            lang={lang}
            label={prog.railLabel}
          />
        </div>
      ) : (
        <div class="mt-8 rounded-2xl bg-ptt-bg-elevated p-6 ring-1 ring-ptt-border sm:p-8">
          <h3 class="text-lg font-semibold text-ptt">{prog.emptyTitle}</h3>
          <p class="mt-2 max-w-2xl text-ptt-secondary">{prog.emptyBody}</p>
          <a
            href={`${getUrlPrefix(lang)}/call-for-speakers/`}
            class="mt-5 inline-flex min-h-[44px] items-center gap-2 rounded-full bg-ptt-primary px-6 py-3 text-base font-semibold text-white transition-colors hover:bg-ptt-primary/90 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-ptt-primary"
          >
            {prog.emptyCta}
          </a>
        </div>
      )
    }
  </Section>

  <Section title={t.all} id="all-meetups" class="scroll-mt-28">
    <div class="grid min-w-0 gap-10 lg:grid-cols-[7rem_1fr]">
      {
        years.length > 0 && (
          <MeetupYearRail client:idle years={years} label={t.yearNav} />
        )
      }
      <div class="space-y-16 min-w-0">
        {
          groups.map(({ year, items }) => (
            <div id={`year-${year}`} class="scroll-mt-28">
              <h3 class="mb-6 text-2xl font-bold tracking-tight text-ptt">
                {t.yearLabel(year)}
              </h3>
              <ul class="grid min-w-0 gap-6 sm:grid-cols-2 lg:grid-cols-3">
                {items.map((item) => (
                  <li class="min-w-0">
                    <MeetupShowcaseCard item={item} lang={lang} />
                  </li>
                ))}
              </ul>
            </div>
          ))
        }
      </div>
    </div>
  </Section>
</MainLayout>
