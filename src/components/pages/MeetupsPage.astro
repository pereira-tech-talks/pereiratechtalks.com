---
/**
 * PTT v3.0.0 meetups timeline page (shared between EN and ES).
 *
 * Full archive + sticky year jump rail (see MEETUPS_NAV_DECISION.md).
 */

import MeetupCard from '@/components/cards/MeetupCard.astro';
import MeetupYearRail from '@/components/meetups/MeetupYearRail.astro';
import Breadcrumbs from '@/components/ui/Breadcrumbs.astro';
import EmptyState from '@/components/ui/EmptyState.astro';
import Eyebrow from '@/components/ui/Eyebrow.astro';
import Section from '@/components/ui/Section.astro';
import MainLayout from '@/layouts/MainLayout.astro';
import { getUrlPrefix, type Language } from '@/lib/i18n';
import {
  getMeetups,
  getUpcomingMeetups,
  groupMeetupsByYear,
} from '@/lib/meetup';
import { getTranslations } from '@/lib/translations';

interface Props {
  lang: Language;
}

const { lang } = Astro.props;

const all = await getMeetups();
const upcoming = await getUpcomingMeetups();
const past = all.filter((m) => !upcoming.some((u) => u.id === m.id));
const groups = groupMeetupsByYear(past);
const years = groups.map((g) => g.year);

const tr = getTranslations(lang);
const mp = tr.meetupsPage;

const t = {
  title: mp.title,
  description: mp.description,
  intro: mp.intro,
  upcoming: mp.upcoming,
  past: mp.past,
  emptyUpcomingTitle: mp.emptyUpcomingTitle,
  emptyUpcomingDescription: mp.emptyUpcomingDescription,
  ctaLabel: mp.ctaLuma,
  ctaHref: 'https://luma.com/pertechtalks',
  meetupsCount: mp.archiveCount.replace('{n}', String(past.length)),
  yearLabel: (n: number) => mp.yearLabel.replace('{year}', String(n)),
  yearNav: mp.yearNav,
  calendarEyebrow: mp.calendarEyebrow,
  archiveEyebrow: mp.archiveEyebrow,
};

const breadcrumbs = [
  {
    label: mp.breadcrumbHome,
    href: `${getUrlPrefix(lang)}/`,
  },
  { label: tr.nav.meetups },
];
---

<MainLayout
  lang={lang}
  title={t.title}
  description={t.description}
  keywords={
    lang === 'en'
      ? [
          'Pereira Tech Talks meetups',
          'Pereira tech community',
          'Risaralda tech meetups',
          'Colombian tech meetups',
        ]
      : [
          'meetups Pereira Tech Talks',
          'meetups tecnología Pereira',
          'comunidad tech Risaralda',
          'meetups tecnología Colombia',
        ]
  }
>
  <div class="bg-gradient-to-b from-ptt-primary-soft/50 to-ptt-bg dark:from-ptt-bg-elevated dark:to-ptt-bg">
    <div class="main-container pt-12 sm:pt-16 pb-4">
      <Breadcrumbs items={breadcrumbs} />
    </div>
    <div class="main-container pt-6 pb-12">
      <Eyebrow>{t.meetupsCount}</Eyebrow>
      <h1 class="mt-3 text-4xl sm:text-5xl font-bold tracking-tight text-ptt">
        {t.title}
      </h1>
      <p class="mt-4 max-w-3xl text-lg text-ptt-secondary">
        {t.intro}
      </p>
    </div>
  </div>

  <Section
    eyebrow={t.calendarEyebrow}
    title={t.upcoming}
    surface="alt"
  >
    {
      upcoming.length > 0 ? (
        <ul class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
          {upcoming.map((m) => (
            <li>
              <MeetupCard meetup={m} lang={lang} loading="eager" />
            </li>
          ))}
        </ul>
      ) : (
        <EmptyState
          title={t.emptyUpcomingTitle}
          description={t.emptyUpcomingDescription}
          ctaLabel={t.ctaLabel}
          ctaHref={t.ctaHref}
        />
      )
    }
  </Section>

  <Section eyebrow={t.archiveEyebrow} title={t.past}>
    <div class="grid min-w-0 gap-10 lg:grid-cols-[7rem_1fr]">
      {
        years.length > 0 && (
          <MeetupYearRail years={years} label={t.yearNav} />
        )
      }
      <div class="space-y-16 min-w-0">
        {
          groups.map(({ year, meetups }) => (
            <div id={`year-${year}`} class="scroll-mt-28">
              <h3 class="mb-6 text-2xl font-bold tracking-tight text-ptt">
                {t.yearLabel(year)}
              </h3>
              <ul class="grid min-w-0 gap-6 sm:grid-cols-2 lg:grid-cols-3">
                {meetups.map((m) => (
                  <li class="min-w-0">
                    <MeetupCard meetup={m} lang={lang} />
                  </li>
                ))}
              </ul>
            </div>
          ))
        }
      </div>
    </div>
  </Section>
</MainLayout>
