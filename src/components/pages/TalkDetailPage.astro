---
/**
 * PTT v3.0.0 single talk detail page — abstract, speakers, recording (if
 * available), slides deck embed (if available), and link back to the parent
 * event.
 */

import type { CollectionEntry } from 'astro:content';
import { render } from 'astro:content';
import SpeakerCard from '@/components/cards/SpeakerCard.astro';
import Badge from '@/components/ui/Badge.astro';
import Breadcrumbs from '@/components/ui/Breadcrumbs.astro';
import MainLayout from '@/layouts/MainLayout.astro';
import { getUrlPrefix, type Language, tr } from '@/lib/i18n';
import { getMeetupBySlug, getMeetupSlug } from '@/lib/meetup';
import { getEditionByYear } from '@/lib/pereiraTechDay';
import { getSpeakersBySlugs } from '@/lib/speaker';

interface Props {
  talk: CollectionEntry<'talks'>;
  lang: Language;
}

const { talk, lang } = Astro.props;

const prefix = getUrlPrefix(lang);
const title = tr(talk.data.title, lang);
const abstract = tr(talk.data.abstract, lang);
const langLabel = (talk.data.language || 'es').toUpperCase();
const date = talk.data.date ? new Date(talk.data.date) : null;
const dateLabel = date
  ? new Intl.DateTimeFormat(lang === 'es' ? 'es-CO' : 'en-US', {
      year: 'numeric',
      month: 'long',
      day: 'numeric',
    }).format(date)
  : '';

const speakers = await getSpeakersBySlugs(talk.data.speakers);

const typeLabels: Record<string, { en: string; es: string }> = {
  keynote: { en: 'Keynote', es: 'Keynote' },
  lightning: { en: 'Lightning talk', es: 'Lightning talk' },
  panel: { en: 'Panel', es: 'Panel' },
  workshop: { en: 'Workshop', es: 'Taller' },
  talk: { en: 'Talk', es: 'Charla' },
};
const typeLabel = typeLabels[talk.data.type ?? 'talk'][lang];

const event = talk.data.event;
let eventLink: { label: string; href: string } | null = null;
if (event) {
  if (event.collection === 'meetups') {
    const meetupEntry = await getMeetupBySlug(event.slug);
    if (meetupEntry) {
      const slug = getMeetupSlug(meetupEntry);
      eventLink = {
        label: tr(meetupEntry.data.title, lang),
        href: `${prefix}/meetups/${slug}/`,
      };
    }
  } else if (event.collection === 'pereiraTechDays') {
    const yearMatch = event.slug.match(/(\d{4})/);
    if (yearMatch) {
      const ptdEntry = await getEditionByYear(parseInt(yearMatch[1], 10));
      if (ptdEntry) {
        eventLink = {
          label: tr(ptdEntry.data.title, lang),
          href: `${prefix}/pereira-tech-days/${ptdEntry.data.year}/`,
        };
      }
    }
  }
}

const breadcrumbs = [
  {
    label: lang === 'es' ? 'Inicio' : 'Home',
    href: prefix === '' ? '/' : `${prefix}/`,
  },
  { label: lang === 'es' ? 'Charlas' : 'Talks', href: `${prefix}/talks/` },
  { label: title },
];

const { Content } = await render(talk);

const recording = talk.data.recording;
const recordingEmbedUrl = recording
  ? recording.provider === 'youtube'
    ? recording.url
        .replace('watch?v=', 'embed/')
        .replace('youtu.be/', 'www.youtube.com/embed/')
    : recording.url
  : null;
---

<MainLayout lang={lang} title={title} description={abstract}>
  <article class="bg-white dark:bg-gray-950">
    <header class="bg-gradient-to-br from-ptt-bg-dark to-ptt-bg-dark/90 text-white">
      <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-12 sm:py-16">
        <Breadcrumbs items={breadcrumbs} baseUrl="https://pereiratechtalks.org" onDark />
        <div class="mt-6 flex flex-wrap items-center gap-3 text-sm">
          <Badge variant="neutral">{typeLabel}</Badge>
          <Badge variant="neutral">{langLabel}</Badge>
          {date && (
            <time
              datetime={date.toISOString()}
              class="font-semibold uppercase tracking-widest text-ptt-accent dark:text-ptt-accent-dark"
            >
              {dateLabel}
            </time>
          )}
        </div>
        <h1 class="mt-3 text-3xl sm:text-5xl font-bold tracking-tight">
          {title}
        </h1>
        {
          speakers.length > 0 && (
            <p class="mt-4 text-lg text-gray-200">
              {lang === 'es' ? 'Por' : 'By'}{' '}
              {speakers.map((s, i) => (
                <>
                  {i > 0 && ', '}
                  <a
                    href={`${prefix}/speakers/${s.id}/`}
                    class="font-semibold text-white hover:text-ptt-accent dark:hover:text-ptt-accent-dark underline"
                  >
                    {s.data.name}
                  </a>
                </>
              ))}
            </p>
          )
        }
      </div>
    </header>

    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-12 sm:py-16 grid gap-12 lg:grid-cols-[1fr_240px]">
      <div class="prose prose-lg dark:prose-invert max-w-none prose-headings:tracking-tight prose-a:text-ptt-primary dark:prose-a:text-ptt-primary-dark">
        <h2 class="!mt-0">{lang === 'es' ? 'Resumen' : 'Abstract'}</h2>
        <p>{abstract}</p>
        <Content />
      </div>

      <aside class="space-y-8 lg:sticky lg:top-24 lg:self-start">
        {
          eventLink && (
            <div>
              <h3 class="text-xs font-semibold uppercase tracking-widest text-ptt-primary dark:text-ptt-primary-dark mb-2">
                {lang === 'es' ? 'Presentada en' : 'Presented at'}
              </h3>
              <a
                href={eventLink.href}
                class="text-sm font-medium text-gray-900 dark:text-gray-50 hover:text-ptt-primary dark:hover:text-ptt-primary-dark"
              >
                {eventLink.label}
              </a>
            </div>
          )
        }
        <div>
          <h3 class="text-xs font-semibold uppercase tracking-widest text-ptt-primary dark:text-ptt-primary-dark mb-2">
            {lang === 'es' ? 'Duración' : 'Duration'}
          </h3>
          <p class="text-sm text-gray-700 dark:text-gray-200">
            {talk.data.duration} {lang === 'es' ? 'min' : 'min'}
          </p>
        </div>
      </aside>
    </div>

    {
      recordingEmbedUrl && (
        <section class="bg-gray-50 dark:bg-gray-900/50 py-12 sm:py-16">
          <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
            <h2 class="text-2xl font-bold tracking-tight text-gray-900 dark:text-gray-50 mb-6">
              {lang === 'es' ? 'Grabación' : 'Recording'}
            </h2>
            <div class="aspect-video overflow-hidden rounded-2xl bg-black ring-1 ring-gray-200 dark:ring-gray-800">
              <iframe
                src={recordingEmbedUrl}
                title={title}
                class="h-full w-full border-0"
                allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
                referrerpolicy="strict-origin-when-cross-origin"
                allowfullscreen
              />
            </div>
          </div>
        </section>
      )
    }

    {
      speakers.length > 0 && (
        <section class="py-12 sm:py-16">
          <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
            <h2 class="text-2xl font-bold tracking-tight text-gray-900 dark:text-gray-50 mb-6">
              {lang === 'es' ? 'Sobre el ponente' : 'About the speaker'}
            </h2>
            <ul class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
              {speakers.map((speaker) => (
                <li>
                  <SpeakerCard speaker={speaker} lang={lang} />
                </li>
              ))}
            </ul>
          </div>
        </section>
      )
    }
  </article>
</MainLayout>
