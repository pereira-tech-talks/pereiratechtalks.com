---
/**
 * PTT v3.0.0 Sponsor Us landing page.
 *
 * Informational page for prospective sponsors. Explains tiers, value, current
 * sponsors, and links to the contact form with a sponsorship-prefilled
 * subject. No standalone backend wired here.
 */

import SponsorInquiryForm from '@/components/contact/SponsorInquiryForm.svelte';
import Badge from '@/components/ui/Badge.astro';
import Breadcrumbs from '@/components/ui/Breadcrumbs.astro';
import Eyebrow from '@/components/ui/Eyebrow.astro';
import Section from '@/components/ui/Section.astro';
import MainLayout from '@/layouts/MainLayout.astro';
import { CONTACT_FORM } from '@/lib/constances';
import { getUrlPrefix, type Language } from '@/lib/i18n';
import { getActiveSponsors } from '@/lib/sponsor';
import { getSponsorUsContent } from '@/lib/sponsor-us-content';
import { getTranslations } from '@/lib/translations';

interface Props {
  lang: Language;
}

const { lang } = Astro.props;
const page = getTranslations(lang).sponsorUsPage;

const sponsors = await getActiveSponsors();

const t = getSponsorUsContent(lang);
const breadcrumbs = [
  {
    label: lang === 'es' ? 'Inicio' : 'Home',
    href: `${getUrlPrefix(lang)}/`,
  },
  { label: t.title },
];

const ctaHref = '#sponsor-form';
---

<MainLayout lang={lang} title={t.title} description={t.description}>
  <div class="bg-gradient-to-br from-ptt-bg-dark to-ptt-bg-dark/85 text-white">
    <div class="main-container pt-12 sm:pt-16 pb-4">
      <Breadcrumbs items={breadcrumbs} onDark />
    </div>
    <div class="main-container pt-6 pb-16">
      <Eyebrow variant="accent">
        {lang === 'es' ? 'Construyamos juntos' : 'Build with us'}
      </Eyebrow>
      <h1 class="mt-3 text-4xl sm:text-6xl font-bold tracking-tight">
        {t.title}
      </h1>
      <p class="mt-4 max-w-3xl text-lg text-white/85">{t.intro}</p>
      <a
        href={ctaHref}
        class="mt-8 inline-flex min-h-[44px] items-center gap-2 rounded-full bg-ptt-accent px-6 py-3 text-base font-semibold text-ptt-bg-dark shadow-sm transition-colors hover:bg-ptt-accent/90 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-ptt-accent"
      >
        {t.ctaButton}
      </a>
    </div>
  </div>

  <Section eyebrow={lang === 'es' ? 'Cifras' : 'Numbers'} title={t.reachTitle}>
    <ul class="grid grid-cols-2 sm:grid-cols-4 gap-4 sm:gap-6 list-none">
      {
        t.reachStats.map((stat) => (
          <li class="min-w-0 rounded-2xl bg-ptt-bg-elevated ring-1 ring-ptt-border p-4 sm:p-6 text-center">
            <p class="text-4xl sm:text-5xl font-bold text-ptt-primary dark:text-ptt-primary-dark">
              {stat.value}
            </p>
            <p class="mt-2 text-sm font-medium text-ptt-secondary">
              {stat.label}
            </p>
          </li>
        ))
      }
    </ul>
  </Section>

  <Section
    eyebrow={lang === 'es' ? 'Niveles' : 'Tiers'}
    title={t.tiersTitle}
    surface="alt"
  >
    <ul class="grid gap-6 sm:grid-cols-2 list-none">
      {
        t.tiers.map((tier) => (
          <li class="flex h-full min-w-0 flex-col rounded-2xl bg-ptt-bg-elevated ring-1 ring-ptt-border p-4 sm:p-6">
            <div class="flex flex-wrap items-center justify-between gap-2">
              <h3 class="text-2xl font-bold tracking-tight text-ptt">
                {tier.name}
              </h3>
              <Badge variant={tier.tier} size="md">
                {tier.name}
              </Badge>
            </div>
            <p class="mt-2 text-sm font-medium text-ptt-primary dark:text-ptt-primary-dark">
              {tier.headline}
            </p>
            <ul class="mt-4 space-y-2 text-sm text-ptt-secondary">
              {tier.perks.map((perk) => (
                <li class="flex items-start gap-2">
                  <svg aria-hidden="true" class="h-4 w-4 shrink-0 text-ptt-primary dark:text-ptt-primary-dark mt-0.5" fill="currentColor" viewBox="0 0 20 20">
                    <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd" />
                  </svg>
                  <span>{perk}</span>
                </li>
              ))}
            </ul>
          </li>
        ))
      }
    </ul>
  </Section>

  {
    sponsors.length > 0 && (
      <Section
        eyebrow={lang === 'es' ? 'Patrocinadores actuales' : 'Current partners'}
        title={t.currentSponsorsTitle}
      >
        <ul class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-4 gap-6 list-none">
          {sponsors.slice(0, 12).map((sponsor) => (
            <li class="flex h-24 items-center justify-center rounded-xl bg-ptt-bg-elevated ring-1 ring-ptt-border p-4">
              <a
                href={sponsor.data.url}
                target="_blank"
                rel="noopener noreferrer"
                class="block focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-ptt-primary"
                aria-label={sponsor.data.name}
              >
                <img
                  src={sponsor.data.logo.light}
                  alt={sponsor.data.logo.alt}
                  width="160"
                  height="64"
                  loading="lazy"
                  class="max-h-12 max-w-full object-contain dark:hidden"
                />
                <img
                  src={sponsor.data.logo.dark}
                  alt={sponsor.data.logo.alt}
                  width="160"
                  height="64"
                  loading="lazy"
                  class="hidden max-h-12 max-w-full object-contain dark:block"
                />
              </a>
            </li>
          ))}
        </ul>
      </Section>
    )
  }

  <Section
    id="sponsor-form"
    eyebrow={page.formEyebrow}
    title={page.formSectionTitle}
  >
    <div class="max-w-2xl mx-auto">
      <SponsorInquiryForm
        client:visible
        lang={lang}
        apiEndpoint={CONTACT_FORM.apiEndpoint}
      />
    </div>
  </Section>
</MainLayout>
