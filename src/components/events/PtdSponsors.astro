---
import Image from '~/components/common/Image.astro';

export interface SponsorBrand {
  src: string;
  alt: string;
  url: string;
}

export interface SponsorEntry extends SponsorBrand {
  tier: string;
}

export interface Props {
  id?: string;
  logoMaskSrc?: string;
  backgroundSrc?: string;
  title?: string;
  subtitle?: string;
  brands?: Record<string, SponsorBrand[]>;
  footerNote?: string;
}

const tierOrder = ['gold', 'silver', 'bronze'] as const;

const logoWidths: Record<string, number> = {
  gold: 280,
  silver: 240,
  bronze: 180,
};

const {
  id = 'sponsors',
  backgroundSrc,
  title = 'Patrocinadores',
  subtitle = 'Empresas que <strong>apoyaran</strong> esta edición del evento.',
  brands = {},
  footerNote = 'Gracias por impulsar el ecosistema tech de Pereira y la región.',
} = Astro.props;

const sponsors: SponsorEntry[] = tierOrder.flatMap((tier) =>
  (brands[tier] ?? []).map((brand) => ({ ...brand, tier })),
);
---

<section
  class="ptd-sponsors ptd-section-spacer"
  {id}
  style={
    backgroundSrc ? `--ptd-sponsors-bg: url('${backgroundSrc}')` : undefined
  }
>
  <div class="ptd-sponsors__inner">
    <header class="ptd-sponsors__header">
      <div class="ptd-sponsors__headline">
        {title && <h2 class="ptd-sponsors__title">{title}</h2>}
        {subtitle && (
          <p class="ptd-sponsors__subtitle" set:html={subtitle} />
        )}
      </div>
    </header>

    {
      sponsors.length > 0 && (
        <div class="ptd-sponsors__showcase">
          <svg
            class="ptd-sponsors__tree"
            viewBox="0 0 400 320"
            aria-hidden="true"
            focusable="false"
          >
            <path
              class="ptd-sponsors__tree-line ptd-sponsors__tree-line--teal"
              d="M200 300 C200 240 120 200 80 120 C60 80 40 40 30 20"
            />
            <path
              class="ptd-sponsors__tree-line ptd-sponsors__tree-line--coral"
              d="M200 300 C200 230 280 190 320 110 C340 70 360 35 370 15"
            />
            <path
              class="ptd-sponsors__tree-line ptd-sponsors__tree-line--teal"
              d="M200 300 C200 250 200 180 200 100 C200 60 200 30 200 8"
            />
            <path
              class="ptd-sponsors__tree-line ptd-sponsors__tree-line--coral"
              d="M200 300 C170 250 130 210 95 150"
            />
            <path
              class="ptd-sponsors__tree-line ptd-sponsors__tree-line--teal"
              d="M200 300 C230 250 270 210 305 150"
            />
            <circle class="ptd-sponsors__tree-node" cx="80" cy="120" r="4" />
            <circle class="ptd-sponsors__tree-node" cx="320" cy="110" r="4" />
            <circle class="ptd-sponsors__tree-node" cx="200" cy="100" r="4" />
            <circle
              class="ptd-sponsors__tree-node ptd-sponsors__tree-node--coral"
              cx="95"
              cy="150"
              r="4"
            />
            <circle
              class="ptd-sponsors__tree-node ptd-sponsors__tree-node--coral"
              cx="305"
              cy="150"
              r="4"
            />
          </svg>

          <ul class="ptd-sponsors__logos" role="list">
            {sponsors.map((sponsor) => (
              <li
                class:list={[
                  'ptd-sponsors__logo',
                  `ptd-sponsors__logo--${sponsor.tier}`,
                ]}
              >
                <a
                  class="ptd-sponsors__logo-link"
                  href={sponsor.url}
                  target="_blank"
                  rel="noopener noreferrer"
                  title={sponsor.alt}
                >
                  <Image
                    src={`~/assets/images/pereira-tech-day/sponsors/${sponsor.src}`}
                    alt={sponsor.alt}
                    width={logoWidths[sponsor.tier] ?? 180}
                    class="ptd-sponsors__logo-img"
                    loading="lazy"
                  />
                </a>
              </li>
            ))}
          </ul>
        </div>
      )
    }

    {
      footerNote && (
        <p class="ptd-sponsors__footer-pill">
          <span class="ptd-sponsors__footer-dots" aria-hidden="true">
            <span class="ptd-sponsors__footer-dot ptd-sponsors__footer-dot--coral" />
            <span class="ptd-sponsors__footer-dot ptd-sponsors__footer-dot--teal" />
            <span class="ptd-sponsors__footer-dot ptd-sponsors__footer-dot--navy" />
          </span>
          <span class="ptd-sponsors__footer-text">{footerNote}</span>
        </p>
      )
    }
  </div>
</section>
