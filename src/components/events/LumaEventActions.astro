---
import { Icon } from 'astro-icon/components';
import { twMerge } from 'tailwind-merge';

import LumaCheckoutButton from '~/components/events/LumaCheckoutButton.astro';
import { parseLumaEventUrl } from '~/utils/luma';

export interface Props {
  lumaEventUrl: string;
  class?: string;
  showCheckoutButton?: boolean;
}

const { lumaEventUrl, class: className = '', showCheckoutButton = true } = Astro.props;
const { viewUrl, eventId } = parseLumaEventUrl(lumaEventUrl);

const iconLinkClass =
  'inline-flex items-center justify-center rounded-full p-2 text-primary hover:bg-primary/10 dark:text-blue-400 dark:hover:bg-blue-400/10 transition-colors';

const tooltipClass =
  'pointer-events-none absolute bottom-full left-1/2 z-10 mb-2 -translate-x-1/2 whitespace-nowrap rounded-md bg-gray-900 px-2.5 py-1.5 text-xs font-medium text-white opacity-0 shadow-lg transition-opacity duration-150 group-hover:opacity-100 group-focus-within:opacity-100 dark:bg-slate-700';
---

<div class={twMerge('flex items-center gap-0.5 shrink-0', className)}>
  <span class="group relative inline-flex">
    <a
      href={viewUrl}
      target="_blank"
      rel="noopener noreferrer"
      class={iconLinkClass}
      aria-label="Ver evento en Luma"
    >
      <Icon name="tabler:external-link" class="w-6 h-6" aria-hidden="true" />
    </a>
    <span role="tooltip" class={tooltipClass}>Ver evento en Luma</span>
  </span>

  {showCheckoutButton && <LumaCheckoutButton eventId={eventId} variant="icon" />}
</div>
