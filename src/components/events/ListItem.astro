---
import { APP_BLOG } from 'astrowind:config';
import { Icon } from 'astro-icon/components';
import Image from '~/components/common/Image.astro';
import LumaEventActions from '~/components/events/LumaEventActions.astro';
import UpcomingEventRibbon from '~/components/events/UpcomingEventRibbon.astro';

import type { Post } from '~/types';
import { isUpcomingEvent } from '~/utils/events';
import { getPermalink } from '~/utils/permalinks';

import { getFormattedDate } from '~/utils/utils';

export interface Props {
  event: Post;
}

const { event } = Astro.props;

const image = event?.image;

const link = APP_BLOG?.post?.isEnabled
  ? getPermalink(event.permalink, 'post')
  : '';

const preview = event.preview;

const lumaEventUrl = event.lumaEventUrl;
const isUpcoming = isUpcomingEvent(event.publishDate);
---

<article class={`relative max-w-md mx-auto md:max-w-none grid gap-6 md:gap-8 ${image ? 'md:grid-cols-2' : ''}`}>
  {isUpcoming && !image && <UpcomingEventRibbon />}
  {
    image && (
      <a class="relative block group" href={link}>
        <div class="relative h-0 pb-[56.25%] md:pb-[75%] md:h-72 lg:pb-[56.25%] overflow-hidden bg-gray-400 dark:bg-slate-700 rounded shadow-lg">
          {isUpcoming && <UpcomingEventRibbon />}
          {image && (
            <Image
              src={image}
              class="absolute inset-0 object-cover w-full h-full mb-6 rounded shadow-lg bg-gray-400 dark:bg-slate-700"
              widths={[400, 900]}
              width={900}
              sizes="(max-width: 900px) 400px, 900px"
              alt={event.title}
              aspectRatio="16:9"
              loading="lazy"
              decoding="async"
            />
          )}
        </div>
      </a>
    )
  }
  <div class="mt-2">
    <header>
      <div class="mb-1">
        <span class="text-sm">
          <Icon name="tabler:clock" class="w-3.5 h-3.5 inline-block -mt-0.5 dark:text-gray-400" />
          <time datetime={String(event.publishDate)} class="inline-block">{getFormattedDate(event.publishDate)}</time>
          {
            event.venue && (
              <>
                {' '}
                · <Icon name="tabler:location" class="w-3.5 h-3.5 inline-block -mt-0.5 dark:text-gray-400" />
                <span>{event.venue}</span>
              </>
            )
          }
          {
            event.author && (
              <>
                {' '}
                · <Icon name="tabler:user" class="w-3.5 h-3.5 inline-block -mt-0.5 dark:text-gray-400" />
                <span>{event.author}</span>
              </>
            )
          }
        </span>
      </div>
      <div class="flex flex-col sm:flex-row sm:items-start sm:justify-between gap-3 mb-2">
        <h2 class="text-xl sm:text-2xl font-bold leading-tight font-heading dark:text-slate-300 min-w-0">
          {
            link ? (
              <a class="hover:text-primary dark:hover:text-blue-700 transition ease-in duration-200" href={link}>
                {event.title}
              </a>
            ) : (
              event.title
            )
          }
        </h2>
        {lumaEventUrl && (
          <LumaEventActions lumaEventUrl={lumaEventUrl} class="self-center sm:self-start" />
        )}
      </div>
      {
        preview && (
          <p class="text-muted dark:text-slate-400 text-base leading-relaxed line-clamp-3 mb-3 whitespace-pre-line">{preview}</p>
        )
      }
      {
        link && (
          <p class="mb-0">
            <a class="text-primary dark:text-blue-400 font-medium hover:underline" href={link}>
              Seguir leyendo
            </a>
          </p>
        )
      }
    </header>
  </div>
</article>
