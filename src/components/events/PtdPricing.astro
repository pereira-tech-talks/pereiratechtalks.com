---
import { Icon } from 'astro-icon/components';
import Button from '~/components/ui/Button.astro';
import type { Price } from '~/types';

export interface PtdSponsorTier extends Price {
  tier: 'silver' | 'gold' | 'platinum';
  icon: string;
  featured?: boolean;
}

export interface Props {
  id?: string;
  title?: string;
  tiers?: PtdSponsorTier[];
  extraPlans?: Price[];
  footerNote?: string;
  backgroundSrc?: string;
}

const {
  id = 'pricing',
  title = 'Planes de Patrocinio',
  tiers = [],
  extraPlans = [],
  footerNote = 'El sponsor provee su mobiliario.',
  backgroundSrc,
} = Astro.props;
---

<section class="ptd-pricing ptd-section-spacer" {id}>
  {
    backgroundSrc && (
      <div
        class="ptd-pricing__backdrop"
        aria-hidden="true"
        style={`--ptd-pricing-bg: url('${backgroundSrc}')`}
      />
    )
  }

  <div class="ptd-pricing__inner">
    <header class="ptd-pricing__header">
      {title && <h2 class="ptd-pricing__title">{title}</h2>}
      <span class="ptd-pricing__title-accent" aria-hidden="true" />
    </header>

    {
      tiers.length > 0 && (
        <div class="ptd-pricing__grid">
          {tiers.map((tier) => (
            <article
              class:list={[
                'ptd-pricing-card',
                `ptd-pricing-card--${tier.tier}`,
                { 'ptd-pricing-card--featured': tier.featured },
              ]}
            >
              <div class="ptd-pricing-card__icon" aria-hidden="true">
                <Icon name={tier.icon} />
              </div>

              {tier.title && (
                <h3 class="ptd-pricing-card__name">{tier.title}</h3>
              )}

              {tier.price && (
                <p class="ptd-pricing-card__price">
                  <span class="ptd-pricing-card__price-currency">$</span>
                  <span class="ptd-pricing-card__price-value">{tier.price}</span>
                  {tier.period && (
                    <span class="ptd-pricing-card__price-period">
                      {tier.period}
                    </span>
                  )}
                </p>
              )}

              {tier.subtitle && (
                <p class="ptd-pricing-card__tagline">{tier.subtitle}</p>
              )}

              <span class="ptd-pricing-card__divider" aria-hidden="true" />

              {tier.items && tier.items.length > 0 && (
                <ul class="ptd-pricing-card__list" role="list">
                  {tier.items.map((item) =>
                    item.description ? (
                      <li>
                        <span class="ptd-pricing-card__check" aria-hidden="true">
                          <Icon name="tabler:check" />
                        </span>
                        <span>{item.description}</span>
                      </li>
                    ) : null,
                  )}
                </ul>
              )}

              {tier.callToAction?.href && (
                <div class="ptd-pricing-card__cta">
                  <Button
                    variant="secondary"
                    class="ptd-pricing-card__button"
                    {...tier.callToAction}
                  />
                </div>
              )}
            </article>
          ))}
        </div>
      )
    }

    {
      extraPlans.length > 0 && (
        <div class="ptd-pricing__extra">
          {extraPlans.map((plan) => (
            <article class="ptd-pricing-card ptd-pricing-card--extra">
              {plan.title && (
                <h3 class="ptd-pricing-card__name">{plan.title}</h3>
              )}
              {plan.subtitle && (
                <p class="ptd-pricing-card__tagline">{plan.subtitle}</p>
              )}
              {plan.items && plan.items.length > 0 && (
                <ul class="ptd-pricing-card__list" role="list">
                  {plan.items.map((item) => {
                    if (item.title) {
                      return (
                        <li class="ptd-pricing-card__list-heading">
                          {item.title}
                        </li>
                      );
                    }
                    if (item.subtitle) {
                      return (
                        <li class="ptd-pricing-card__list-note">
                          {item.subtitle}
                        </li>
                      );
                    }
                    if (item.description) {
                      return (
                        <li>
                          <span
                            class="ptd-pricing-card__check"
                            aria-hidden="true"
                          >
                            <Icon name="tabler:check" />
                          </span>
                          <span>{item.description}</span>
                        </li>
                      );
                    }
                    return null;
                  })}
                </ul>
              )}
              {plan.callToAction?.href && (
                <div class="ptd-pricing-card__cta">
                  <Button
                    variant="secondary"
                    class="ptd-pricing-card__button"
                    {...plan.callToAction}
                  />
                </div>
              )}
            </article>
          ))}
        </div>
      )
    }

    {
      footerNote && (
        <p class="ptd-pricing__footer">
          <Icon name="tabler:leaf" class="ptd-pricing__footer-icon" />
          <Icon
            name="tabler:leaf"
            class="ptd-pricing__footer-icon ptd-pricing__footer-icon--alt"
          />
          <span>{footerNote}</span>
        </p>
      )
    }
  </div>
</section>
