---
import Item from '~/components/events/ListItem.astro';
import type { Post } from '~/types';

export interface Props {
  events: Array<Post>;
  /** Items at this index and above are hidden until revealed (load more). */
  hiddenFromIndex?: number;
  id?: string;
}

const { events, hiddenFromIndex, id } = Astro.props;
---

<ul id={id}>
  {
    events.map((event, index) => (
      <li
        class:list={[
          'mb-12 md:mb-20',
          { hidden: hiddenFromIndex !== undefined && index >= hiddenFromIndex },
        ]}
        data-event-item
      >
        <Item event={event} />
      </li>
    ))
  }
</ul>
