---
import { Icon } from 'astro-icon/components';
import { twMerge } from 'tailwind-merge';

import { getLumaCheckoutHref } from '~/utils/luma';

export interface Props {
  eventId: string;
  label?: string;
  class?: string;
  variant?: 'button' | 'icon';
  showCheckoutButton?: boolean;
  showTooltip?: boolean;
  showTicketIcon?: boolean;
}

const {
  eventId,
  label = 'Inscribirse al evento',
  class: className = '',
  variant = 'button',
  showCheckoutButton = true,
  showTooltip = true,
  showTicketIcon = false,
} = Astro.props;
const href = getLumaCheckoutHref(eventId);
const shouldShowTooltip = showTooltip && !className.includes('no-tooltip');
---

{
  showCheckoutButton && (
    <>
      {
        variant === 'icon' ? (
          <span class={twMerge('group relative inline-flex shrink-0', className)}>
            <a
              href={href}
              class="inline-flex items-center justify-center rounded-full p-2 text-primary transition-colors hover:bg-primary/5 dark:text-blue-400 dark:hover:bg-blue-400/10"
              aria-label={label}
              data-luma-action="checkout"
              data-luma-event-id={eventId}
            >
              <Icon name="tabler:ticket" class="w-6 h-6" aria-hidden="true" />
            </a>
            {shouldShowTooltip && (
              <span
                role="tooltip"
                class="pointer-events-none absolute bottom-full left-1/2 z-10 mb-2 -translate-x-1/2 whitespace-nowrap rounded-md bg-gray-900 px-2.5 py-1.5 text-xs font-medium text-white opacity-0 shadow-lg transition-opacity duration-150 group-hover:opacity-100 group-focus-within:opacity-100 dark:bg-slate-700"
              >
                {label}
              </span>
            )}
          </span>
        ) : (
          <a
            href={href}
            class={twMerge('btn btn-primary', className)}
            data-luma-action="checkout"
            data-luma-event-id={eventId}
          >
            {showTicketIcon && <Icon name="tabler:ticket" class="mr-2 h-5 w-5" aria-hidden="true" />}
            {label}
          </a>
        )
      }

      <script is:inline data-astro-rerun>
        window.__scheduleLumaCheckout?.();
      </script>
    </>
  )
}
