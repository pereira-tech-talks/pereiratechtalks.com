---
/**
 * PtdCommunitiesOrganiza — legacy "Organiza" community logo tiles with
 * optional subtitle and footer motif (coral/teal/navy dots).
 */
import type { Language } from '@/lib/i18n';

interface Community {
  name: string;
  logo: string;
  url?: string;
}

interface Props {
  communities: Community[];
  lang: Language;
  title: string;
  subtitle?: string;
  footerNote?: string;
  logoSrc?: string;
  headingLevel?: 'h2' | 'h3';
}

const {
  communities,
  lang,
  title,
  subtitle,
  footerNote,
  logoSrc,
  headingLevel = 'h2',
} = Astro.props;
const Heading = headingLevel;

const visitLabel = lang === 'es' ? 'Visitar' : 'Visit';
const logoAlt = lang === 'es' ? 'Pereira Tech Talks' : 'Pereira Tech Talks';
---

<div class="ptd-communities-organiza">
  <header class="mb-8 text-center md:mb-10">
    {
      logoSrc && (
        <img
          src={logoSrc}
          alt={logoAlt}
          width="64"
          height="64"
          class="mx-auto mb-3 h-12 w-auto opacity-90"
          loading="lazy"
          decoding="async"
        />
      )
    }
    <Heading class="ptd-organiza-title text-3xl font-bold text-[var(--ptt-text)] md:text-4xl">
      {title}
    </Heading>
    {
      subtitle && (
        <p class="mx-auto mt-3 max-w-2xl text-sm text-[var(--ptt-text-muted)] md:text-base">
          {subtitle}
        </p>
      )
    }
  </header>

  <ul class="mx-auto grid w-full max-w-5xl grid-cols-2 gap-4 sm:grid-cols-3 sm:gap-5 lg:grid-cols-4 lg:gap-6">
    {
      communities.map((community) => (
        <li class="min-w-0">
          {
            community.url ? (
              <a
                href={community.url}
                target="_blank"
                rel="noopener noreferrer"
                aria-label={`${visitLabel} ${community.name}`}
                class="flex min-h-40 items-center justify-center rounded-2xl bg-[var(--ptt-bg-elevated)] px-4 py-5 shadow-sm ring-1 ring-[var(--ptt-border)] transition duration-200 hover:-translate-y-1 hover:shadow-md focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[var(--ptt-primary)] motion-reduce:transition-none motion-reduce:hover:translate-y-0 sm:min-h-44 sm:px-5 sm:py-6"
              >
                <img
                  src={community.logo}
                  alt={community.name}
                  width="200"
                  height="200"
                  loading="lazy"
                  decoding="async"
                  class="max-h-28 w-auto max-w-full object-contain sm:max-h-32"
                />
              </a>
            ) : (
              <div class="flex min-h-40 items-center justify-center rounded-2xl bg-[var(--ptt-bg-elevated)] px-4 py-5 shadow-sm ring-1 ring-[var(--ptt-border)] sm:min-h-44 sm:px-5 sm:py-6">
                <img
                  src={community.logo}
                  alt={community.name}
                  width="200"
                  height="200"
                  loading="lazy"
                  decoding="async"
                  class="max-h-28 w-auto max-w-full object-contain sm:max-h-32"
                />
              </div>
            )
          }
        </li>
      ))
    }
  </ul>

  {
    footerNote && (
      <p class="mt-10 flex justify-center">
        <span class="inline-flex items-center gap-2 rounded-full bg-[var(--ptt-bg-elevated)] px-4 py-2 text-sm text-[var(--ptt-text-muted)] ring-1 ring-[var(--ptt-border)]">
          <span class="h-2 w-2 rounded-full bg-[var(--ptt-accent)]" aria-hidden="true" />
          <span class="h-2 w-2 rounded-full bg-[var(--ptt-primary)]" aria-hidden="true" />
          <span class="h-2 w-2 rounded-full bg-[var(--ptt-text)]" aria-hidden="true" />
          <span class="ml-1">{footerNote}</span>
        </span>
      </p>
    )
  }
</div>

<style>
  .ptd-organiza-title {
    font-family: Bebas Neue, 'Arial Black', sans-serif;
    letter-spacing: 0.04em;
  }
</style>
