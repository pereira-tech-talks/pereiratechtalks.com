---
/**
 * PtdHero2024 — centered "Pereira•Tech•Day" wordmark intro for completed
 * Pereira Tech Day editions (legacy `/pereira-tech-day/2024/` photocopy).
 * Cream/navy/coral kit colors + Bebas heading font come from the edition's
 * `brandKit` via `[data-edition-theme]` (see `buildEditionThemeCss`).
 */
import type { Language } from '@/lib/i18n';

interface Props {
  lang: Language;
  year: number;
  title: string;
  tagline: string;
  dateLabel: string;
  startDate: string;
  venueName: string;
  venueMapUrl?: string;
  heroSrc: string;
  logoSrc?: string;
  recordingUrl?: string;
  recordingCta: string;
}

const {
  title,
  tagline,
  dateLabel,
  startDate,
  venueName,
  venueMapUrl,
  heroSrc,
  logoSrc,
  recordingUrl,
  recordingCta,
} = Astro.props;
---

<header class="relative overflow-hidden bg-[var(--ptt-bg)] text-[var(--ptt-text)]">
  {
    heroSrc && (
      <div class="absolute inset-0 opacity-10" aria-hidden="true">
        <img
          src={heroSrc}
          alt=""
          width="1920"
          height="640"
          class="h-full w-full object-cover"
        />
      </div>
    )
  }
  <div
    class="absolute inset-0 bg-gradient-to-b from-[var(--ptt-primary)]/10 via-[var(--ptt-bg)]/95 to-[var(--ptt-bg)]"
    aria-hidden="true"
  >
  </div>
  <div class="relative main-container flex flex-col items-center py-16 text-center sm:py-24">
    {
      logoSrc && (
        <img
          src={logoSrc}
          alt=""
          width="120"
          height="199"
          class="mb-6 h-auto w-20 sm:w-24"
        />
      )
    }
    <time
      datetime={startDate}
      class="text-sm font-bold uppercase tracking-widest text-[var(--ptt-text-muted)]"
    >
      {dateLabel}.
    </time>
    <h1 class="mt-3 text-4xl font-bold uppercase leading-none text-[var(--ptt-primary)] sm:text-5xl lg:text-6xl">
      <span class="sr-only">{title}</span>
      <span aria-hidden="true">Pereira•Tech•Day</span>
    </h1>
    {
      venueName && (
        <p class="mt-4 flex items-center gap-1.5 text-base font-bold uppercase text-[var(--ptt-primary)]">
          <svg
            aria-hidden="true"
            class="h-5 w-5 shrink-0 text-[var(--ptt-accent)]"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <path d="M9 11a3 3 0 1 0 6 0a3 3 0 0 0-6 0" />
            <path d="M17.657 16.657L13.414 20.9a2 2 0 0 1-2.827 0l-4.244-4.243a8 8 0 1 1 11.314 0" />
          </svg>
          {
            venueMapUrl ? (
              <a
                href={venueMapUrl}
                target="_blank"
                rel="noopener noreferrer"
                class="underline-offset-2 hover:underline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[var(--ptt-primary)]"
              >
                {venueName}
              </a>
            ) : (
              venueName
            )
          }
        </p>
      )
    }
    <p class="mt-6 max-w-2xl text-lg text-[var(--ptt-text)]/80">{tagline}</p>
    {
      recordingUrl && (
        <div class="mt-8">
          <a
            href={recordingUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center rounded-full bg-[var(--ptt-primary)] px-6 py-3 text-sm font-semibold text-white transition hover:opacity-90 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[var(--ptt-primary)]"
          >
            {recordingCta}
          </a>
        </div>
      )
    }
  </div>
</header>
