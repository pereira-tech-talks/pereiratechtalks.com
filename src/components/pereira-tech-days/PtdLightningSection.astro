---
/**
 * PtdLightningSection — matches legacy `/pereira-tech-day/2024/` lightning grid:
 * elevated outline cards, title on top, then 80px avatar + name/role + social icons below.
 */
import type { CollectionEntry } from 'astro:content';
import { type Language, tr } from '@/lib/i18n';
import type { NormalizedLightningTalk } from '@/lib/pereiraTechDay';

interface Props {
  lang: Language;
  title: string;
  tagline?: string;
  talks: NormalizedLightningTalk[];
  speakers: CollectionEntry<'speakers'>[];
  /**
   * Placeholder copy for upcoming editions whose lightning line-up is not
   * announced yet. When set and `talks` is empty the section still renders,
   * showing ghost cards instead of hiding the whole block.
   */
  pending?: {
    message: string;
    cardLabel: string;
    ctaLabel?: string;
    ctaHref?: string;
  };
  /** Number of ghost cards drawn in the pending state. */
  pendingSlots?: number;
}

const {
  lang,
  title,
  tagline,
  talks,
  speakers,
  pending,
  pendingSlots = 3,
} = Astro.props;
const speakerBySlug = new Map(speakers.map((speaker) => [speaker.id, speaker]));
const showPending = talks.length === 0 && Boolean(pending);
const ghostSlots = Array.from({ length: pendingSlots }, (_, i) => i);

function socialLinksFor(speaker: CollectionEntry<'speakers'>) {
  const social = speaker.data.social ?? {};
  return (
    [
      {
        key: 'linkedin',
        href: social.linkedin,
        label: `${speaker.data.name} on LinkedIn`,
        path: 'M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.852 3.37-1.852 3.601 0 4.267 2.37 4.267 5.455v6.288zM5.337 7.433a2.062 2.062 0 01-2.063-2.065 2.063 2.063 0 112.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z',
      },
      {
        key: 'twitter',
        href: social.twitter,
        label: `${speaker.data.name} on X`,
        path: 'M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z',
      },
      {
        key: 'github',
        href: social.github,
        label: `${speaker.data.name} on GitHub`,
        path: 'M12 .297c-6.63 0-12 5.373-12 12 0 5.303 3.438 9.8 8.205 11.385.6.113.82-.258.82-.577 0-.285-.01-1.04-.015-2.04-3.338.724-4.042-1.61-4.042-1.61C4.422 18.07 3.633 17.7 3.633 17.7c-1.087-.744.084-.729.084-.729 1.205.084 1.838 1.236 1.838 1.236 1.07 1.835 2.809 1.305 3.495.998.108-.776.417-1.305.76-1.605-2.665-.3-5.466-1.332-5.466-5.93 0-1.31.465-2.38 1.235-3.22-.135-.303-.54-1.523.105-3.176 0 0 1.005-.322 3.3 1.23.96-.267 1.98-.4 3-.405 1.02.005 2.04.138 3 .405 2.28-1.552 3.285-1.23 3.285-1.23.645 1.653.24 2.873.12 3.176.765.84 1.23 1.91 1.23 3.22 0 4.61-2.805 5.625-5.475 5.92.42.36.81 1.096.81 2.22 0 1.606-.015 2.896-.015 3.286 0 .315.21.69.825.57C20.565 22.092 24 17.592 24 12.297c0-6.627-5.373-12-12-12',
      },
      {
        key: 'website',
        href: social.website,
        label: `${speaker.data.name} website`,
        path: null as string | null,
      },
    ] as const
  ).filter((link) => Boolean(link.href));
}
---

<section
  id="lightning"
  class="scroll-mt-[4.5rem] bg-[var(--ptt-bg)] py-[var(--ptd-section-pad)]"
  aria-labelledby="ptd-lightning-title"
>
  <div class="main-container">
    <header class="mx-auto mb-8 max-w-3xl text-center md:mb-12">
      {
        tagline && (
          <p class="text-base font-bold uppercase tracking-wide text-[var(--ptt-text-muted)]">
            {tagline}
          </p>
        )
      }
      <h2
        id="ptd-lightning-title"
        class="ptd-lightning-title mt-1 text-3xl font-bold uppercase leading-none text-[var(--ptt-text)] md:text-4xl"
      >
        {title}
      </h2>
      {
        showPending && pending && (
          <p class="mt-4 text-base leading-relaxed text-[var(--ptt-text)]">
            {pending.message}
          </p>
        )
      }
    </header>

    {
      showPending && pending && (
        <>
          <ul class="grid gap-4 sm:grid-cols-2 sm:gap-y-8 md:gap-6 lg:grid-cols-3">
            {ghostSlots.map((index) => (
              <li class="min-w-0">
                <article class="flex h-full flex-col items-center rounded-lg border border-dashed border-[color-mix(in_srgb,var(--ptt-text)_26%,transparent)] bg-[color-mix(in_srgb,var(--ptt-bg-elevated)_55%,transparent)] p-6 text-center">
                  <span
                    class="grid h-16 w-16 place-items-center rounded-full border border-dashed border-[color-mix(in_srgb,var(--ptt-text)_26%,transparent)] bg-[color-mix(in_srgb,var(--ptt-text)_7%,transparent)] text-[color-mix(in_srgb,var(--ptt-text)_40%,transparent)]"
                    aria-hidden="true"
                  >
                    <svg viewBox="0 0 24 24" width="26" height="26" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                      <path d="M13 2 4 14h6l-1 8 9-12h-6l1-8Z" />
                    </svg>
                  </span>
                  <p class="mt-4 text-lg font-bold leading-snug text-[var(--ptt-text)]">
                    {`${pending.cardLabel} ${index + 1}`}
                  </p>
                  <p class="mt-1 text-sm italic text-[var(--ptt-text-muted)]">
                    {pending.message}
                  </p>
                </article>
              </li>
            ))}
          </ul>
          {pending.ctaLabel && pending.ctaHref && (
            <p class="mt-8 text-center">
              <a
                href={pending.ctaHref}
                class="inline-flex items-center gap-1.5 rounded-full border border-[color-mix(in_srgb,var(--ptt-text)_22%,transparent)] px-5 py-2.5 text-sm font-bold uppercase tracking-wide text-[var(--ptt-text)] transition hover:border-[var(--ptt-primary)] hover:bg-[var(--ptt-primary)] hover:text-white focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[var(--ptt-primary)]"
              >
                {pending.ctaLabel}
              </a>
            </p>
          )}
        </>
      )
    }

    <ul
      class="grid gap-4 sm:grid-cols-2 sm:gap-y-8 md:gap-6 lg:grid-cols-3"
      hidden={talks.length === 0}
    >
      {
        talks.map((entry) => {
          const speaker = speakerBySlug.get(entry.speaker);
          if (!speaker) return null;
          const talkTitle = tr(entry.title, lang);
          const role = tr(speaker.data.role, lang);
          const photoAlt =
            tr(speaker.data.photo.alt, lang) ||
            `Portrait of ${speaker.data.name}`;
          const links = socialLinksFor(speaker);
          return (
            <li class="min-w-0">
              <article class="relative flex h-full flex-col rounded-lg border border-[#ffffff29] bg-[var(--ptt-bg-elevated)] p-6 shadow-[0_4px_30px_rgba(0,0,0,0.1)] backdrop-blur">
                <p class="flex-1 text-xl font-bold leading-snug text-[var(--ptt-text)]">
                  {talkTitle || speaker.data.name}
                </p>
                <div class="mt-4 flex items-center gap-2">
                  <img
                    decoding="async"
                    src={speaker.data.photo.src}
                    alt={photoAlt}
                    width="80"
                    height="80"
                    loading="lazy"
                    class="h-20 w-20 shrink-0 rounded-full border border-slate-600 object-cover"
                  />
                  <div class="ml-3 min-w-0 grow">
                    <p class="text-base font-semibold text-[var(--ptt-text)]">
                      {speaker.data.name}
                    </p>
                    <p class="text-xs text-[var(--ptt-text-muted)]">{role}</p>
                    {
                      links.length > 0 && (
                        <ul class="inline-flex flex-wrap gap-1 pt-1">
                          {links.map((link) => (
                            <li>
                              <a
                                href={link.href}
                                target="_blank"
                                rel="noopener noreferrer"
                                class="inline-flex text-[var(--ptt-text-muted)] transition hover:text-[var(--ptt-text)] focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[var(--ptt-primary)]"
                                aria-label={link.label}
                              >
                                {link.path ? (
                                  <svg
                                    aria-hidden="true"
                                    class="h-7 w-7"
                                    fill="currentColor"
                                    viewBox="0 0 24 24"
                                  >
                                    <path d={link.path} />
                                  </svg>
                                ) : (
                                  <svg
                                    aria-hidden="true"
                                    class="h-7 w-7"
                                    fill="none"
                                    stroke="currentColor"
                                    stroke-width="2"
                                    viewBox="0 0 24 24"
                                  >
                                    <path
                                      stroke-linecap="round"
                                      stroke-linejoin="round"
                                      d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"
                                    />
                                  </svg>
                                )}
                              </a>
                            </li>
                          ))}
                        </ul>
                      )
                    }
                  </div>
                </div>
              </article>
            </li>
          );
        })
      }
    </ul>
  </div>
</section>

<style>
  .ptd-lightning-title {
    font-family: Bebas Neue, 'Arial Black', sans-serif;
    letter-spacing: 0.06em;
  }
</style>
