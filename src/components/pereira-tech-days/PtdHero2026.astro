---
/**
 * Pereira Tech Day 2026 hero — full-viewport cream banner.
 * Full-bleed illustration; copy aligned to `.main-container`.
 */
import PtdCountdown from '@/components/pereira-tech-days/PtdCountdown.svelte';
import type { Language } from '@/lib/i18n';
import { getTranslations } from '@/lib/translations';

interface Props {
  lang: Language;
  year: number;
  title: string;
  tagline: string;
  eyebrow: string;
  dateLong: string;
  venueName: string;
  venueMapUrl?: string;
  expectedAttendance?: string;
  heroIllustration?: string;
  logoSrc?: string;
  /** @deprecated Legacy photocopy uses CSS-bg illustration only; ignored when illustration present. */
  mascotSrc?: string;
  targetDate: string;
  endDate?: string;
  /**
   * External registration URL (Luma). When set, shows the primary register CTA.
   * Callers must source this from `getEditionRegistrationUrl()`, which returns
   * `undefined` while the edition is postponed.
   */
  registrationUrl?: string;
  /** In-page anchor for the secondary "view schedule" CTA (e.g. `#schedule`). */
  scheduleAnchor?: string;
  /**
   * Postponed edition: the countdown is replaced by a status pill and the
   * announced date/venue are framed as what *was* planned. Set from
   * `isPostponedEdition(edition)` — never hardcode per year.
   */
  postponed?: boolean;
  /** Hides the countdown independently of `postponed` (see `hideSections`). */
  showCountdown?: boolean;
}

const {
  lang,
  title,
  tagline,
  eyebrow,
  dateLong,
  venueName,
  venueMapUrl,
  expectedAttendance,
  heroIllustration,
  logoSrc,
  targetDate,
  endDate,
  registrationUrl,
  scheduleAnchor,
  postponed = false,
  showCountdown = true,
} = Astro.props;

const t = getTranslations(lang);

/** Legacy: "Pereira Tech" / "Day" (coral) + "2026" (cyan). */
const titleWords = title.trim().split(/\s+/);
const dayWordIndex = titleWords.findIndex((word) => /^day$/i.test(word));
const titleLineTech =
  dayWordIndex > 0 ? titleWords.slice(0, dayWordIndex).join(' ') : title;
const dayWord = dayWordIndex >= 0 ? titleWords[dayWordIndex] : '';
const yearWord =
  dayWordIndex >= 0 ? titleWords.slice(dayWordIndex + 1).join(' ') : '';

/** Legacy tagline emphasizes the closing words in coral. */
const taglineWords = tagline.trim().split(/\s+/);
const taglineLead = taglineWords.slice(0, -2).join(' ');
const taglineEmphasis = taglineWords.slice(-2).join(' ');

const attendanceMatch = expectedAttendance?.match(/^(\S+)\s+(.+)$/);
const attendanceValue = attendanceMatch?.[1] ?? expectedAttendance;
const attendanceLabel = attendanceMatch?.[2] ?? '';

const logoAlt =
  lang === 'es' ? 'Logotipo de Pereira Tech Day' : 'Pereira Tech Day logo';

/** Year digit — WCAG AA on cream (≥3:1 large text); decorative glow may stay brighter. */
const YEAR_CYAN = '#127a82';
const CREAM = '#fef7f3';
---

<section
  class="ptd-hero-2026 relative isolate flex flex-col overflow-hidden text-[var(--ptt-text)] md:-mt-[4.75rem]"
  style={`--ptd-year-cyan: ${YEAR_CYAN}; --ptd-hero-cream: ${CREAM}; background-color: var(--ptt-bg, ${CREAM});`}
>
  {
    heroIllustration && (
      <>
        <div
          class="ptd-hero-2026__art pointer-events-none absolute inset-0 z-0 bg-no-repeat"
          style={`background-image: url('${heroIllustration}');`}
          aria-hidden="true"
        />
        <div class="ptd-hero-2026__fade pointer-events-none absolute inset-0 z-0" aria-hidden="true" />
      </>
    )
  }

  <div class="ptd-hero-2026__inner relative z-10 main-container flex min-h-0 w-full flex-1 flex-col justify-start lg:justify-center">
    <div
      class="flex w-full min-w-0 max-w-2xl flex-col items-start lg:max-w-[min(40rem,50%)]"
    >
      <p
        class="m-0 mb-2.5 text-[clamp(0.78rem,1.35vw,0.9rem)] font-bold uppercase tracking-[0.14em] text-[var(--ptt-accent)] sm:mb-3"
      >
        {postponed ? t.ptdPage.postponedBadge : eyebrow}
      </p>

      <div class="mb-3.5 flex w-full items-start gap-3 sm:mb-4 sm:gap-4">
        {
          logoSrc && (
            <img
              src={logoSrc}
              alt={logoAlt}
              width="80"
              height="98"
              class="ptd-hero-2026__logo mt-0.5 h-auto w-auto max-h-[5.25rem] shrink-0 object-contain object-left-top sm:max-h-[7rem] lg:max-h-[140px]"
              loading="eager"
              decoding="async"
            />
          )
        }
        <h1
          class="m-0 min-w-0 text-[clamp(2.05rem,5.6vw,5.1rem)] font-normal uppercase leading-[0.92] tracking-[0.04em]"
          style='font-family: "Bebas Neue", "Arial Black", sans-serif;'
        >
          <span class="block text-[var(--ptt-text)]">{titleLineTech}</span>
          {
            dayWord && (
              <span class="block">
                <span class="text-[var(--ptt-accent)]">{dayWord}</span>
                {yearWord ? (
                  <>
                    {' '}
                    <span class="text-[color:var(--ptd-year-cyan)]">{yearWord}</span>
                  </>
                ) : null}
              </span>
            )
          }
        </h1>
      </div>

      <p
        class="mb-5 w-full text-[clamp(1.05rem,2.5vw,1.35rem)] leading-snug text-[var(--ptt-text)] sm:mb-6"
      >
        {taglineLead ? `${taglineLead} ` : ''}
        <strong class="font-bold text-[var(--ptt-accent)]">{taglineEmphasis}</strong>
      </p>

      {
        /**
         * Postponed: the announced date, venue, and expected attendance are
         * withheld here rather than shown unqualified — the notice directly
         * below is the only thing the hero should be saying. All three come
         * back verbatim when `status` is restored.
         */
      }
      {
        !postponed && (
        <ul
          class="mb-5 flex max-w-full flex-col gap-2.5 text-lg leading-snug text-[var(--ptt-text)] sm:mb-6 sm:gap-3 sm:text-xl"
        >
          <li class="flex min-w-0 items-start gap-2.5">
            <svg
              aria-hidden="true"
              class="mt-0.5 h-6 w-6 shrink-0 text-[var(--ptt-text-muted)] sm:h-7 sm:w-7"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              viewBox="0 0 24 24"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                d="M8 2v3M16 2v3M3.5 9h17M4 5h16a1 1 0 011 1v13a1 1 0 01-1 1H4a1 1 0 01-1-1V6a1 1 0 011-1z"
              />
            </svg>
            <span class="min-w-0 break-words">{dateLong}</span>
          </li>
          <li class="flex min-w-0 items-start gap-2.5">
            <svg
              aria-hidden="true"
              class="mt-0.5 h-6 w-6 shrink-0 text-[var(--ptt-text-muted)] sm:h-7 sm:w-7"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              viewBox="0 0 24 24"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                d="M12 21s7-6.19 7-11.5A7 7 0 105 9.5C5 14.81 12 21 12 21z"
              />
              <circle cx="12" cy="9.5" r="2.5" stroke-linecap="round" stroke-linejoin="round" />
            </svg>
            {
              venueMapUrl ? (
                <a
                  href={venueMapUrl}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="min-w-0 break-words underline decoration-[var(--ptt-accent)] underline-offset-2 hover:text-[var(--ptt-primary)]"
                >
                  {venueName}
                </a>
              ) : (
                <span class="min-w-0 break-words">{venueName}</span>
              )
            }
          </li>
        </ul>
        )
      }

      {
        !postponed && attendanceValue && (
          <p class="mb-5 flex items-center gap-2.5 text-[var(--ptt-text)] sm:mb-6">
            <svg
              aria-hidden="true"
              class="h-6 w-6 shrink-0 text-[var(--ptt-accent)] sm:h-7 sm:w-7"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              viewBox="0 0 24 24"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                d="M17 20v-1a4 4 0 00-4-4H7a4 4 0 00-4 4v1M9 11a4 4 0 100-8 4 4 0 000 8zM23 20v-1a4 4 0 00-3-3.87M16 3.13a4 4 0 010 7.75"
              />
            </svg>
            <span class="text-xl font-bold tabular-nums sm:text-2xl">{attendanceValue}</span>
            {
              attendanceLabel && (
                <span class="text-lg text-[var(--ptt-text-muted)] sm:text-xl">
                  {attendanceLabel}
                </span>
              )
            }
          </p>
        )
      }

      {
        (registrationUrl || scheduleAnchor) && (
          <div class="mb-6 flex w-full flex-col items-stretch justify-center gap-3 sm:mb-7 sm:w-auto sm:flex-row sm:items-center sm:gap-4">
            {registrationUrl && (
              <a
                href={registrationUrl}
                target="_blank"
                rel="noopener noreferrer"
                class="ptd-hero-2026__cta inline-flex w-full items-center justify-center gap-2 rounded-full bg-[var(--ptt-primary)] px-9 py-3.5 text-lg font-bold tracking-wide text-white transition-[transform,opacity,box-shadow] hover:opacity-95 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[var(--ptt-primary)] active:scale-[0.98] sm:w-auto sm:px-11 sm:py-4 sm:text-xl"
              >
                {t.ptdPage.registerCta}
                <svg
                  aria-hidden="true"
                  class="h-5 w-5 shrink-0 sm:h-6 sm:w-6"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2.25"
                  viewBox="0 0 24 24"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    d="M5 12h14M13 6l6 6-6 6"
                  />
                </svg>
              </a>
            )}
            {scheduleAnchor && (
              <a
                href={scheduleAnchor}
                class="ptd-hero-2026__cta-secondary inline-flex w-full items-center justify-center gap-2 rounded-full border-2 border-[var(--ptt-primary)] px-9 py-3.5 text-lg font-bold tracking-wide text-[color-mix(in_srgb,var(--ptt-primary)_85%,var(--ptt-text))] transition-[transform,background-color,color] hover:bg-[var(--ptt-primary)] hover:text-white focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[var(--ptt-primary)] active:scale-[0.98] sm:w-auto sm:px-9 sm:py-4 sm:text-xl"
              >
                <svg
                  aria-hidden="true"
                  class="h-5 w-5 shrink-0 sm:h-6 sm:w-6"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  viewBox="0 0 24 24"
                >
                  <path d="M8 2v4M16 2v4M3 10h18M5 6h14a2 2 0 0 1 2 2v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2Z" />
                </svg>
                {t.ptdPage.scheduleAnchorCta}
              </a>
            )}
          </div>
        )
      }

      {
        /**
         * A countdown to a date that is no longer happening is the single most
         * misleading element on the page, so it is replaced by a status pill
         * rather than merely frozen. Restoring `status` restores the counter.
         */
      }
      {
        postponed ? (
          <p
            class="m-0 inline-flex items-center gap-2.5 rounded-full border-2 border-[var(--ptt-accent)] bg-[var(--ptt-bg-elevated)] px-6 py-3 text-base font-bold uppercase tracking-[0.08em] text-[var(--ptt-accent)] sm:text-lg"
          >
            <svg
              aria-hidden="true"
              class="h-5 w-5 shrink-0 sm:h-6 sm:w-6"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              viewBox="0 0 24 24"
            >
              <circle cx="12" cy="12" r="9" />
              <path d="M12 7v5l3 2" />
            </svg>
            {t.ptdPage.postponedHeroBadge}
          </p>
        ) : (
          showCountdown && (
            <div class="w-full max-w-xl">
              <PtdCountdown client:visible lang={lang} targetDate={targetDate} endDate={endDate} />
            </div>
          )
        )
      }

      {
        heroIllustration && (
          <div class="mt-8 w-full sm:hidden" aria-hidden="true">
            <img
              src="/images/pereira-tech-days/2026/hero-illustration-mobile.webp"
              alt=""
              width="960"
              height="510"
              class="mx-auto max-h-64 w-auto object-contain"
              loading="eager"
              decoding="async"
            />
          </div>
        )
      }
    </div>
  </div>
</section>

<style>
  /* Fill the viewport (section pulls under sticky chrome via -mt on md+). */
  .ptd-hero-2026 {
    min-height: 100svh;
    min-height: 100dvh;
  }

  @media (min-width: 1024px) {
    .ptd-hero-2026 {
      /* Lock desktop first screen; allow grow only if content overflows. */
      min-height: 100dvh;
    }
  }

  /* Illustration — dominant but not overwhelming; mild shrink only at wide desktops. */
  .ptd-hero-2026__art {
    background-position: 100% 48%;
    background-size: auto 90%;
  }

  .ptd-hero-2026__fade {
    background:
      linear-gradient(
        to right,
        var(--ptt-bg, #fef7f3) 0%,
        var(--ptt-bg, #fef7f3) 34%,
        color-mix(in srgb, var(--ptt-bg, #fef7f3) 95%, transparent) 40%,
        color-mix(in srgb, var(--ptt-bg, #fef7f3) 78%, transparent) 45%,
        color-mix(in srgb, var(--ptt-bg, #fef7f3) 45%, transparent) 50%,
        transparent 56%
      ),
      /* Soft top wash under glass header — art still readable through chrome. */
      linear-gradient(
        to bottom,
        color-mix(in srgb, var(--ptt-bg, #fef7f3) 55%, transparent) 0%,
        color-mix(in srgb, var(--ptt-bg, #fef7f3) 22%, transparent) 10%,
        transparent 20%
      ),
      linear-gradient(
        to top,
        var(--ptt-bg, #fef7f3) 0%,
        color-mix(in srgb, var(--ptt-bg, #fef7f3) 92%, transparent) 6%,
        color-mix(in srgb, var(--ptt-bg, #fef7f3) 55%, transparent) 12%,
        transparent 18%
      );
  }

  @media (min-width: 1280px) {
    .ptd-hero-2026__art {
      background-position: 102% 46%;
      background-size: auto 88%;
    }
  }

  @media (min-width: 1536px) {
    .ptd-hero-2026__art {
      background-position: 103% 44%;
      background-size: auto 86%;
    }
  }

  @media (max-width: 1023px) {
    /* Below lg: no side-art wash (copy stays crisp). Narrow phones get the
       inline monkey via `sm:hidden`; tablet widths stay illustration-free. */
    .ptd-hero-2026__art {
      display: none;
    }

    .ptd-hero-2026__fade {
      display: none;
    }
  }

  /* White cup mark → coral, matching legacy ptd-intro__brand-logo-image filter */
  .ptd-hero-2026__logo {
    filter: brightness(0) saturate(100%) invert(66%) sepia(68%) saturate(1269%)
      hue-rotate(309deg) brightness(95%) contrast(98%);
  }

  .ptd-hero-2026__cta {
    box-shadow:
      0 0 0 3px color-mix(in srgb, var(--ptd-year-cyan, #3ab9c9) 35%, transparent),
      0 10px 28px -6px color-mix(in srgb, var(--ptt-primary) 55%, transparent);
  }

  .ptd-hero-2026__cta:hover {
    box-shadow:
      0 0 0 4px color-mix(in srgb, var(--ptd-year-cyan, #3ab9c9) 45%, transparent),
      0 14px 32px -6px color-mix(in srgb, var(--ptt-primary) 65%, transparent);
  }

  @media (prefers-reduced-motion: reduce) {
    .ptd-hero-2026__cta {
      transition: none;
    }

    .ptd-hero-2026__cta:active {
      transform: none;
    }
  }

  /* Own vertical rhythm; neutralize `.main-container` py-4. */
  .ptd-hero-2026 :global(.main-container) {
    padding-top: 1.25rem;
    padding-bottom: 1.75rem;
  }

  @media (min-width: 768px) {
    .ptd-hero-2026 :global(.main-container) {
      padding-top: 5.25rem;
      padding-bottom: 2.5rem;
    }
  }

  @media (min-width: 1024px) {
    .ptd-hero-2026 :global(.main-container) {
      padding-top: 5.5rem;
      padding-bottom: 2.75rem;
    }
  }
</style>
