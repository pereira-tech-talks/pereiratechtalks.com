---
/**
 * PtdTeamGrid — organizers / collaborators portraits.
 * - brochure: left teal Bebas title + circular photos (legacy 2026 photocopy)
 * - default tiles: centered title; circle or square portraits
 */
import type { CollectionEntry } from 'astro:content';
import type { Language } from '@/lib/i18n';

interface Props {
  contributors: CollectionEntry<'contributors'>[];
  lang: Language;
  title?: string;
  subtitle?: string;
  headingLevel?: 'h2' | 'h3';
  /** `circle` keeps round portraits; `square` is the archived-card look. */
  portraitStyle?: 'circle' | 'square';
  /** Upcoming brochure chrome: left teal title, soft circular discs. */
  brochure?: boolean;
  /** Wrap content in a frosted card (legacy team blocks). */
  framed?: boolean;
}

const {
  contributors,
  lang,
  title,
  subtitle,
  headingLevel = 'h2',
  portraitStyle = 'square',
  brochure = false,
  framed = false,
} = Astro.props;
const Heading = headingLevel;
const useCircle = brochure || portraitStyle === 'circle';

const profileLabel = lang === 'es' ? 'Visitar perfil de' : 'Visit profile of';
---

<div
  class:list={[
    'ptd-team-grid',
    framed &&
      'rounded-[1.25rem] border border-[color-mix(in_srgb,var(--ptt-text)_10%,white_90%)] bg-[color-mix(in_srgb,white_88%,transparent)] p-[clamp(1.15rem,3.2vw,1.8rem)] shadow-[0_12px_28px_color-mix(in_srgb,var(--ptt-text)_8%,transparent)]',
  ]}
  data-layout={brochure ? 'brochure' : 'tiles'}
>
  {
    title && (
      <header
        class:list={[
          brochure
            ? 'mb-4'
            : 'mb-8 text-center md:mb-10',
        ]}
      >
        <Heading
          class:list={[
            'ptd-team-title m-0 font-bold uppercase leading-[1.05]',
            brochure
              ? 'text-[clamp(1.8rem,5vw,2.6rem)] tracking-[0.01em] text-[#3a7f7c]'
              : 'text-3xl text-[var(--ptt-text)] md:text-4xl',
          ]}
        >
          {title}
        </Heading>
        {subtitle && (
          <p
            class:list={[
              'm-0',
              brochure
                ? 'mt-2 max-w-[36rem] text-[clamp(0.9rem,2vw,1rem)] leading-normal text-[color-mix(in_srgb,var(--ptt-text)_80%,transparent)]'
                : 'mx-auto mt-3 max-w-2xl text-sm text-[var(--ptt-text-muted)] md:text-base',
            ]}
          >
            {subtitle}
          </p>
        )}
      </header>
    )
  }

  <ul
    class:list={[
      'm-0 flex list-none flex-wrap justify-center p-0',
      brochure
        ? 'gap-x-[clamp(0.75rem,2.2vw,1.1rem)] gap-y-[clamp(1.35rem,3.5vw,2rem)]'
        : 'gap-x-5 gap-y-8 sm:gap-x-6 sm:gap-y-10 lg:gap-x-8',
    ]}
    role="list"
  >
    {
      contributors.map((contributor) => {
        const linkedin = contributor.data.social?.linkedin;
        const imgClass = useCircle
          ? brochure
            ? 'ptd-team-photo !h-[clamp(6.25rem,14vw,8.5rem)] !w-[clamp(6.25rem,14vw,8.5rem)] !rounded-full !object-cover aspect-square border-2 border-[color-mix(in_srgb,var(--ptt-text)_18%,white_82%)]'
            : 'mb-3 h-28 w-28 rounded-full object-cover sm:mb-3.5 sm:h-32 sm:w-32 md:h-36 md:w-36'
          : 'mb-3 h-28 w-28 rounded-xl object-cover shadow-sm ring-1 ring-[var(--ptt-border)] sm:mb-3.5 sm:h-32 sm:w-32 md:h-36 md:w-36';

        const nameClass = brochure
          ? 'ptd-team-name mt-3 max-w-[11rem] text-center text-[clamp(0.88rem,1.9vw,1.05rem)] font-semibold leading-snug text-[var(--ptt-text)]'
          : 'max-w-[10rem] text-sm font-medium leading-snug text-[var(--ptt-text)] sm:text-base';

        const itemClass = brochure
          ? 'ptd-team-item flex w-[calc((100%-clamp(0.9rem,2.8vw,1.25rem))/2)] max-w-full basis-[calc((100%-clamp(0.9rem,2.8vw,1.25rem))/2)] justify-center sm:w-[calc((100%-clamp(0.9rem,2.8vw,1.25rem)*2)/3)] sm:basis-[calc((100%-clamp(0.9rem,2.8vw,1.25rem)*2)/3)] lg:w-[calc((100%-clamp(0.9rem,2.8vw,1.25rem)*4)/5)] lg:basis-[calc((100%-clamp(0.9rem,2.8vw,1.25rem)*4)/5)]'
          : 'flex w-[calc(50%-0.625rem)] flex-col items-center text-center sm:w-[calc(33.333%-1rem)] lg:w-[calc(20%-1.6rem)]';

        const body = (
          <>
            <img
              src={contributor.data.avatar}
              alt=""
              width="200"
              height="200"
              loading="lazy"
              decoding="async"
              class={imgClass}
            />
            <span class={nameClass}>{contributor.data.name}</span>
          </>
        );

        return (
          <li class={itemClass}>
            {linkedin ? (
              <a
                href={linkedin}
                target="_blank"
                rel="noopener noreferrer"
                title={`${profileLabel} ${contributor.data.name}`}
                class:list={[
                  brochure
                    ? 'ptd-team-card flex w-[min(100%,12rem)] flex-col items-center text-inherit no-underline transition-transform hover:-translate-y-0.5 focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-[var(--ptt-primary)]'
                    : 'rounded-xl focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-[var(--ptt-primary)]',
                ]}
              >
                {body}
              </a>
            ) : (
              <div
                class:list={[
                  brochure &&
                    'ptd-team-card flex w-[min(100%,12rem)] flex-col items-center',
                  !brochure && 'flex flex-col items-center',
                ]}
              >
                {body}
              </div>
            )}
          </li>
        );
      })
    }
  </ul>
</div>

<style is:global>
  .ptd-team-title {
    font-family: Bebas Neue, 'Arial Black', sans-serif;
    letter-spacing: 0.04em;
  }

  .ptd-team-grid--framed {
    border-radius: 1.25rem;
    border: 1px solid color-mix(in srgb, var(--ptt-text) 10%, #ffffff 90%);
    background: color-mix(in srgb, #ffffff 88%, transparent);
    box-shadow:
      0 12px 28px color-mix(in srgb, var(--ptt-text) 8%, transparent),
      0 1px 0 color-mix(in srgb, #ffffff 78%, transparent) inset;
    padding: clamp(1.15rem, 3.2vw, 1.8rem);
  }

  .ptd-team-item {
    flex: 0 1 calc((100% - clamp(0.9rem, 2.8vw, 1.25rem)) / 2);
  }

  @media (min-width: 700px) {
    .ptd-team-item {
      flex: 0 1 calc((100% - (clamp(0.9rem, 2.8vw, 1.25rem) * 2)) / 3);
    }
  }

  @media (min-width: 1100px) {
    .ptd-team-item {
      flex: 0 1 calc((100% - (clamp(0.9rem, 2.8vw, 1.25rem) * 4)) / 5);
    }
  }

  .ptd-team-photo {
    --ptd-team-photo-size: clamp(6.25rem, 14vw, 8.5rem);
    width: var(--ptd-team-photo-size) !important;
    height: var(--ptd-team-photo-size) !important;
    aspect-ratio: 1 / 1;
    border-radius: 50% !important;
    object-fit: cover !important;
    border: 2px solid color-mix(in srgb, var(--ptt-text) 18%, #ffffff 82%);
    box-shadow:
      0 0 28px color-mix(in srgb, #ffffff 95%, transparent),
      0 10px 20px color-mix(in srgb, var(--ptt-text) 12%, transparent);
    transition:
      transform 0.2s ease,
      box-shadow 0.2s ease;
  }

  /* Soft cream bloom — fades into the illustration, no hard pill edge */
  .ptd-team-name {
    position: relative;
    z-index: 0;
    isolation: isolate;
    padding: 0.45rem 1rem;
    border-radius: 999px;
    background: transparent;
  }

  .ptd-team-name::before {
    content: '';
    position: absolute;
    z-index: -1;
    inset: -0.65rem -1rem;
    border-radius: 999px;
    background: radial-gradient(
      ellipse 80% 78% at 50% 50%,
      #ffffff 0%,
      #fffefb 22%,
      color-mix(in srgb, var(--ptt-bg, #fef7f3) 88%, transparent) 48%,
      color-mix(in srgb, var(--ptt-bg, #fef7f3) 40%, transparent) 70%,
      transparent 100%
    );
    filter: blur(4px);
    pointer-events: none;
  }

  .ptd-team-card:hover .ptd-team-photo {
    transform: translateY(-2px);
    box-shadow:
      0 0 34px color-mix(in srgb, #ffffff 100%, transparent),
      0 14px 24px color-mix(in srgb, var(--ptt-text) 14%, transparent);
  }

  @media (prefers-reduced-motion: reduce) {
    .ptd-team-photo,
    .ptd-team-card:hover .ptd-team-photo {
      transition: none;
      transform: none;
    }
  }

  .ptd-team-section {
    --ptd-team-bg-height: calc(100vw * 576 / 1024);
    isolation: isolate;
    overflow: hidden;
    min-height: var(--ptd-team-bg-height);
    padding: clamp(2.25rem, 7vw, 4rem) 0 clamp(1.5rem, 4vw, 2.5rem);
    background: var(--ptt-bg, #fef7f3);
  }

  .ptd-team-section__bg {
    background-color: var(--ptt-bg, #fef7f3);
    background-image: var(--ptd-team-bg);
    background-repeat: no-repeat;
    background-size: 100% auto;
    background-position: center top;
  }

  .ptd-team-section__fade {
    background:
      linear-gradient(
        to bottom,
        var(--ptt-bg, #fef7f3) 0%,
        color-mix(in srgb, var(--ptt-bg, #fef7f3) 98%, transparent) 9%,
        color-mix(in srgb, var(--ptt-bg, #fef7f3) 78%, transparent) 16%,
        color-mix(in srgb, var(--ptt-bg, #fef7f3) 42%, transparent) 24%,
        transparent 35%
      ),
      linear-gradient(
        to top,
        var(--ptt-bg, #fef7f3) 0%,
        color-mix(in srgb, var(--ptt-bg, #fef7f3) 98%, transparent) 9%,
        color-mix(in srgb, var(--ptt-bg, #fef7f3) 78%, transparent) 16%,
        color-mix(in srgb, var(--ptt-bg, #fef7f3) 42%, transparent) 24%,
        transparent 35%
      );
  }
</style>
