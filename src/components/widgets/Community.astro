---
import Image from '~/components/common/Image.astro';
import Headline from '~/components/ui/Headline.astro';
import WidgetWrapper from '~/components/ui/WidgetWrapper.astro';
import type { Communities as Props } from '~/types';
const {
  title = '',
  subtitle = '',
  tagline = '',
  communities = [],
  id,
  isDark = false,
  classes = {},
  bg = await Astro.slots.render('bg'),
} = Astro.props;
---

<WidgetWrapper id={id} isDark={isDark} containerClass={`max-w-6xl mx-auto ${classes?.container ?? ''} lg:pb-0`} bg={bg}>
  <Headline title={title} subtitle={subtitle} tagline={tagline} />

  <div class="mx-auto grid max-w-5xl grid-cols-2 gap-6 sm:grid-cols-3 lg:grid-cols-5">
    {
      communities &&
        communities.map(
          (community) =>
            community && (
              <div class="flex min-h-40 items-center justify-center rounded-2xl border border-cyan-300/10 bg-slate-950/20 px-4 py-5 shadow-[0_0_0_1px_rgba(255,255,255,0.02)_inset] transition-transform duration-200 hover:-translate-y-1 hover:border-cyan-300/25 dark:bg-slate-900/20">
                <a
                  class="flex h-full w-full items-center justify-center text-center"
                  target="_blank"
                  href={community.socialLink}
                >
                  <Image
                    src={community.image}
                    alt={community.name || ''}
                    class="max-h-28 w-auto max-w-full object-contain sm:max-h-32"
                  />
                </a>
              </div>
            )
        )
    }
  </div>
</WidgetWrapper>
