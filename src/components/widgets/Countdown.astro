---
import Headline from '~/components/ui/Headline.astro';

export interface Props {
  title?: string;
  subtitle?: string;
  tagline?: string;
  targetDate: string; // ISO 8601 format: '2026-09-21T07:00:00'
  id?: string;
  classes?: Record<string, string>;
  numberColor?: string;
}

const {
  title = '',
  subtitle = '',
  tagline = '',
  targetDate,
  id,
  classes = {},
  numberColor = '',
} = Astro.props;
---

<div id={id} class={`countdown-wrapper ${classes?.container ?? ''}`} style={numberColor ? `--countdown-color: ${numberColor};` : ''}>
  {(title || subtitle || tagline) && (
    <Headline title={title} subtitle={subtitle} tagline={tagline} classes={{ container: 'text-center' }} />
  )}

  <div class="countdown-container">
    <div class="countdown-grid">
      <div class="countdown-item">
        <div class="countdown-value" id="days">0</div>
        <div class="countdown-label">Días</div>
      </div>
      <div class="countdown-separator">:</div>
      <div class="countdown-item">
        <div class="countdown-value" id="hours">0</div>
        <div class="countdown-label">Horas</div>
      </div>
      <div class="countdown-separator">:</div>
      <div class="countdown-item">
        <div class="countdown-value" id="minutes">0</div>
        <div class="countdown-label">Minutos</div>
      </div>
      <div class="countdown-separator">:</div>
      <div class="countdown-item">
        <div class="countdown-value" id="seconds">0</div>
        <div class="countdown-label">Segundos</div>
      </div>
    </div>
    <div id="countdown-message" class="countdown-message hidden">
      ¡El evento ha comenzado! 🎉
    </div>
  </div>
</div>

<script is:inline define:vars={{ targetDate }}>
  let tickCounter = 0;
  const randomGlitchInterval = () => Math.floor(Math.random() * 5) + 1;
  let nextGlitchTick = randomGlitchInterval();

  const triggerRandomCardGlitch = () => {
    const items = Array.from(document.querySelectorAll('.countdown-item'));
    if (!items.length) return;

    const shuffled = items.sort(() => Math.random() - 0.5);
    const picks = Math.min(items.length, Math.random() < 0.55 ? 1 : 2);

    for (let i = 0; i < picks; i += 1) {
      const item = shuffled[i];
      const value = item?.querySelector('.countdown-value');
      if (!item) continue;

      item.classList.remove('is-glitching-card');
      if (value) value.classList.remove('is-glitching');

      void item.offsetWidth;

      item.classList.add('is-glitching-card');
      if (value) value.classList.add('is-glitching');

      window.setTimeout(() => {
        item.classList.remove('is-glitching-card');
        if (value) value.classList.remove('is-glitching');
      }, 340);
    }
  };

  function updateCountdown() {
    const now = new Date().getTime();
    const target = new Date(targetDate).getTime();
    const distance = target - now;

    const daysElement = document.getElementById('days');
    const hoursElement = document.getElementById('hours');
    const minutesElement = document.getElementById('minutes');
    const secondsElement = document.getElementById('seconds');
    const messageElement = document.getElementById('countdown-message');
    const gridElement = document.querySelector('.countdown-grid');

    const setValueWithGlitch = (element, nextValue) => {
      if (!element) return;
      const previousValue = element.textContent ?? '';
      if (previousValue === nextValue) return;

      element.textContent = nextValue;
      element.setAttribute('data-text', nextValue);
    };

    if (distance < 0) {
      if (gridElement) gridElement.classList.add('hidden');
      if (messageElement) messageElement.classList.remove('hidden');
      return;
    }

    const days = Math.floor(distance / (1000 * 60 * 60 * 24));
    const hours = Math.floor((distance % (1000 * 60 * 60 * 24)) / (1000 * 60 * 60));
    const minutes = Math.floor((distance % (1000 * 60 * 60)) / (1000 * 60));
    const seconds = Math.floor((distance % (1000 * 60)) / 1000);

    setValueWithGlitch(daysElement, String(days).padStart(2, '0'));
    setValueWithGlitch(hoursElement, String(hours).padStart(2, '0'));
    setValueWithGlitch(minutesElement, String(minutes).padStart(2, '0'));
    setValueWithGlitch(secondsElement, String(seconds).padStart(2, '0'));

    tickCounter += 1;
    if (tickCounter >= nextGlitchTick) {
      triggerRandomCardGlitch();
      nextGlitchTick = tickCounter + randomGlitchInterval();
    }
  }

  // Actualizar inmediatamente
  updateCountdown();

  // Actualizar cada segundo
  const interval = setInterval(updateCountdown, 1000);

  // Limpiar el intervalo cuando la página se descarga
  window.addEventListener('beforeunload', () => {
    clearInterval(interval);
  });
</script>

<style>
  .countdown-wrapper {
    position: relative;
    max-width: 62rem;
    margin-inline: auto;
  }

  .countdown-container {
    padding: 1.1rem 0.45rem 0.45rem;
  }

  .countdown-grid {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 0.8rem;
    flex-wrap: nowrap;
  }

  @media (min-width: 640px) {
    .countdown-grid {
      gap: 1.15rem;
    }
  }

  @media (min-width: 1024px) {
    .countdown-grid {
      gap: 1.35rem;
    }
  }

  .countdown-item {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.4rem;
    min-width: 4.15rem;
    padding: 0.8rem 0.65rem;
    border-radius: 0.95rem;
    border: 1px solid rgba(103, 232, 249, 0.2);
    background: linear-gradient(180deg, rgba(15, 23, 42, 0.5) 0%, rgba(2, 18, 29, 0.7) 100%);
    box-shadow: 0 10px 26px rgba(2, 132, 199, 0.18), inset 0 0 0 1px rgba(34, 211, 238, 0.08);
    backdrop-filter: blur(8px);
    overflow: hidden;
  }

  .countdown-item::before,
  .countdown-item::after {
    content: '';
    position: absolute;
    inset: 0;
    pointer-events: none;
    opacity: 0;
  }

  .countdown-item::before {
    background: repeating-linear-gradient(
      to bottom,
      rgba(244, 114, 182, 0.11) 0,
      rgba(244, 114, 182, 0.11) 2px,
      rgba(0, 0, 0, 0) 2px,
      rgba(0, 0, 0, 0) 6px
    );
    transform: translateX(0);
  }

  .countdown-item::after {
    border: 1px solid rgba(34, 211, 238, 0.65);
    box-shadow: 0 0 18px rgba(34, 211, 238, 0.55), inset 0 0 14px rgba(34, 211, 238, 0.24);
    transform: translateX(0);
  }

  .countdown-item.is-glitching-card {
    animation: card-glitch 340ms steps(2, end);
    border-color: rgba(34, 211, 238, 0.65);
    box-shadow:
      0 14px 32px rgba(2, 132, 199, 0.26),
      inset 0 0 0 1px rgba(34, 211, 238, 0.4),
      0 0 20px rgba(34, 211, 238, 0.3);
  }

  .countdown-item.is-glitching-card::before {
    opacity: 1;
    animation: card-lines 340ms steps(2, end);
  }

  .countdown-item.is-glitching-card::after {
    opacity: 1;
    animation: card-chromatic 340ms steps(2, end);
  }

  @media (hover: hover) {
    .countdown-item:hover {
      animation: card-glitch 620ms steps(2, end) infinite;
      border-color: rgba(34, 211, 238, 0.72);
      box-shadow:
        0 16px 34px rgba(2, 132, 199, 0.28),
        inset 0 0 0 1px rgba(34, 211, 238, 0.45),
        0 0 22px rgba(34, 211, 238, 0.34);
    }

    .countdown-item:hover::before {
      opacity: 1;
      animation: card-lines 620ms steps(2, end) infinite;
    }

    .countdown-item:hover::after {
      opacity: 1;
      animation: card-chromatic 620ms steps(2, end) infinite;
    }

    .countdown-item:hover .countdown-value::before {
      opacity: 0.9;
      animation: glitch-left 210ms steps(2, end) infinite;
    }

    .countdown-item:hover .countdown-value::after {
      opacity: 0.85;
      animation: glitch-right 210ms steps(2, end) infinite;
    }
  }

  @media (min-width: 640px) {
    .countdown-item {
      min-width: 7rem;
      padding: 1rem 1rem;
    }
  }

  @media (min-width: 1024px) {
    .countdown-item {
      min-width: 8.2rem;
      padding: 1.15rem 1.2rem;
    }
  }

  .countdown-value {
    position: relative;
    font-size: 2.35rem;
    font-weight: bold;
    line-height: 1;
    color: var(--countdown-color, var(--aw-color-primary));
    font-family: 'Bebas Neue', 'Arial Black', sans-serif;
    min-width: 2.75rem;
    text-align: center;
    letter-spacing: 0.02em;
    background: var(--countdown-color, linear-gradient(135deg, #a5f3fc, #22d3ee));
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
    text-shadow: 0 0 22px rgba(34, 211, 238, 0.35);
  }

  .countdown-value::before,
  .countdown-value::after {
    content: attr(data-text);
    position: absolute;
    inset: 0;
    pointer-events: none;
    opacity: 0;
  }

  .countdown-value::before {
    color: rgba(34, 211, 238, 0.75);
    transform: translateX(-1px);
  }

  .countdown-value::after {
    color: rgba(244, 114, 182, 0.68);
    transform: translateX(1px);
  }

  .countdown-value.is-glitching::before {
    opacity: 0.95;
    animation: glitch-left 130ms steps(2, end);
  }

  .countdown-value.is-glitching::after {
    opacity: 0.9;
    animation: glitch-right 130ms steps(2, end);
  }

  @media (min-width: 640px) {
    .countdown-value {
      font-size: 3.35rem;
      min-width: 4.5rem;
    }
  }

  @media (min-width: 1024px) {
    .countdown-value {
      font-size: 4.4rem;
      min-width: 5.3rem;
    }
  }

  .countdown-label {
    font-size: 0.66rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.2em;
    color: rgb(148 163 184 / 0.95);
  }

  @media (max-width: 639px) {
    .countdown-value {
      font-size: 1.95rem;
      min-width: 2.35rem;
    }

    .countdown-label {
      font-size: 0.56rem;
      letter-spacing: 0.14em;
    }
  }

  @media (min-width: 640px) {
    .countdown-label {
      font-size: 0.72rem;
    }
  }

  .countdown-separator {
    display: none;
  }

  .countdown-message {
    text-align: center;
    font-size: 1.5rem;
    font-weight: bold;
    color: var(--countdown-color, var(--aw-color-primary));
    padding: 2rem;
    animation: pulse 2s ease-in-out infinite;
  }

  @media (min-width: 640px) {
    .countdown-message {
      font-size: 2.2rem;
    }
  }

  @keyframes pulse {
    0%, 100% {
      opacity: 1;
      transform: scale(1);
    }
    50% {
      opacity: 0.8;
      transform: scale(1.05);
    }
  }

  @keyframes glitch-left {
    0% {
      transform: translateX(-1px);
      clip-path: inset(5% 0 70% 0);
    }
    50% {
      transform: translateX(-2px);
      clip-path: inset(40% 0 28% 0);
    }
    100% {
      transform: translateX(0);
      clip-path: inset(0 0 0 0);
    }
  }

  @keyframes glitch-right {
    0% {
      transform: translateX(1px);
      clip-path: inset(62% 0 8% 0);
    }
    50% {
      transform: translateX(2px);
      clip-path: inset(22% 0 44% 0);
    }
    100% {
      transform: translateX(0);
      clip-path: inset(0 0 0 0);
    }
  }

  @keyframes card-glitch {
    0% {
      transform: translate(0, 0);
    }
    25% {
      transform: translate(-2px, 1px);
    }
    50% {
      transform: translate(2px, -1px);
    }
    75% {
      transform: translate(-1px, -1px);
    }
    100% {
      transform: translate(0, 0);
    }
  }

  @keyframes card-lines {
    0% {
      transform: translateX(0);
    }
    50% {
      transform: translateX(-3px);
    }
    100% {
      transform: translateX(0);
    }
  }

  @keyframes card-chromatic {
    0% {
      transform: translateX(0);
    }
    50% {
      transform: translateX(3px);
    }
    100% {
      transform: translateX(0);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .countdown-item,
    .countdown-item:hover,
    .countdown-item.is-glitching-card {
      animation: none;
    }

    .countdown-item:hover::before,
    .countdown-item:hover::after,
    .countdown-item.is-glitching-card::before,
    .countdown-item.is-glitching-card::after,
    .countdown-item:hover .countdown-value::before,
    .countdown-item:hover .countdown-value::after,
    .countdown-value.is-glitching::before,
    .countdown-value.is-glitching::after {
      animation: none;
      opacity: 0;
    }
  }

  .hidden {
    display: none;
  }
</style>
