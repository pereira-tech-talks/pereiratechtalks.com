---
import { UI } from 'astrowind:config';
import { PEREIRA_TECH_DAY_PATH } from '~/utils/colorMode';

const defaultTheme = UI.theme || 'system';
---

<script is:inline define:vars={{ defaultTheme, ptdPath: PEREIRA_TECH_DAY_PATH }}>
  function isPereiraTechDayView() {
    const path = location.pathname.replace(/\/$/, '') || '/';
    return path === ptdPath;
  }

  function applyTheme(theme) {
    if (theme === 'dark') {
      document.documentElement.classList.add('dark');
      document.documentElement.removeAttribute('data-ptd-theme');
    } else {
      document.documentElement.classList.remove('dark');
      if (isPereiraTechDayView()) {
        document.documentElement.setAttribute('data-ptd-theme', 'light');
      } else {
        document.documentElement.removeAttribute('data-ptd-theme');
      }
    }

    const matches = document.querySelectorAll('[data-aw-toggle-color-scheme] > input');
    if (matches && matches.length) {
      matches.forEach((elem) => {
        elem.checked = theme !== 'dark';
      });
    }
  }

  function initTheme() {
    if (isPereiraTechDayView()) {
      applyTheme('light');
      return;
    }

    if ((defaultTheme && defaultTheme.endsWith(':only')) || (!localStorage.theme && defaultTheme !== 'system')) {
      applyTheme(defaultTheme.replace(':only', ''));
    } else if (
      localStorage.theme === 'dark' ||
      (!('theme' in localStorage) && window.matchMedia('(prefers-color-scheme: dark)').matches)
    ) {
      applyTheme('dark');
    } else {
      applyTheme('light');
    }
  }

  initTheme();
</script>
