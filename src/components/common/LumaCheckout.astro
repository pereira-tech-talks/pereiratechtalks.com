---
// https://docs.astro.build/en/guides/client-side-scripts/#load-external-scripts
---

<div transition:persist="luma-checkout-root" id="luma-checkout-root" hidden aria-hidden="true">
  <script is:inline id="luma-checkout" src="https://embed.lu.ma/checkout-button.js"></script>
</div>

<script is:inline data-astro-rerun>
  (function () {
    const LUMA_SITE = 'https://luma.com';
    const LUMA_EMBED = 'https://embed.lu.ma';

    const ensureLumaStyles = () => {
      if (document.querySelector('link[data-luma-checkout-css]')) return;
      const link = document.createElement('link');
      link.rel = 'stylesheet';
      link.href = `${LUMA_EMBED}/checkout-button.css`;
      link.dataset.lumaCheckoutCss = '';
      document.head.appendChild(link);
    };

    const buildIframeSrc = (eventId, button) => {
      const params = new URLSearchParams(window.location.search);
      const coupon = button?.dataset?.lumaCoupon;
      const utm = button?.dataset?.lumaUtmSource;
      if (coupon) params.set('coupon', coupon);
      if (utm) params.set('utm_source', utm);
      const query = params.toString();
      return `${LUMA_SITE}/embed/event/${eventId}/simple${query ? `?${query}` : ''}`;
    };

    const openLumaCheckoutModal = (eventId, button) => {
      ensureLumaStyles();

      document.querySelector('.luma-checkout--overlay')?.remove();

      const overlay = document.createElement('div');
      overlay.className = 'luma-checkout--overlay';

      const iframe = document.createElement('iframe');
      iframe.src = buildIframeSrc(eventId, button);
      iframe.allow = 'fullscreen; payment';
      iframe.style.cssText = 'border: 0; width: 100%; height: 100%;';
      iframe.onload = () => overlay.classList.add('luma-iframe-loaded');

      const modal = document.createElement('div');
      modal.className = 'luma-checkout--modal';
      modal.appendChild(iframe);

      const closeBtn = document.createElement('button');
      closeBtn.type = 'button';
      closeBtn.className = 'luma-checkout--close-btn';
      closeBtn.setAttribute('aria-label', 'Cerrar');
      const closeIcon = document.createElement('img');
      closeIcon.src = `${LUMA_EMBED}/static/x.svg`;
      closeIcon.alt = '';
      closeBtn.appendChild(closeIcon);

      const byline = document.createElement('div');
      byline.className = 'luma-checkout--by';
      byline.append('Processed securely by ');
      const lumaLink = document.createElement('a');
      lumaLink.href = LUMA_SITE;
      lumaLink.target = '_blank';
      lumaLink.rel = 'noopener noreferrer';
      lumaLink.textContent = 'Luma';
      byline.appendChild(lumaLink);

      const close = () => overlay.remove();
      overlay.addEventListener('click', close);
      closeBtn.addEventListener('click', (e) => {
        e.stopPropagation();
        close();
      });
      modal.addEventListener('click', (e) => e.stopPropagation());

      overlay.appendChild(closeBtn);
      overlay.appendChild(modal);
      overlay.appendChild(byline);
      document.body.appendChild(overlay);

      requestAnimationFrame(() => overlay.classList.add('luma-show'));
    };

    const bindLumaButtons = () => {
      document.querySelectorAll('[data-luma-action="checkout"]').forEach((el) => {
        if (el instanceof HTMLElement) el.onclick = null;
      });
      window.luma?.initCheckout?.();
    };

    const scheduleBind = () => {
      setTimeout(() => {
        requestAnimationFrame(() => {
          requestAnimationFrame(bindLumaButtons);
        });
      }, 50);
    };

    if (!window.__lumaCheckoutListeners) {
      window.__lumaCheckoutListeners = true;

      document.addEventListener(
        'click',
        (event) => {
          const target = event.target;
          if (!(target instanceof Element)) return;

          const button = target.closest('[data-luma-action="checkout"]');
          if (!(button instanceof HTMLElement)) return;

          const eventId = button.dataset.lumaEventId;
          if (!eventId) return;

          event.preventDefault();
          event.stopPropagation();
          openLumaCheckoutModal(eventId, button);
        },
        true,
      );

      document.addEventListener('astro:page-load', scheduleBind);
      document.addEventListener('astro:after-swap', scheduleBind);
    }

    window.__scheduleLumaCheckout = scheduleBind;
    window.__openLumaCheckoutModal = openLumaCheckoutModal;
    scheduleBind();
  })();
</script>
