<div
  id="link-preview"
  data-link-preview-root
  class="link-preview"
  role="tooltip"
  aria-hidden="true"
  hidden
  transition:persist="link-preview"
>
  <div class="link-preview__card">
    <div class="link-preview__media" hidden>
      <img class="link-preview__image" alt="" width="320" height="180" loading="lazy" decoding="async" />
    </div>
    <div class="link-preview__body">
      <p class="link-preview__loading">Cargando vista previa…</p>
      <p class="link-preview__site" hidden></p>
      <p class="link-preview__title" hidden></p>
      <p class="link-preview__description" hidden></p>
    </div>
  </div>
</div>

<script>
  import { initLinkPreview } from '~/scripts/link-preview';

  initLinkPreview();
  document.addEventListener('astro:page-load', initLinkPreview);
</script>
