---
import MascotPeek from '@/components/home/MascotPeek.svelte';
import type { Language } from '@/lib/i18n';
import { getUrlPrefix } from '@/lib/i18n';

interface Props {
  lang: Language;
  title: string;
  subtitle: string;
  ctaLabel: string;
  dateLabel: string;
  venueLabel: string;
}

const { lang, title, subtitle, ctaLabel, dateLabel, venueLabel } = Astro.props;
const prefix = getUrlPrefix(lang);
const href = `${prefix}/pereira-tech-days/2026/`;
---

<section
  id="main-after-hero"
  class="relative overflow-hidden border-y border-ptt-border bg-ptt-primary-soft dark:bg-ptt-bg-elevated"
>
  <div
    class="relative main-container flex flex-col gap-6 py-12 sm:py-14 lg:flex-row lg:items-center lg:justify-between"
  >
    <div class="max-w-2xl">
      <p
        class="text-xs font-semibold uppercase tracking-[0.18em] text-ptt-primary dark:text-ptt-primary-dark"
      >
        Pereira Tech Day 2026
      </p>
      <h2 class="mt-2 text-2xl font-bold tracking-tight text-ptt sm:text-3xl">
        {title}
      </h2>
      <p class="mt-3 text-base leading-relaxed text-ptt-secondary">
        {subtitle}
      </p>
      <dl
        class="mt-4 flex flex-wrap gap-x-6 gap-y-2 text-sm text-ptt-secondary"
      >
        <div>
          <dt class="sr-only">{lang === 'es' ? 'Fecha' : 'Date'}</dt>
          <dd>{dateLabel}</dd>
        </div>
        <div>
          <dt class="sr-only">{lang === 'es' ? 'Lugar' : 'Venue'}</dt>
          <dd>{venueLabel}</dd>
        </div>
      </dl>
      <a
        href={href}
        class="mt-6 inline-flex min-h-[44px] items-center rounded-full bg-ptt-primary px-5 py-2.5 text-sm font-semibold text-white transition-colors hover:bg-ptt-primary-strong dark:bg-ptt-primary-dark dark:text-ptt-bg dark:hover:bg-ptt-primary"
      >
        {ctaLabel}
      </a>
    </div>
    <div class="relative min-h-[10rem] flex-1 lg:min-h-[12rem]">
      <img
        src="/images/pereira-tech-days/2026/mascot/hero.webp"
        alt=""
        width="320"
        height="360"
        loading="lazy"
        decoding="async"
        class="relative z-0 ml-auto hidden h-44 w-auto object-contain sm:block lg:h-52"
      />
      <MascotPeek client:visible href={href} label={ctaLabel} />
    </div>
  </div>
</section>
