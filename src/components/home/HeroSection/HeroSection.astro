---
import TypewriterWords from './TypewriterWords.astro';

export interface Props {
  name: string;
  tagline?: string;
  description: string;
  typewriterWords: string[];
  meetupsLabel: string;
  meetupsHref: string;
  ptdLabel: string;
  ptdHref: string;
  contactLabel: string;
  contactHref: string;
}

const {
  name,
  tagline,
  description,
  typewriterWords,
  meetupsLabel,
  meetupsHref,
  ptdLabel,
  ptdHref,
  contactLabel,
  contactHref,
} = Astro.props;
---

<section
  class="relative min-h-[calc(100dvh-4.25rem)] flex flex-col justify-end sm:justify-center overflow-hidden"
>
  <!-- Full-bleed photo — light / dark variants -->
  <div aria-hidden="true" class="absolute inset-0 z-0">
    <img
      src="/images/home/hero-light.webp"
      alt=""
      width={1920}
      height={805}
      class="absolute inset-0 h-full w-full object-cover dark:hidden"
      loading="eager"
      fetchpriority="high"
    />
    <img
      src="/images/home/hero-dark.webp"
      alt=""
      width={1920}
      height={768}
      class="absolute inset-0 hidden h-full w-full object-cover dark:block"
      loading="eager"
      fetchpriority="high"
    />
    <div
      class="absolute inset-0 bg-gradient-to-r from-black/80 via-black/55 to-black/35 dark:from-black/85 dark:via-black/65 dark:to-black/45"
    >
    </div>
  </div>

  <div
    class="relative z-10 w-full max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-16 sm:py-20 lg:py-24"
  >
    <div class="max-w-2xl text-left">
      <img
        src="/images/pereira-tech-talks/logo-white.png"
        alt=""
        width={178}
        height={178}
        loading="eager"
        fetchpriority="high"
        class="h-16 w-auto sm:h-20 drop-shadow-xl"
        draggable="false"
      />
      {
        tagline && (
          <p class="mt-4 text-sm sm:text-base text-white/85 font-medium tracking-wide">
            {tagline}
          </p>
        )
      }
      <h1
        class="mt-3 text-4xl sm:text-5xl lg:text-6xl font-extrabold text-white tracking-tight drop-shadow-lg"
      >
        {name}
      </h1>
      <div class="mt-3 w-full max-w-xl">
        <TypewriterWords words={typewriterWords} align="left" />
      </div>
      <p
        class="mt-4 text-base sm:text-lg text-white/90 max-w-xl leading-relaxed"
        set:html={description}
      />
      <div class="mt-8 flex flex-wrap gap-3">
        <a
          href={meetupsHref}
          class="inline-flex min-h-[44px] items-center rounded-full bg-white px-5 py-2.5 text-sm font-semibold text-ptt-text hover:bg-white/90 transition-colors"
        >
          {meetupsLabel}
        </a>
        <a
          href={ptdHref}
          class="inline-flex min-h-[44px] items-center rounded-full bg-ptt-primary px-5 py-2.5 text-sm font-semibold text-white hover:bg-ptt-primary/90 dark:bg-ptt-primary-dark dark:text-ptt-bg transition-colors"
        >
          {ptdLabel}
        </a>
        <a
          href={contactHref}
          class="inline-flex min-h-[44px] items-center rounded-full border border-white/70 px-5 py-2.5 text-sm font-semibold text-white hover:bg-white/10 transition-colors"
        >
          {contactLabel}
        </a>
      </div>
      <div class="mt-8 flex gap-3">
        <a
          href="https://github.com/pereiratechtalks"
          target="_blank"
          rel="noopener noreferrer"
          aria-label="GitHub"
          class="inline-flex items-center justify-center min-h-[44px] min-w-[44px] p-1.5 hover:opacity-80 transition-opacity"
        >
          <img
            src="/icons/github_white.svg"
            alt=""
            width={28}
            height={28}
            loading="eager"
            class="w-6 h-6"
          />
        </a>
        <a
          href="https://www.linkedin.com/company/pereira-tech-talks/"
          target="_blank"
          rel="noopener noreferrer"
          aria-label="LinkedIn"
          class="inline-flex items-center justify-center min-h-[44px] min-w-[44px] p-1.5 hover:opacity-80 transition-opacity"
        >
          <img
            src="/icons/linkedin_white.svg"
            alt=""
            width={28}
            height={28}
            loading="eager"
            class="w-6 h-6"
          />
        </a>
        <a
          href="https://x.com/pereiratechtalks"
          target="_blank"
          rel="noopener noreferrer"
          aria-label="X (Twitter)"
          class="inline-flex items-center justify-center min-h-[44px] min-w-[44px] p-1.5 hover:opacity-80 transition-opacity"
        >
          <img
            src="/icons/x_white.svg"
            alt=""
            width={28}
            height={28}
            loading="eager"
            class="w-6 h-6"
          />
        </a>
        <a
          href="https://www.instagram.com/pereiratechtalks"
          target="_blank"
          rel="noopener noreferrer"
          aria-label="Instagram"
          class="inline-flex items-center justify-center min-h-[44px] min-w-[44px] p-1.5 hover:opacity-80 transition-opacity"
        >
          <img
            src="/icons/instagram_white.svg"
            alt=""
            width={28}
            height={28}
            loading="eager"
            class="w-6 h-6"
          />
        </a>
      </div>
    </div>
  </div>
</section>
