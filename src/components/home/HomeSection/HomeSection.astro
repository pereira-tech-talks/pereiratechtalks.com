---
import { HomeSectionContentAlignmentEType } from './enum';
import HomeSectionContent from './HomeSectionContent.astro';
import HomeSectionImage from './HomeSectionImage.astro';

interface Props {
  title: string;
  subtitle?: string;
  description: string;
  ctaText?: string;
  ctaLink?: string;
  cta2Text?: string;
  cta2Link?: string;
  image?: string;
  imageAlt?: string;
  imageWidth?: number;
  imageHeight?: number;
  imageCrop?: 'auto' | 'portrait';
  contentAlignment?: HomeSectionContentAlignmentEType;
  variant?: 'default' | 'alt';
  grouped?: boolean;
}

const {
  title,
  subtitle,
  description,
  ctaText,
  ctaLink,
  cta2Text,
  cta2Link,
  image,
  imageAlt = '',
  imageWidth = 480,
  imageHeight = 480,
  imageCrop = 'auto',
  contentAlignment = 'left',
  variant = 'default',
  grouped = false,
} = Astro.props;

// Validate required props
if (!title || !description) {
  throw new Error('HomeSection: title and description are required props');
}
---

<style>
  .main-container {
    display: flex;
    flex-direction: column;
    gap: 4rem;
  }
  .section-image {
    order: 1;
  }
  .section-content {
    order: 2;
    width: 100%;
    text-align: center;
  }
  @media (min-width: 1024px) {
    .main-container {
      flex-direction: row;
      gap: 4rem;
    }

    .section-content {
      text-align: left;
    }
    .align-left .section-image {
      order: 2;
    }
    .align-left .section-content {
      order: 1;
    }
    .align-right .section-image {
      order: 1;
    }
    .align-right .section-content {
      order: 2;
    }
    .section-content {
      width: auto;
    }
  }
</style>

<section
  class={`${grouped ? 'pt-12 sm:pt-16 lg:pt-20 pb-6 sm:pb-8 lg:pb-10' : 'py-12 sm:py-16 lg:py-24'} transition-colors duration-300 ${variant === 'alt' ? 'bg-ptt-primary-soft/40 dark:bg-ptt-bg-elevated' : 'bg-ptt-bg-elevated'}`}
>
  <div
    class={`main-container items-center lg:items-start ${contentAlignment === HomeSectionContentAlignmentEType.LEFT ? "align-left" : "align-right"}`}
  >
    {
      image && (
        <div class="section-image flex w-full justify-center lg:w-auto lg:shrink-0">
          <HomeSectionImage
            image={image}
            alt={imageAlt}
            width={imageWidth}
            height={imageHeight}
            crop={imageCrop}
          />
        </div>
      )
    }
    <div class="section-content">
      <HomeSectionContent
        title={title}
        subtitle={subtitle}
        description={description}
        ctaText={ctaText}
        ctaLink={ctaLink}
        cta2Text={cta2Text}
        cta2Link={cta2Link}
      />
    </div>
  </div>
</section>
