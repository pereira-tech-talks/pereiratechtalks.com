---
/**
 * PTT v3.0.0 talk card — preview card for a `talks` collection entry.
 */

import type { CollectionEntry } from 'astro:content';
import Badge from '@/components/ui/Badge.astro';
import { formatCalendarDate } from '@/lib/dates';
import { getUrlPrefix, type Language, tr } from '@/lib/i18n';

interface Props {
  talk: CollectionEntry<'talks'>;
  lang: Language;
  speakerNames?: string[];
}

const { talk, lang, speakerNames = [] } = Astro.props;

const prefix = getUrlPrefix(lang);
const title = tr(talk.data.title, lang);
const abstract = tr(talk.data.abstract, lang);
const event = talk.data.event;
const url =
  event?.collection === 'meetups'
    ? `${prefix}/meetups/${event.slug}/`
    : event?.collection === 'pereiraTechDays'
      ? `${prefix}/pereira-tech-days/${event.slug}/`
      : event?.collection === 'events'
        ? `${prefix}/events/${event.slug}/`
        : `${prefix}/meetups/`;
const langLabel = (talk.data.language || 'es').toUpperCase();
const date = talk.data.date ? new Date(talk.data.date) : null;
const dateLabel = date
  ? formatCalendarDate(date, lang, {
      year: 'numeric',
      month: 'short',
      day: 'numeric',
    })
  : '';
const typeLabels: Record<string, { en: string; es: string }> = {
  keynote: { en: 'Keynote', es: 'Keynote' },
  lightning: { en: 'Lightning', es: 'Relámpago' },
  panel: { en: 'Panel', es: 'Panel' },
  workshop: { en: 'Workshop', es: 'Taller' },
  talk: { en: 'Talk', es: 'Charla' },
};
const typeLabel = typeLabels[talk.data.type ?? 'talk'][lang];
const hasRecording = Boolean(talk.data.recording?.url);
---

<a
  href={url}
  data-umami-event="talk_card_click"
  data-umami-event-slug={talk.id}
  class="group flex h-full flex-col gap-3 rounded-2xl bg-ptt-bg-elevated shadow-sm ring-1 ring-ptt-border p-5 transition hover:shadow-lg hover:ring-ptt-primary/30 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-ptt-primary"
>
  <div class="flex items-center gap-2 text-xs font-semibold uppercase tracking-wider text-ptt-secondary">
    <Badge variant="neutral">{typeLabel}</Badge>
    <Badge variant="neutral">{langLabel}</Badge>
    {hasRecording && (
      <Badge variant="neutral">
        {lang === 'es' ? 'Grabación' : 'Recording'}
      </Badge>
    )}
    {dateLabel && <time datetime={date?.toISOString()}>{dateLabel}</time>}
  </div>
  <h3 class="text-lg font-semibold text-ptt group-hover:text-ptt-primary line-clamp-2">
    {title}
  </h3>
  <p class="text-sm text-ptt-secondary line-clamp-3">
    {abstract}
  </p>
  {speakerNames.length > 0 && (
    <p class="mt-auto text-xs text-ptt-secondary">
      <span class="font-semibold text-ptt-secondary">
        {lang === 'es' ? 'Por' : 'By'}:
      </span>{' '}
      {speakerNames.join(', ')}
    </p>
  )}
</a>
