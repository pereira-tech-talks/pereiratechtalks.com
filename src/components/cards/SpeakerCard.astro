---
/**
 * PTT v3.0.0 speaker card — preview card for a `speakers` collection entry.
 */

import type { CollectionEntry } from 'astro:content';
import { getUrlPrefix, type Language, tr } from '@/lib/i18n';

interface Props {
  speaker: CollectionEntry<'speakers'>;
  lang: Language;
  loading?: 'lazy' | 'eager';
}

const { speaker, lang, loading = 'lazy' } = Astro.props;

const prefix = getUrlPrefix(lang);
const role = tr(speaker.data.role, lang);
const photoSrc = speaker.data.photo.src;
const photoAlt =
  tr(speaker.data.photo.alt, lang) || `Portrait of ${speaker.data.name}`;
const url = `${prefix}/speakers/${speaker.id}/`;
const talkCount = speaker.data.talks?.length ?? 0;
---

<a
  href={url}
  class="group flex h-full flex-col items-center overflow-hidden rounded-2xl bg-white dark:bg-gray-900 shadow-sm ring-1 ring-gray-200 dark:ring-gray-800 p-6 transition hover:shadow-lg hover:ring-ptt-primary/30 dark:hover:ring-ptt-primary-dark/40 text-center focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-ptt-primary"
>
  <div class="relative h-28 w-28 overflow-hidden rounded-full bg-gradient-to-br from-ptt-primary/20 to-ptt-bg-dark/20 ring-2 ring-white dark:ring-gray-800 shadow-sm">
    <img
      src={photoSrc}
      alt={photoAlt}
      width="112"
      height="112"
      loading={loading}
      class="h-full w-full object-cover"
    />
  </div>
  <h3 class="mt-4 text-lg font-semibold text-gray-900 dark:text-gray-50 group-hover:text-ptt-primary dark:group-hover:text-ptt-primary-dark">
    {speaker.data.name}
  </h3>
  <p class="mt-1 text-sm text-gray-600 dark:text-gray-300">
    {role}
  </p>
  {talkCount > 0 && (
    <p class="mt-3 text-xs font-semibold uppercase tracking-wider text-ptt-primary dark:text-ptt-primary-dark">
      {talkCount}{' '}
      {lang === 'es'
        ? talkCount === 1
          ? 'charla'
          : 'charlas'
        : talkCount === 1
          ? 'talk'
          : 'talks'}
    </p>
  )}
</a>
