---
/**
 * PTT v3.0.0 vertical card — preview for a `verticals` collection entry.
 */

import type { CollectionEntry } from 'astro:content';
import Badge from '@/components/ui/Badge.astro';
import { getUrlPrefix, type Language, tr } from '@/lib/i18n';

interface Props {
  vertical: CollectionEntry<'verticals'>;
  lang: Language;
}

const { vertical, lang } = Astro.props;

const prefix = getUrlPrefix(lang);
const title = tr(vertical.data.title, lang);
const mission = tr(vertical.data.mission, lang);
const url = `${prefix}/verticals/${vertical.id}/`;
const status = vertical.data.status;
const statusVariant = status === 'archived' ? 'completed' : 'community';
const statusLabel =
  status === 'paused'
    ? lang === 'es'
      ? 'En pausa'
      : 'Paused'
    : status === 'archived'
      ? lang === 'es'
        ? 'Archivado'
        : 'Archived'
      : lang === 'es'
        ? 'Activo'
        : 'Active';
---

<a
  href={url}
  class="group relative flex h-full flex-col gap-4 overflow-hidden rounded-2xl p-6 ring-1 ring-gray-200 dark:ring-gray-800 transition hover:ring-ptt-primary/40 dark:hover:ring-ptt-primary-dark/40 hover:shadow-lg focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-ptt-primary"
>
  <div
    class="absolute inset-0 -z-10 bg-gradient-to-br from-ptt-primary/10 via-white to-ptt-accent/10 dark:from-ptt-primary-dark/15 dark:via-gray-900 dark:to-ptt-accent-dark/15"
  >
  </div>
  <div class="flex items-center justify-between">
    <span class="text-xs font-semibold uppercase tracking-widest text-ptt-primary dark:text-ptt-primary-dark">
      {lang === 'es' ? 'Programa' : 'Program'}
    </span>
    <Badge variant={statusVariant}>{statusLabel}</Badge>
  </div>
  <h3 class="text-2xl font-bold text-gray-900 dark:text-gray-50 group-hover:text-ptt-primary dark:group-hover:text-ptt-primary-dark">
    {title}
  </h3>
  <p class="text-gray-600 dark:text-gray-300">
    {mission}
  </p>
  <span class="mt-auto inline-flex items-center gap-1.5 text-sm font-semibold text-ptt-primary dark:text-ptt-primary-dark">
    {lang === 'es' ? 'Conoce más' : 'Learn more'}
    <svg
      aria-hidden="true"
      class="h-4 w-4 transition-transform group-hover:translate-x-0.5"
      viewBox="0 0 20 20"
      fill="currentColor"
    >
      <path
        fill-rule="evenodd"
        d="M10.293 5.293a1 1 0 011.414 0l4 4a1 1 0 010 1.414l-4 4a1 1 0 01-1.414-1.414L12.586 11H4a1 1 0 110-2h8.586l-2.293-2.293a1 1 0 010-1.414z"
        clip-rule="evenodd"
      ></path>
    </svg>
  </span>
</a>
