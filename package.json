{
  "name": "pereiratechtalks.org",
  "description": "Pereira Tech Talks v3.0.0 — bilingual community website for the Pereira tech community (Risaralda, Colombia). Meetups, Pereira Tech Days, La Biblioteca del Mañana, Speaker School, contributors, sponsors.",
  "author": "Pereira Tech Talks <hello@pereiratechtalks.org>",
  "license": "MIT",
  "homepage": "https://pereiratechtalks.org",
  "repository": {
    "type": "git",
    "url": "https://github.com/pereira-tech-talks/pereiratechtalks.org"
  },
  "type": "module",
  "version": "1.0.37",
  "packageManager": "pnpm@11.18.0",
  "engines": {
    "node": ">=24.15.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro check && astro build",
    "prebuild": "node scripts/generate-agent-skills-index.mjs",
    "generate:agent-skills-index": "node scripts/generate-agent-skills-index.mjs",
    "astro": "astro",
    "astro:check": "astro check",
    "astro:preview": "astro preview",
    "biome:check": "biome check",
    "biome:fix": "biome check --write",
    "biome:fix:unsafe": "biome check --write --unsafe",
    "ncu:check": "ncu",
    "ncu:upgrade": "ncu -u",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "images:optimize": "node scripts/optimize-images.mjs",
    "images:optimize:slides": "node scripts/optimize-images.mjs --target=slides",
    "images:webp": "echo 'All images are natively WebP — no generation needed'",
    "search:budgets": "node scripts/check-search-performance-budgets.mjs",
    "md:check": "node scripts/check-md-parity.mjs",
    "md:check:strict": "node scripts/check-md-parity.mjs --strict",
    "lighthouse": "lhci autorun",
    "lighthouse:full": "lhci autorun --config=lighthouserc.full.cjs",
    "responsive:inventory": "node scripts/responsive-audit/build-url-list.mjs",
    "responsive:capture": "node scripts/responsive-audit/capture.mjs",
    "responsive:capture:quick": "node scripts/responsive-audit/capture.mjs --quick",
    "test:responsive": "playwright test tests/e2e/responsive/",
    "test:responsive:update": "playwright test tests/e2e/responsive/ --update-snapshots",
    "release": "bash .github/scripts/prepare_release.sh"
  },
  "dependencies": {
    "@astrojs/check": "0.9.10",
    "@astrojs/compiler-rs": "0.3.2",
    "@astrojs/markdown-remark": "^7.2.2",
    "@astrojs/mdx": "7.0.5",
    "@astrojs/rss": "4.0.19",
    "@astrojs/sitemap": "3.7.3",
    "@astrojs/svelte": "9.0.1",
    "astro": "7.1.6",
    "fuse.js": "7.5.0",
    "rehype-external-links": "3.0.0",
    "reveal.js": "^6.0.1",
    "svelte": "5.56.8",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "unist-util-visit": "^5.1.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.6",
    "@lhci/cli": "0.15.1",
    "@playwright/test": "^1.62.0",
    "@sveltejs/vite-plugin-svelte": "7.2.0",
    "@tailwindcss/typography": "0.5.20",
    "@tailwindcss/vite": "4.3.3",
    "@testing-library/jest-dom": "7.0.0",
    "@testing-library/svelte": "5.4.2",
    "@vitest/coverage-v8": "4.1.10",
    "happy-dom": "20.11.1",
    "npm-check-updates": "23.0.0",
    "sharp": "0.35.3",
    "vitest": "4.1.10"
  }
}
