# Generated by devcontainer-kit (`dck init`) from .devcontainer/dck.toml.
# The blocks between the dck markers are reconciled by `dck init`; add your
# project's own layers BELOW them — they are never touched. The scripts the
# base block copies live next to this file in dck/ (vendored by `dck init`,
# devcontainer-kit v0.3.0); no shared base image is involved.
# >>> dck:base >>>
# dck:managed v0.3.0 base
# Both ARGs come before any FROM, so they are global (an ARG after a FROM is
# scoped to that stage).
ARG BASE_IMAGE=node:24.21.0-trixie-slim@sha256:173f125896c3b47ddf056734c7ea789d04595a6a08769a8f78e0df642781fb66
FROM ${BASE_IMAGE}
SHELL ["/bin/bash", "-o", "pipefail", "-c"]

# System packages, hardened sshd (no host keys in the image), gh, Herdr,
# Neovim and the uid-1000 user — every download pinned and verified
# (dck/versions.env, dck/install.sh).
COPY dck/versions.env dck/install.sh dck/sshd_config.conf dck/github_known_hosts dck/herdr-config.toml dck/profile.sh /tmp/dck-build/
RUN bash /tmp/dck-build/install.sh node-24 python3 python3-venv

# herdr-peers and Herdr's skill: agents inside ask Herdr agents on other
# machines (the host, other containers). Verified against the pinned release
# sums (dck/peers.sh).
COPY dck/versions.env dck/peers.sh /tmp/dck-peers/
RUN bash /tmp/dck-peers/peers.sh && rm -rf /tmp/dck-peers
ENV PNPM_HOME=/usr/local/share/pnpm
RUN corepack enable \
    && mkdir -p "${PNPM_HOME}/bin" \
    && chown -R dev:dev "${PNPM_HOME}" \
    && node --version

# The editor in its own layer: DeepWorkPlan Vim through its official
# installer, verified and run with --strict (dck/editor.sh).
COPY dck/versions.env dck/editor.sh /tmp/dck-editor/
RUN bash /tmp/dck-editor/editor.sh

# The entrypoint library and the opt-in layer installers (dck/).
COPY dck/entrypoint.sh /usr/local/lib/dck/entrypoint.sh
COPY dck/dck-entrypoint /usr/local/bin/dck-entrypoint
COPY dck/layers/ /usr/local/lib/dck/layers/
COPY dck/dck-layer /usr/local/bin/dck-layer
# The standard Herdr sidebar (App · Editor · Development · Agents), created by
# `dck herdr layout` / `dck up` inside the container.
COPY dck/herdr-layout.sh /usr/local/bin/dck-herdr-layout
RUN chmod 0644 /usr/local/lib/dck/entrypoint.sh /usr/local/lib/dck/layers/*.sh \
    && chmod 0755 /usr/local/bin/dck-entrypoint /usr/local/bin/dck-layer /usr/local/bin/dck-herdr-layout

ENV LANG=en_US.UTF-8 \
    EDITOR=nvim \
    VISUAL=nvim \
    GIT_EDITOR=nvim \
    DCK_IMAGE_FLAVOUR=node-24 \
    DCK_IMAGE_VERSION=0.3.0
WORKDIR /app
ENTRYPOINT ["/usr/local/bin/dck-entrypoint"]
CMD ["sleep", "infinity"]

# dck.toml asks for user "node": rename the uid-1000 user.
RUN usermod -l node -d /home/node -m dev \
    && groupmod -n node dev \
    && printf '%s ALL=(root) NOPASSWD:ALL\n' node > /etc/sudoers.d/node \
    && chmod 0440 /etc/sudoers.d/node \
    && rm -f /etc/sudoers.d/dev
# <<< dck:base <<<
# >>> dck:layers >>>
# Agents layer (layers.agents = true): coding-agents-kit (ak) from its verified
# release, the pinned Node when the flavour lacks a current one, `ak install`
# (pinned, verified) and the classic + providers presets. Autonomy is ak's default.
ARG DCK_AGENT_CLIS="claude codex cursor opencode pi cline grok"
RUN DCK_USER=node dck-layer agents ${DCK_AGENT_CLIS}
# Dailybot layer (layers.dailybot = true): requested by the dailybot addon.
RUN DCK_USER=node dck-layer dailybot
# <<< dck:layers <<<

# Project-specific layers go here (apt packages, language tooling, ...).

# --- pertechtalks ---------------------------------------------------------------
# Chromium for Lighthouse (pnpm run lighthouse); Debian's package, from the
# digest-pinned base image's own apt sources.
RUN apt-get update \
    && apt-get install -y --no-install-recommends chromium \
    && rm -rf /var/lib/apt/lists/*
ENV CHROME_PATH=/usr/bin/chromium \
    CHROMIUM_FLAGS=--no-sandbox

# This repository uses pnpm only: `npm` says so and runs pnpm instead. Global
# installs (`npm install -g`, which `ak install <cli>` uses) still reach the real
# npm, so agent CLIs land where the agents layer put them.
RUN rm -f /usr/local/bin/npm \
    && printf '%s\n' '#!/bin/bash' \
      'case " $* " in *" -g "*|*" --global "*|*" --location=global "*|*" --prefix "*|*" --prefix="*) exec /usr/local/lib/node_modules/npm/bin/npm-cli.js "$@" ;; esac' \
      'echo "[npm→pnpm] Redirecting \"npm $*\" to pnpm (this repo uses pnpm)." >&2' \
      'exec corepack pnpm "$@"' > /usr/local/bin/npm \
    && chmod 0755 /usr/local/bin/npm

# The site helpers (check, fix, run_tests, codecheck, lighthouse, …) in every bash
# the node user starts: interactive shells, login shells, ssh and Herdr sessions.
RUN printf '%s\n' \
      '# The site helpers. Dash cannot parse bash functions.' \
      'if [ -n "${BASH_VERSION:-}" ] && [ -f /app/docker/custom_commands.sh ]; then' \
      '  . /app/docker/custom_commands.sh' \
      'fi' > /etc/profile.d/99-ptt-custom-commands.sh \
    && chmod 0644 /etc/profile.d/99-ptt-custom-commands.sh \
    && echo '[ -f /app/docker/custom_commands.sh ] && . /app/docker/custom_commands.sh' >> /home/node/.bashrc \
    && chown node:node /home/node/.bashrc

RUN git config --system init.defaultBranch main \
    && git config --system pull.rebase false
